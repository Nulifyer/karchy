# Line endings: karchy is shell, Lua, QML and config for Linux. Store and
# check out everything as LF; git detects binaries on its own.
* text=auto eol=lf

# Scripts without an extension must stay LF even on other platforms.
bin/*                   text eol=lf
install/karchy-install  text eol=lf
tools/*                 text eol=lf
*.sh                    text eol=lf

# Binary assets: never diff or merge as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary

# Vendored Omarchy code (vendor/omarchy.paths): excluded from GitHub's
# language stats and collapsed in diffs. karchy's own files under these
# directories are listed after, which unsets the flag for them.
bin/omarchy*            linguist-vendored
shell/**                linguist-vendored
themes/**               linguist-vendored
default/**              linguist-vendored
install/provisioning/** linguist-vendored
install/helpers/**      linguist-vendored
themes/nulifyer/**      -linguist-vendored

# Generated by tools/vendor-sync.
vendor/omarchy.lock     linguist-generated
