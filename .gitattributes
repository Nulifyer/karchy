# Line endings: karchy is QML, shell, Lua and config for Linux. Store and
# check out everything as LF; git detects binaries on its own.
* text=auto eol=lf

# Scripts without an extension must stay LF even on other platforms.
bin/*                   text eol=lf
install/karchy-install  text eol=lf
tools/*                 text eol=lf
*.sh                    text eol=lf

# Binary assets: never diff or merge as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary

# GitHub's language bar. The code that began as Omarchy's is karchy's own
# now (D-46), so it counts: the shell's QML and JavaScript, the commands in
# bin/ and the Hyprland Lua. The research reports are documents, not code.
.agents/research/**     linguist-documentation

# Generated by tools/rebrand from Omarchy v4.5.0 (D-46).
vendor/upstream.tsv    linguist-generated
