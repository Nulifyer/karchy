[Trigger]
Operation = Upgrade
Type = Package
Target = karchy

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/share/karchy/hypr.d/*.lua

[Action]
Description = Pausing Hyprland config auto-reload for a karchy update...
When = PreTransaction
Depends = karchy
Exec = /usr/bin/karchy-hyprland-reload-guard pause
