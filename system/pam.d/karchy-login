# karchy (D-131): logging in at karchy's login screen on an install whose
# keyring opens with the login password (no disk encryption). greetd's own
# service plus oo7's module: it keeps the password typed at the login screen and hands it to the user's oo7 daemon once the session
# is open, which unlocks the login keyring with it. /etc/greetd/config.toml
# names this service only on such an install.
#%PAM-1.0

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
auth       optional     pam_oo7.so
account    include      system-local-login
session    include      system-local-login
session    optional     pam_oo7.so auto_start
