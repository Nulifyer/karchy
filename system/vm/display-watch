#!/bin/bash

# karchy as a VM guest (D-174): when the viewer's window changes size, the
# virtual GPU announces a new preferred mode with a DRM hotplug event. Hyprland
# doesn't take it up, so this waits for that event and has karchy's display
# rule (/usr/share/karchy/hypr.d/50-karchy-vm-display.lua) apply it.
#
# Started with the Hyprland session by that file. A viewer being dragged sends
# many sizes; only the last one is applied, once no event has come for half a
# second, so the desktop doesn't change size in between.

systemd-detect-virt --quiet --vm || exit 0

while read -r line; do
  [[ $line == HOTPLUG=1 ]] || continue
  while read -r -t 0.5 line; do :; done
  hyprctl eval 'if karchy_vm_display_follow then karchy_vm_display_follow() end' >/dev/null
done < <(udevadm monitor --udev --subsystem-match=drm --property)
