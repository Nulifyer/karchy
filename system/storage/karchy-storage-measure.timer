# Settings › Storage's nightly measurement. A machine that was off at the time
# gets it after the next start; a laptop on battery is left alone until the
# next night (storage-measure checks both). karchy-settings turns it on for
# every install (timers.target.wants in /usr/lib); to turn it off:
# systemctl mask karchy-storage-measure.timer
[Unit]
Description=Measure disk space and disk health every night (karchy)

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true
