# Notes which snapshot the boot menu started, for the login notice
# (karchy-snapshot-boot check). snapper's description of a snapshot is
# readable only by root and lies outside the snapshot, so root records it
# before the session starts. Does nothing on a normal boot.
[Unit]
Description=Note which snapshot the boot menu started

[Service]
Type=oneshot
RemainAfterExit=yes
PrivateMounts=yes
ExecStart=/usr/share/karchy/bin/karchy-snapshot-boot record
