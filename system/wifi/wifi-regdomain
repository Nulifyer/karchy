# Sets the Wi-Fi regulatory domain (the country whose channel and power rules
# apply) from the timezone. Without it the kernel stays in the world domain,
# where 6 GHz is off and many 5 GHz channels are passive-only. Runs when a
# Wi-Fi device appears and after karchy-menu-timezone. A country in
# /etc/karchy/wifi-country (COUNTRY=XX) overrides the timezone.

OVERRIDE=/etc/karchy/wifi-country
LOGGER="/usr/bin/logger -t karchy-wifi-regdomain"

getcountry() {
	while read -r c _ z _; do
		if [ "$z" = "$ZONE" ]; then
			echo "$c"
			break
		fi
	done </usr/share/zoneinfo/zone.tab
}

if [ -f "$OVERRIDE" ]; then
	COUNTRY=$(sed -n 's/^COUNTRY=//p' "$OVERRIDE" | head -1)
	if [ -n "$COUNTRY" ]; then
		exec /usr/bin/iw reg set "$COUNTRY"
	fi
fi

ZONE=$(timedatectl show -P Timezone 2>/dev/null)
if [ -z "$ZONE" ]; then
	$LOGGER -s "Could not determine the timezone; leaving the regulatory domain alone."
	exit 0
fi

# Zones with no single country.
case "$ZONE" in
	UTC | UCT | Universal | Zulu | GMT | GMT[+-]0 | GMT0 | Greenwich | Factory | posixrules | \
		CET | EET | WET | MET | EST | MST | HST | EST5EDT | CST6CDT | MST7MDT | PST8PDT | \
		Etc/*)
		$LOGGER "Timezone $ZONE has no country; leaving the regulatory domain alone."
		exit 0
		;;
esac

COUNTRY=$(getcountry)

# Not in zone.tab: resolve a backward-compatible alias (US/Pacific,
# Asia/Calcutta) to its canonical zone and retry. Only after the direct
# lookup, since many zone.tab entries are themselves links into another
# country's zone (Europe/Amsterdam -> Europe/Brussels).
TZDATA_ZI=/usr/share/zoneinfo/tzdata.zi
if [ -z "$COUNTRY" ] && [ -f "$TZDATA_ZI" ]; then
	CANON=$(awk -v z="$ZONE" '$1=="L" && $3==z {print $2; exit}' "$TZDATA_ZI")
	if [ -n "$CANON" ]; then
		ZONE=$CANON
		COUNTRY=$(getcountry)
	fi
fi

if [ -z "$COUNTRY" ]; then
	$LOGGER -s "No country for timezone $ZONE; leaving the regulatory domain alone."
	exit 0
fi

$LOGGER "Setting the regulatory domain to $COUNTRY (timezone $ZONE)."
exec /usr/bin/iw reg set "$COUNTRY"
