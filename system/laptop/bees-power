#!/bin/bash
# karchy-laptop (D-86): start or stop bees for the charger udev rule, when
# its service is enabled.

set -uo pipefail

action="${1:-}"
[[ $action == "start" || $action == "stop" ]] || exit 1

systemctl --quiet is-enabled karchy-bees.service || exit 0
systemctl --no-block "$action" karchy-bees.service
exit 0
