[Unit]
Description=Close the VPN kill switch before networking starts
Documentation=https://github.com/Nulifyer/karchy
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target NetworkManager.service
Wants=network-pre.target
ConditionPathExists=/etc/karchy-vpn/config

[Service]
Type=oneshot
ExecStart=/usr/lib/karchy-vpn/control boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
