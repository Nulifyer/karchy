[Unit]
Description=Apply the VPN policy after a network or mode change
Documentation=https://github.com/Nulifyer/karchy
After=NetworkManager.service karchy-vpn-guard.service
ConditionPathExists=/etc/karchy-vpn/config
# Bursts of network events are normal; each run coalesces what came before it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/karchy-vpn/policy event
TimeoutStartSec=60
