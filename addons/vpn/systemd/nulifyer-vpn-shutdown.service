# Started by the package's removal scriptlet: pacman runs scriptlets in a
# network namespace of their own, so the teardown (tunnel down, kill switch
# removed, DNS restored) has to run here, in the system's.
[Unit]
Description=Take the VPN and its kill switch down for package removal
Documentation=https://github.com/Nulifyer/omarchy-vpn-plugin
ConditionPathExists=/etc/nulifyer-vpn/config

[Service]
Type=oneshot
ExecStart=/usr/lib/nulifyer-vpn/control shutdown
TimeoutStartSec=60
