# karchy-vpn configuration. Install it with: karchy-vpn setup <this file>
# (root keeps its own copy in /etc/karchy-vpn/config).

# One existing NetworkManager WireGuard connection: one IPv4 full-tunnel peer
# (allowed-ips 0.0.0.0/0), a fixed listen port, peer routes, its DNS for all
# domains with a negative priority (ipv4.dns-search '~.', ipv4.dns-priority -100).
VPN_CONNECTION='wgclient'
VPN_INTERFACE='wgclient'
VPN_ENDPOINT_HOST='vpn.example.com'
VPN_ENDPOINT_PORT='51820'
VPN_CLIENT_PORT='51820'
# A DNS server inside the VPN. It must answer ping: that is the health probe.
VPN_DNS='10.66.0.1'

# Trusted networks and the DNS for the others come from karchy (Settings ›
# Network).

# On a trusted network in On mode, keep the local network and the router's
# own names (nas.lan) reachable beside the tunnel.
HOME_LAN='yes'
# If the VPN server sits behind your home router and the router's hairpin NAT
# answers from its own address: the router's address (and interface, optional).
TRUSTED_GATEWAY=''
TRUSTED_INTERFACE=''

# Seconds: a handshake older than this counts as stale; a tunnel that hasn't
# connected after this long counts as failed (the internet stays blocked).
HANDSHAKE_MAX_AGE='150'
CONNECT_TIMEOUT='30'
