#!/bin/bash

# Install karchy from the stock Arch Linux live ISO.
#
# Usage: karchy-install [--config FILE] [--reboot]
#
#   --config FILE   Read answers from FILE instead of showing the form
#                   (unattended installs and VM tests; FILE sets KARCHY_* vars)
#   --reboot        Reboot when the install finishes
#
# Erases the chosen disk, and any other disk chosen for encryption. Every
# step is logged to /var/log/karchy-install.log
# and copied into the installed system. On a terminal the installer draws its
# screens (install/ui.sh); with its output in a pipe or a file, or with
# KARCHY_UI=plain, it prints one timestamped line per step instead.

set -eEuo pipefail

KARCHY_SRC=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "$KARCHY_SRC/install/lib.sh"
source "$KARCHY_SRC/install/ui.sh"
source "$KARCHY_SRC/install/network.sh"
source "$KARCHY_SRC/install/form.sh"
source "$KARCHY_SRC/install/disk.sh"
source "$KARCHY_SRC/install/base.sh"
source "$KARCHY_SRC/install/setup.sh"
trap on_error ERR
# However the installer ends: no clock left running, the cursor back, the
# kernel's messages of the install in the log and on the console again.
trap 'ui_ticker_stop; [[ $KARCHY_UI != tui ]] || ui_out $'"'"'\033[?25h'"'"'; ui_kernel_log; ui_console_restore' EXIT

config_file=""
reboot_after=false
while (($#)); do
  case "$1" in
    --config)
      config_file="${2:-}"
      shift
      ;;
    --reboot) reboot_after=true ;;
    -h | --help)
      awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

preflight() {
  ((EUID == 0)) || die "run as root (the live ISO logs in as root)"
  [[ -d /sys/firmware/efi/efivars ]] || die "karchy needs UEFI boot; this system booted in BIOS mode"
  # With answers from a file nobody is there to pick a network; otherwise
  # the Wi-Fi list is offered (install/network.sh).
  if [[ -n $config_file || $KARCHY_UI != tui ]]; then
    curl -fsS --max-time 10 -o /dev/null https://archlinux.org || die "no network connection"
  else
    net_wait || die "no network connection; connect (iwctl joins Wi-Fi) and run karchy-install again"
  fi
  timedatectl set-ntp true
  # The live system's pacman keyring must be ready before keys are added.
  net_keyring_ready || die "the live system's pacman keyring could not be prepared (systemctl status pacman-init.service)"
}

# What is about to happen, before anything is written: the answers, and what
# is lost.
summary() {
  local size model disk
  size=$(lsblk -dno SIZE "$KARCHY_DISK" 2>/dev/null | tr -d ' ') || true
  model=$(lsblk -dno MODEL "$KARCHY_DISK" 2>/dev/null | sed 's/[[:space:]]*$//') || true
  ui_header "Ready to install" 16
  ui_field "Disk" "$KARCHY_DISK  ${size}${model:+  $model}"
  if install_encrypted; then
    ui_field "Protection" "$(form_protection_label)"
  else
    ui_field "Protection" "$(form_protection_label)" "$UI_RED"
  fi
  for disk in $KARCHY_ENCRYPT_DISKS; do
    ui_field "Also encrypted" "$disk  $(form_disk_name "$disk")"
  done
  # The other internal disks that stay as they are, so it is plain that
  # nothing happens to them.
  local -a kept=()
  while IFS= read -r disk; do
    [[ " $KARCHY_ENCRYPT_DISKS " == *" $disk "* ]] || kept+=("$disk")
  done < <(form_other_disks_list)
  ((${#kept[@]} == 0)) || ui_field "Other disks" "${kept[*]} kept as they are"
  ui_field "User" "$KARCHY_USER"
  ui_field "Computer" "$KARCHY_HOSTNAME"
  ui_field "Keyboard" "$KARCHY_KEYMAP"
  ui_field "Timezone" "$KARCHY_TIMEZONE"
  ui_field "Updates" "$KARCHY_CHANNEL channel"
  ui_field "Secure Boot" "$KARCHY_SECUREBOOT"
  ui_field "Deduplication" "$KARCHY_BEES"
  ui_line
  ui_line "This erases $KARCHY_DISK. Everything on it is lost." "$UI_RED$UI_BOLD"
  for disk in $KARCHY_ENCRYPT_DISKS; do
    ui_line "This also erases $disk ($(form_disk_name "$disk")). Everything on it is lost." "$UI_RED$UI_BOLD"
  done
  # Without encryption: who can read the disk, said where the erase is said.
  if ! install_encrypted; then
    ui_line "The disk is not encrypted: anyone who has this computer or its disk" "$UI_RED$UI_BOLD"
    ui_line "can read your files." "$UI_RED$UI_BOLD"
  fi
  ui_line
}

# Restart at once, without the live system's shutdown. The install is
# unmounted and closed by now, so nothing is lost; the live system itself may
# be reading its files from a USB stick that is already out, where a normal
# shutdown stops on read errors and never restarts. systemctl syncs and calls
# the kernel's reboot directly; when even systemctl can't be read from the
# missing stick, the kernel's own reboot key does it (a shell builtin, no
# file needed).
restart_now() {
  systemctl reboot --force --force 2>/dev/null || true
  echo b >/proc/sysrq-trigger
}

# The last screen: what was done and what the user does next.
finish() {
  local elapsed note
  elapsed=$(ui_duration $((SECONDS - UI_STARTED)))
  if [[ $KARCHY_UI != tui ]]; then
    log "karchy is installed."
    [[ $reboot_after == "true" ]] || log "Reboot, and take the install media out once the screen goes dark."
    return 0
  fi
  echo "$(date +%H:%M:%S) karchy is installed." >>"$KARCHY_INSTALL_LOG"
  ui_header "karchy is installed" $((10 + ${#KARCHY_NOTES[@]}))
  ui_line "✓ Installed on $KARCHY_DISK in $elapsed" "$UI_GREEN"
  ui_line
  # How the restart happens: by itself (--reboot), by the question that
  # follows the form's install, or by hand after an answer file's, which
  # asks nothing.
  if [[ $reboot_after == "true" ]]; then
    ui_line "1  The computer restarts now. Leave the USB stick in until the screen"
  elif [[ -n $config_file ]]; then
    ui_line "1  Type reboot to restart. Leave the USB stick in until the screen"
  else
    ui_line "1  Choose Restart now below. Leave the USB stick in until the screen"
  fi
  ui_line "   goes dark: the installer runs from it."
  ui_line "2  Then take the USB stick out."
  if install_encrypted; then
    ui_line "3  Type your password at the disk-password screen. It is the one"
    ui_line "   you chose here; it unlocks the disk and logs $KARCHY_USER in."
  else
    ui_line "3  Type your password at the login screen. It is the one you chose"
    ui_line "   here."
  fi
  if ((${#KARCHY_NOTES[@]})); then
    ui_line
    for note in "${KARCHY_NOTES[@]}"; do
      ui_line "$(ui_fit "$note")" "$UI_DIM"
    done
  fi
  ui_line
}

: >"$KARCHY_INSTALL_LOG"
chmod 600 "$KARCHY_INSTALL_LOG"
UI_KERNEL_LOG_FROM=$(date +%s)
ui_init
preflight

if [[ -n $config_file ]]; then
  form_load "$config_file"
else
  form_run
fi
summary
[[ -n $config_file ]] || form_confirm

step "Partition $KARCHY_DISK" disk_partition
! install_encrypted || step "Encrypt the root partition" disk_encrypt
step "Create filesystems and subvolumes" disk_filesystems
step "Mount subvolumes" disk_mount
step "Create the swap file" disk_swapfile

step "Add repositories and keys" base_repos_live
step "Install the base system" base_pacstrap
step "Write fstab" base_fstab
step "Configure repositories" base_repos_target
step "Locale, time and hostname" base_locale
step "Create user $KARCHY_USER" base_user
step "Record install answers" base_install_conf
[[ -z $KARCHY_ENCRYPT_DISKS ]] || step "Encrypt the other disks" disk_data_encrypt
step "Find data disks" base_data_disks
step "Configure snapshots" base_snapper
step "Install the bootloader" base_bootloader
step "Enable services" base_services
step "Carry over Wi-Fi networks" base_wifi
step "Install the desktop" setup_packages
step "Configure the desktop for this machine" setup_system_files
step "Enable desktop services" setup_services
step "Set up $KARCHY_USER's desktop" setup_user
step "Set up bees deduplication" setup_bees
step "Git identity" base_git_identity
# Secure Boot comes last (it enrolls keys as its final action), before only
# the resolv.conf link, since it still downloads sbctl.
step "Set up Secure Boot" base_secureboot
step "Link resolv.conf" base_resolved_link

steps_run

unset KARCHY_PASSWORD
ui_kernel_log
install -Dm 0600 "$KARCHY_INSTALL_LOG" "$KARCHY_MNT/var/log/karchy-install.log"
swapoff "$KARCHY_MNT/swap/swapfile" || true
umount -R "$KARCHY_MNT"
for mapper in "${KARCHY_MAPPERS[@]}"; do
  cryptsetup close "$mapper" || true
done
finish

if [[ $reboot_after == "true" ]]; then
  restart_now
elif [[ -z $config_file && $KARCHY_UI == tui ]]; then
  # Stay in the live system on No, Esc or Ctrl-C: the shell is the way back
  # to the log or to a second look at the disk.
  if gum confirm --default=true --affirmative "Restart now" --negative "Stay in the live system" \
    "Restart now?"; then
    restart_now
  fi
fi
