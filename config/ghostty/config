# Ghostty. Colors follow the theme through the include below; karchy reloads
# open windows on a theme switch.
config-file = ?"~/.local/state/karchy/current/theme/ghostty.conf"

# The font follows fontconfig's "monospace", which Settings › Appearance sets.
# The size follows Settings › Appearance › Text size, through the file below.
# Ghostty reads included files after this one, so to set your own font-size,
# remove that line.
font-family = "monospace"
config-file = ?"~/.local/state/karchy/terminal/ghostty.conf"

# Copy and paste are Ctrl+Shift+C and Ctrl+Shift+V, as in every terminal:
# Ctrl+C interrupts the running program. karchy's Super+C and Super+V and the
# clipboard history send these. Ctrl+Insert and Shift+Insert do the same, as
# on Windows; Shift+Insert would otherwise paste the mouse selection.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# No "Reloaded the configuration" toast on every theme switch.
app-notifications = no-config-reload
