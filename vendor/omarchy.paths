# Omarchy paths vendored into karchy (docs/architecture.md).
#
# One rule per line: "+ <glob>" includes, "- <glob>" excludes. Rules apply in
# order and the last match wins. "**" matches across directories, "*" within
# one path segment. tools/vendor-sync applies these rules to the upstream tag.

# Quickshell desktop shell, minus the plugins karchy drops.
+ shell/**
- shell/plugins/agents/**
- shell/plugins/dev-gallery/**
- shell/plugins/dock/**
- shell/plugins/emojis/**
- shell/plugins/panels/dropbox/**
- shell/plugins/panels/elsewhen/**
- shell/plugins/panels/tailscale/**
- shell/plugins/panels/weather/**
- shell/plugins/panels/wifiqr/**
- shell/plugins/services/nightlight/**
- shell/plugins/services/remote-session/**
- shell/plugins/bar/widgets/SystemUpdate*
- shell/plugins/bar/widgets/KeyboardLayout*
- shell/plugins/bar/indicators/NightLight.qml
- shell/plugins/bar/indicators/RemoteSession.qml
- shell/plugins/bar/indicators/PasswordlessSudo.qml
- shell/plugins/bar/indicators/Dnd.qml
- shell/plugins/bar/indicators/StayAwake.qml
- shell/services/BackgroundIntro.qml

# Hyprland modules karchy composes in karchy/hypr/init.lua.
+ default/hypr/bootstrap.lua
+ default/hypr/helpers.lua
+ default/hypr/require_optional.lua
+ default/hypr/require_all.lua
+ default/hypr/paths.lua
+ default/hypr/monitor-workspaces.lua
+ default/hypr/envs.lua
+ default/hypr/looknfeel.lua
+ default/hypr/input.lua
+ default/hypr/keyboard.lua
+ default/hypr/windows.lua
+ default/hypr/pop.lua
+ default/hypr/glass.lua
+ default/hypr/nvidia.lua
+ default/hypr/workspace-layouts.lua
+ default/hypr/workspace-modes.lua
+ default/hypr/toggles.lua
+ default/hypr/toggles/**
+ default/hypr/startup-cursor.lua
+ default/hypr/disabled-input-device.lua
+ default/hypr/apps.lua
+ default/hypr/cursors/**
# Window rules only for apps karchy ships or users commonly add.
+ default/hypr/apps/browser.lua
+ default/hypr/apps/captive-portal.lua
+ default/hypr/apps/jetbrains.lua
+ default/hypr/apps/localsend.lua
+ default/hypr/apps/omarchy-shell.lua
+ default/hypr/apps/pip.lua
+ default/hypr/apps/screenshot-selection.lua
+ default/hypr/apps/steam.lua
+ default/hypr/apps/system.lua
+ default/hypr/apps/terminals.lua
+ default/hypr/apps/webcam-overlay.lua

# Theme engine inputs and data the kept commands read.
+ default/themed/**
+ default/fonts/**
+ default/i18n/**
+ default/input-methods/**
+ default/gtk/**
+ default/audio/**
+ default/systemd/user/**
+ default/systemd/system-sleep/fprintd-resume
+ default/systemd/system/fprintd.service.d/**
+ default/foot/**
+ default/alacritty/**
+ default/ghostty/**
+ default/omarchy/shortcuts
+ default/omarchy/launcher.hides
+ install/provisioning/luks-rekey.sh
+ install/helpers/browser-policy.sh

# Themes, without the intro videos (intro animations are dropped).
+ themes/**
- themes/*/backgrounds/intros/**

