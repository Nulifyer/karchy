<?xml version="1.0" encoding="UTF-8"?>
<!-- karchy's Thunar right-click actions (D-36, D-40). karchy-thunar-actions
     merges them into ~/.config/Thunar/uca.xml at each login, replacing only
     actions whose unique-id starts with "karchy-", so your own are kept.
     Extract Here / Extract To / Create Archive come from thunar-archive-plugin;
     Open With and Set Default Application are Thunar's own. -->
<actions>
<action>
  <icon>utilities-terminal</icon>
  <name>Open Terminal Here</name>
  <unique-id>karchy-terminal</unique-id>
  <command>xdg-terminal-exec --dir=%f</command>
  <description>Open a terminal in this folder</description>
  <patterns>*</patterns>
  <directories/>
</action>
<action>
  <icon>com.microsoft.VSCode</icon>
  <name>Open in VS Code</name>
  <unique-id>karchy-vscode</unique-id>
  <command>code %F</command>
  <description>Open in Visual Studio Code</description>
  <patterns>*</patterns>
  <directories/>
  <audio-files/>
  <image-files/>
  <other-files/>
  <text-files/>
  <video-files/>
</action>
<action>
  <icon>localsend</icon>
  <name>Send with LocalSend</name>
  <unique-id>karchy-localsend</unique-id>
  <command>localsend --headless send %F</command>
  <description>Send to a nearby device with LocalSend</description>
  <patterns>*</patterns>
  <directories/>
  <audio-files/>
  <image-files/>
  <other-files/>
  <text-files/>
  <video-files/>
</action>
<action>
  <icon>edit-copy</icon>
  <name>Copy Path</name>
  <unique-id>karchy-copy-path</unique-id>
  <command>karchy-file-action copy-path %F</command>
  <description>Copy the full path to the clipboard</description>
  <patterns>*</patterns>
  <directories/>
  <audio-files/>
  <image-files/>
  <other-files/>
  <text-files/>
  <video-files/>
</action>
<action>
  <icon>preferences-desktop-wallpaper</icon>
  <name>Set as Wallpaper</name>
  <unique-id>karchy-wallpaper</unique-id>
  <command>karchy-file-action wallpaper %f</command>
  <description>Use this image as the background</description>
  <range>1</range>
  <patterns>*.jpg;*.jpeg;*.png;*.webp;*.JPG;*.JPEG;*.PNG;*.WEBP</patterns>
  <image-files/>
</action>
<action>
  <icon>dialog-password</icon>
  <name>Checksum (SHA-256)</name>
  <unique-id>karchy-checksum</unique-id>
  <command>karchy-file-action checksum %f</command>
  <description>Copy this file's SHA-256 checksum to the clipboard</description>
  <range>1</range>
  <patterns>*</patterns>
  <audio-files/>
  <image-files/>
  <other-files/>
  <text-files/>
  <video-files/>
</action>
<action>
  <icon>folder-remote</icon>
  <name>Keep This Mount</name>
  <unique-id>karchy-mount-keep</unique-id>
  <command>karchy-launch-floating-terminal-with-presentation karchy-mount-keep %f</command>
  <description>Mount this network share at /mnt whenever it is opened (D-24)</description>
  <patterns>*</patterns>
  <directories/>
</action>
<action>
  <icon>folder-remote</icon>
  <name>Remove Kept Mount</name>
  <unique-id>karchy-mount-remove</unique-id>
  <command>karchy-launch-floating-terminal-with-presentation karchy-mount-keep --remove %f</command>
  <description>Stop keeping this network share mounted</description>
  <patterns>*</patterns>
  <directories/>
</action>
</actions>
