[Desktop Entry]
# The Virtual machines window as an app (D-116). VMs are a Quick install
# feature with no package of their own, so TryExec ties this entry to QEMU:
# launchers leave it out until `karchy-feature-vms install` has run.
Type=Application
Name=Virtual Machines
Comment=Create and run virtual machines
Exec=karchy-vm manage
TryExec=qemu-system-x86_64
Icon=virt-manager
Terminal=false
Categories=System;Emulator;
Keywords=vm;vms;qemu;kvm;windows;
StartupNotify=false
# Removing this app from the launcher removes the feature, not the package
# that owns this file (karchy-remove-launcher-entry).
X-Karchy-Feature=karchy-feature-vms
