/**
 * @name Karchy
 * @author karchy
 * @description Discord in the colours of the current karchy theme. karchy rewrites this file at every theme change, so edit ~/.config/karchy/themed/vesktop.css.tpl instead.
 * @version 1.0.0
 */

/* The palette: the theme's colours by the part they play in Discord. Raised
   surfaces and weaker text are mixed from the background and the text colour,
   so they keep their order in a light theme as in a dark one. */
:root {
  color-scheme: {{ mode }};

  --karchy-bg-0: {{ darker_background }};
  --karchy-bg-1: {{ dark_background }};
  --karchy-bg-2: {{ background }};
  --karchy-bg-3: {{ mix background foreground 5% }};
  --karchy-bg-4: {{ mix background foreground 10% }};

  --karchy-fg-0: {{ bright_foreground }};
  --karchy-fg-1: {{ foreground }};
  --karchy-fg-2: {{ mix foreground background 10% }};
  --karchy-fg-3: {{ mix foreground background 18% }};
  --karchy-fg-4: {{ mix foreground background 26% }};

  --karchy-accent: {{ accent }};
  --karchy-accent-hover: {{ mix accent background 15% }};
  --karchy-accent-active: {{ mix accent background 28% }};
  /* Text on a filled button or badge: the accent is chosen to stand out from
     the background, so the background reads on it. */
  --karchy-on-accent: {{ background }};

  --karchy-red: {{ red }};
  --karchy-orange: {{ orange }};
  --karchy-yellow: {{ yellow }};
  --karchy-green: {{ green }};
  --karchy-cyan: {{ cyan }};
  --karchy-blue: {{ blue }};
  --karchy-magenta: {{ magenta }};

  --karchy-red-strong: {{ mix red background 25% }};
  --karchy-orange-strong: {{ mix orange background 25% }};
  --karchy-yellow-strong: {{ mix yellow background 25% }};
  --karchy-green-strong: {{ mix green background 25% }};
  --karchy-cyan-strong: {{ mix cyan background 25% }};
  --karchy-blue-strong: {{ mix blue background 25% }};
  --karchy-magenta-strong: {{ mix magenta background 25% }};

  --karchy-bright-red: {{ bright_red }};
  --karchy-bright-yellow: {{ bright_yellow }};
  --karchy-bright-green: {{ bright_green }};
  --karchy-bright-cyan: {{ bright_cyan }};
  --karchy-bright-blue: {{ bright_blue }};
  --karchy-bright-magenta: {{ bright_magenta }};
}

::selection {
  background-color: {{ selection_background }};
  color: {{ selection_foreground }};
}

/* Discord's own colour variables, each given the karchy colour that plays the
   same part. The same values go to all four of Discord's themes (Light, Ash,
   Dark, Onyx), so the look doesn't depend on the one picked in Discord.
