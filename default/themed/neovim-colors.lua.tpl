-- karchy color scheme for Neovim, from the current theme
-- (default/themed/neovim-colors.lua.tpl). Syntax colors follow the VS Code theme
-- (vscode-theme.json.tpl). karchy-theme-set-neovim links it to
-- ~/.local/share/nvim/site/colors/karchy.lua and reloads Neovim windows that use
-- it on a theme switch. Select it once with `:colorscheme karchy`, or put
-- `vim.cmd.colorscheme("karchy")` in your init.lua. LazyVim users have
-- neovim.lua next to this file instead.

local c = {
  bg = "{{ background }}",
  bg_dark = "{{ dark_background }}",
  bg_darker = "{{ darker_background }}",
  bg_light = "{{ lighter_background }}",
  bg_line = "{{ mix background foreground 6% }}",
  bg_float = "{{ mix background foreground 4% }}",
  fg = "{{ foreground }}",
  fg_dark = "{{ dark_foreground }}",
  fg_light = "{{ light_foreground }}",
  fg_bright = "{{ bright_foreground }}",
  muted = "{{ muted }}",
  accent = "{{ accent }}",
  selection = "{{ selection_background }}",
  selection_fg = "{{ selection_foreground }}",
  red = "{{ red }}",
  orange = "{{ orange }}",
  yellow = "{{ yellow }}",
  green = "{{ green }}",
  cyan = "{{ cyan }}",
  blue = "{{ blue }}",
  magenta = "{{ magenta }}",
  bright_red = "{{ bright_red }}",
  bright_yellow = "{{ bright_yellow }}",
  bright_green = "{{ bright_green }}",
  bright_cyan = "{{ bright_cyan }}",
  bright_blue = "{{ bright_blue }}",
  bright_magenta = "{{ bright_magenta }}",
  diff_add = "{{ mix background green 15% }}",
  diff_delete = "{{ mix background red 15% }}",
  diff_change = "{{ mix background blue 12% }}",
  diff_text = "{{ mix background blue 30% }}",
  search = "{{ mix background yellow 30% }}",
}

vim.cmd("highlight clear")
if vim.fn.exists("syntax_on") == 1 then
  vim.cmd("syntax reset")
end
vim.o.background = "{{ mode }}"
vim.o.termguicolors = true
vim.g.colors_name = "karchy"

