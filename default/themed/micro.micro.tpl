# karchy color scheme for micro, from the current theme (default/themed/micro.micro.tpl).
# Syntax colors follow the VS Code theme (vscode-theme.json.tpl). micro reads
# it at start; ~/.config/micro/colorschemes/karchy.micro links here.
color-link default "{{ foreground }},{{ background }}"
color-link comment "italic {{ muted }}"
color-link identifier "{{ blue }}"
color-link constant "{{ cyan }}"
color-link constant.string "{{ green }}"
color-link constant.string.char "{{ green }}"
color-link constant.number "{{ orange }}"
color-link constant.bool "{{ orange }}"
color-link constant.specialChar "{{ bright_magenta }}"
color-link statement "{{ bright_magenta }}"
color-link symbol "{{ dark_foreground }}"
color-link symbol.operator "{{ bright_blue }}"
color-link symbol.brackets "{{ dark_foreground }}"
color-link symbol.tag "{{ yellow }}"
color-link preproc "{{ blue }}"
color-link type "{{ yellow }}"
color-link type.keyword "{{ yellow }}"
color-link special "{{ cyan }}"
color-link underlined "underline {{ accent }}"
color-link error "bold {{ red }}"
color-link todo "bold {{ yellow }}"
color-link hlsearch "{{ background }},{{ accent }}"
color-link selection "{{ bright_foreground }},{{ selection_background }}"
color-link cursor-line "{{ mix background foreground 6% }}"
color-link color-column "{{ lighter_background }}"
color-link line-number "{{ muted }},{{ background }}"
color-link current-line-number "{{ accent }},{{ background }}"
color-link gutter-error "{{ red }}"
color-link gutter-warning "{{ yellow }}"
color-link diff-added "{{ green }}"
color-link diff-modified "{{ yellow }}"
color-link diff-deleted "{{ red }}"
color-link indent-char "{{ dark_foreground }}"
color-link match-brace "{{ background }},{{ accent }}"
color-link statusline "{{ foreground }},{{ lighter_background }}"
color-link statusline.inactive "{{ muted }},{{ dark_background }}"
color-link tabbar "{{ foreground }},{{ lighter_background }}"
color-link tabbar.active "{{ background }},{{ accent }}"
color-link divider "{{ lighter_background }},{{ background }}"
color-link scrollbar "{{ muted }}"
color-link message "{{ foreground }},{{ background }}"
color-link error-message "bold {{ red }},{{ background }}"
