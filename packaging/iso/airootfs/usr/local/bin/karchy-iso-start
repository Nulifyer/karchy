#!/bin/bash

# Start the karchy installer on the karchy ISO's first console, once per
# boot (root's .zlogin runs this on tty1). Leaving the installer, by Esc or
# Ctrl-C at a question, by finishing or by an error, leaves the root shell;
# `karchy-install` starts it again.
#
# Boot parameter karchy.config=<file or http(s) URL>: an unattended install
# with that answer file, as `karchy-install --config FILE`.

set -uo pipefail

marker=/run/karchy-iso-started
[[ -e $marker ]] && exit 0
: >"$marker"

# The installer's own screen code draws this one too. KARCHY_SRC is the
# installer as packaging/iso/build copies it onto the ISO.
KARCHY_SRC=${KARCHY_SRC:-/usr/share/karchy-installer}
# Nothing to log yet; karchy-install opens the real log itself.
# shellcheck disable=SC2034
KARCHY_INSTALL_LOG=/dev/null
# shellcheck source=/dev/null
source "$KARCHY_SRC/install/lib.sh"
# shellcheck source=/dev/null
source "$KARCHY_SRC/install/ui.sh"
# shellcheck source=/dev/null
source "$KARCHY_SRC/install/network.sh"
ui_init
# ui_init keeps the kernel's messages off these screens; the shell that
# follows gets them back.
trap ui_console_restore EXIT

boot_param() {
  local param
  for param in $(</proc/cmdline); do
    [[ $param == "$1="* ]] && { printf '%s\n' "${param#*=}"; return 0; }
  done
  return 1
}

ui_header "karchy installer"
ui_line "Esc or Ctrl-C at a question stops the installer and leaves a root shell;" "$UI_DIM"
ui_line "karchy-install starts it again. Alt+F2 opens another console." "$UI_DIM"
ui_line

# The network first: a cable connects by itself, a laptop without one gets
# the Wi-Fi list (install/network.sh). The installer then waits for the live
# system's pacman keyring, which can't be made before the network is there.
net_wait || { ui_line "Run karchy-install when the network is up."; exit 0; }

args=()
if config=$(boot_param karchy.config); then
  file=$config
  if [[ $config =~ ^https?:// ]]; then
    file=/run/karchy-install.conf
    (umask 077 && curl -fsSL --retry 5 -o "$file" "$config") ||
      { ui_line "Could not download $config" "$UI_RED"; exit 0; }
  fi
  args=(--config "$file")
  # Let mirror ranking (reflector) finish first; the form gives it time on
  # an interactive install.
  timeout 120 systemctl is-system-running --wait >/dev/null 2>&1 || true
fi

karchy-install "${args[@]}" || true
