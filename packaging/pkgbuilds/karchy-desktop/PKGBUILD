# karchy-desktop: the full karchy desktop, as installed by the installer.
# Everything karchy's own code needs is in karchy's depends; this adds the
# session, services, fonts and apps karchy ships with (docs/components.md).

pkgname=karchy-desktop
pkgver=0
pkgrel=1
pkgdesc="karchy desktop: karchy plus its session, services, fonts and apps"
arch=('any')
url="https://github.com/Nulifyer/karchy"
license=('MIT')
depends=(
  'karchy' 'karchy-settings' 'karchy-themes'
  # Session
  'greetd' 'hyprland-guiutils' 'xdg-user-dirs'
  # Audio
  'pipewire-alsa' 'pipewire-jack' 'alsa-utils'
  # Realtime priority for PipeWire, so audio doesn't crackle under load.
  'rtkit'
  # Hardware
  'bluez'
  # Network, firewall and local names (D-15, D-28)
  'ufw' 'avahi' 'nss-mdns'
  # Fonts and themes (D-22)
  'ttf-jetbrains-mono-nerd' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji'
  # Papirus: app icons, with folders recolored to each theme's accent by
  # karchy-theme-set-gnome
  'gnome-themes-extra' 'adw-gtk-theme' 'papirus-icon-theme'
  # Files and mounts (D-24, D-36, D-40)
  'thunar' 'thunar-archive-plugin' 'tumbler' 'ffmpegthumbnailer'
  'gvfs' 'gvfs-mtp' 'gvfs-smb' 'cifs-utils' 'xarchiver' '7zip' 'udiskie'
  # Format and check USB sticks and Windows disks (exFAT, NTFS); FAT's tools
  # come with the base system. GNOME Disks and udisks use them.
  'exfatprogs' 'ntfsprogs'
  # The terminal karchy's own commands open; the other apps karchy ships are
  # optdepends below, so they can be removed (D-71)
  'foot'
  # Titlebars with minimize, maximize and close on floating workspaces (D-60)
  'karchy-hyprland-titlebars'
  # Login keyring: the Secret Service for passwords and sign-ins (D-57)
  'oo7' 'libsecret'
  # Command-line basics scripts and installers expect
  'openssh' 'rsync' 'unzip'
  # System health and updates (D-28, D-29)
  'pacman-contrib' 'paru' 'rate-mirrors' 'smartmontools' 'fwupd'
  # Keeps the running kernel's modules after a kernel update, so a USB stick
  # or a VPN still loads its module until the restart (the installer enables
  # linux-modules-cleanup.service, which removes them at the next boot)
  'kernel-modules-hook'
  # Battery state for the shell's battery warnings, power panel and idle
  # suspend; harmless without a battery
  'upower'
  # Night light: Hyprland's own tool for the warm screen tint (display panel,
  # Settings › Displays; karchy-nightlight.service runs it only while in use)
  'hyprsunset'
)
# The apps karchy ships (D-34). The installer installs them explicitly and
# Quick install lists them as installed, so each can be removed like any app
# (D-71). They are the `default` entries of default/karchy/quick-install.json;
# tools/catalog-check keeps this list and those entries the same. An entry of
# several packages is named by its karchy-app-<id> package (D-150), which is
# what the installer installs.
optdepends=(
  'brave-origin-bin: the default web browser'
  'localsend-bin: send files to nearby devices'
  'omacalc: the calculator'
  'omawrite: the notepad; plain text and Markdown files open in it'
  'disktree-bin: see what fills a disk (Open in Disktree on folders)'
  'imv: the image viewer'
  'mpv: the video and audio player'
  # With nethogs, for its per-app network column (limited capabilities:
  # 95-karchy-nethogs.hook in karchy-settings); both go when the app does.
  'karchy-app-mission-center: Mission Center, the task manager (Ctrl+Shift+Esc)'
  'gnome-disk-utility: GNOME Disks, for disks and partitions'
)
