# karchy-bees: bees, the btrfs deduplication daemon, built from karchy's fork
# (D-85): upstream bees plus fixes that were tested in a VM on linux-cachyos
# 7.x (the fork's lab/RESULTS.md), and the --keep-prealloc option. It provides
# and conflicts with Arch's bees. karchy-settings depends on it and runs it
# through karchy-bees.service (D-86); upstream's beesd wrapper and
# beesd@.service are still included, for other filesystems.
#
# Native package: packaging/build builds it only with --native.
#
# A release: the fork (Nulifyer/bees, branch karchy) gets a tag v<pkgver>; set
# pkgver to it and _commit to the tag's commit (git rev-parse 'v<pkgver>^{commit}').
# prepare() checks it, so a moved tag can't change what is built.

# karchy:version-cmd=sed -n 's/^pkgver=//p' packaging/pkgbuilds/karchy-bees/PKGBUILD

pkgname=karchy-bees
pkgver=0.11_karchy4
_commit=8326b0ea2a4121679b11c13a53da03a0bc86cc94
pkgrel=1
pkgdesc="bees, the btrfs deduplication daemon, from karchy's fork"
arch=('x86_64')
url="https://github.com/Nulifyer/bees"
license=('GPL-3.0-or-later')
depends=('bash' 'btrfs-progs' 'gcc-libs' 'glibc' 'util-linux' 'util-linux-libs')
makedepends=('git' 'systemd')
provides=('bees=0.11')
conflicts=('bees')
source=("bees::git+https://github.com/Nulifyer/bees.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  local head
  head=$(git -C "$srcdir/bees" rev-parse HEAD)
  if [[ $head != "$_commit" ]]; then
    echo "v$pkgver is $head, not the pinned $_commit: update _commit after checking the tag." >&2
    return 1
  fi
  # Build with makepkg's flags, as Arch's bees package does.
  sed -e "s|^CCFLAGS =.*|CCFLAGS = $CFLAGS|" -i "$srcdir/bees/makeflags"
}

build() {
  make -C "$srcdir/bees" BEES_VERSION="$pkgver"
}

package() {
  make -C "$srcdir/bees" install DESTDIR="$pkgdir" BEES_VERSION="$pkgver"
  mv "$pkgdir/usr/sbin" "$pkgdir/usr/bin"
}
