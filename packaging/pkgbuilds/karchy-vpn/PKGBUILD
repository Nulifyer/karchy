# karchy-vpn: transitional, empty (D-156). The VPN was an add-on of this
# name; it is part of karchy now, installed by karchy-settings at the same
# paths. A machine that had the add-on upgrades it to this package in the
# same transaction that brings karchy-settings with the VPN's files, so the
# files move from one package to the other and nothing of the VPN stops or
# is removed: the add-on's own removal script (which took the tunnel down and
# deleted /etc/karchy-vpn) never runs, because an upgrade runs the new
# package's scripts, and this one has none. The migration
# 1795539895-vpn-in-core.sh then marks it as a dependency, and the next
# `karchy update` removes it (default/karchy/retired-packages). Keep it in
# the repository while machines may still skip to a release with it.

pkgname=karchy-vpn
pkgver=0
pkgrel=1
pkgdesc="Transitional package: karchy's VPN is part of karchy-settings now"
arch=('any')
url="https://github.com/Nulifyer/karchy"
license=('MIT')
source=("karchy-src.tar.gz")
sha256sums=('SKIP')

package() {
  :
}
