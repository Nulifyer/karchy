# The units start only once /etc/karchy-vpn/config exists; `karchy-vpn
# setup` writes it and enables them.

post_install() {
  if [[ ! -e /etc/karchy-vpn/config ]]; then
    echo ">>> karchy-vpn: import your WireGuard connection (Settings > Network > VPN),"
    echo ">>> copy /usr/share/karchy-vpn/config.example to ~/.config/karchy-vpn/config,"
    echo ">>> edit it, then run: karchy-vpn setup"
  fi
}

post_upgrade() {
  # The policy picks up the new helpers.
  if systemctl -q is-enabled karchy-vpn-policy.path 2>/dev/null; then
    systemctl try-restart karchy-vpn-policy.path >/dev/null 2>&1 || true
    /usr/lib/karchy-vpn/control refresh 2>/dev/null || true
  fi
}

pre_remove() {
  # Leave the machine as it was: tunnel down, guard gone, DNS restored.
  # Nothing may start the policy again first (taking the tunnel down is
  # itself a network event), so the units stop before the shutdown. pacman
  # runs this in a network namespace of its own, so the shutdown itself
  # runs as a unit, in the system's.
  systemctl disable --now karchy-vpn-policy.path karchy-vpn-guard.service >/dev/null 2>&1 || true
  systemctl stop karchy-vpn-check.timer karchy-vpn-check.service karchy-vpn-policy.service >/dev/null 2>&1 || true
  systemctl start karchy-vpn-shutdown.service >/dev/null 2>&1 || true
}

post_remove() {
  # Whatever ran last, no kill switch outlives the package.
  systemd-run --quiet --wait --collect /usr/bin/bash -c \
    'nft delete table inet karchy_vpn_guard 2>/dev/null; while ip -4 rule del priority 20054 protocol 242 2>/dev/null; do :; done; rm -rf /run/karchy-vpn' \
    >/dev/null 2>&1 || true
  # Root's copy of the configuration and the saved mode go too, so nothing of
  # the VPN is left; the user's own ~/.config/karchy-vpn/config stays, for
  # `karchy-vpn setup` after installing it again.
  rm -rf /etc/karchy-vpn /var/lib/karchy-vpn
}
