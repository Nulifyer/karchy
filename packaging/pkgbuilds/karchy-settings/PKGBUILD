# karchy-settings: system defaults and the user's starting configs (D-52).
# The installer pacstraps it with the base system, before the first user is
# created, so /etc/skel and the mkinitcpio drop-in are in place in time.

pkgname=karchy-settings
pkgver=0
pkgrel=1
pkgdesc="karchy system defaults, starter configs, lock-screen PAM and session units"
arch=('any')
url="https://github.com/Nulifyer/karchy"
license=('MIT')
depends=('sudo' 'pam' 'systemd' 'rate-mirrors' 'pacman-contrib' 'iw' 'wireless-regdb' 'eza' 'karchy-bees>=0.11_karchy4'
  # Settings › Storage's "Measure now": compsize counts what files hold
  # against what they take on a btrfs disk; jq writes the result.
  'compsize' 'jq'
  # The VPN (docs/vpn.md): wg reads a tunnel's handshake and data
  # (wireguard-tools, a few hundred kB); the kill switch is an nftables table.
  'wireguard-tools' 'nftables' 'iproute2' 'polkit' 'python' 'networkmanager'
  # The login keyring (D-142): keyring-login gives a keyring another secret
  # with oo7-cli (`--secret -` is 0.7.2's; 0.7.3 moved the options behind
  # the command, where keyring-rekey puts them) on a bus of its own
  # (dbus-run-session), through a terminal from script(1), as the person
  # (setpriv, unshare), after checking the password (unix_chkpwd, in pam).
  'oo7>=0.7.2' 'dbus' 'util-linux'
  # The disk-password screen (D-122): the mkinitcpio drop-in below names
  # Plymouth's hook, so the package must be there when an image is built.
  'plymouth')
backup=(
  'etc/sudoers.d/karchy'
  'etc/sudoers.d/karchy-theme-browser'
  'etc/mkinitcpio.conf.d/karchy.conf'
  'etc/mkinitcpio.conf.d/karchy-thunderbolt.conf'
  'etc/mpv/mpv.conf'
  'etc/gnupg/dirmngr.conf'
  'etc/makepkg.conf.d/karchy.conf'
  'etc/systemd/system/tmp.mount.d/karchy.conf'
  'etc/systemd/oomd.conf.d/10-karchy.conf'
  'etc/xdg/uwsm/env'
  'etc/profile.d/karchy.sh'
  'etc/fish/conf.d/karchy.fish'
  'etc/xdg/xdg-terminals.list'
  'etc/xdg/mimeapps.list'
  'etc/xdg/fastfetch/config.jsonc'
  'etc/pam.d/karchy-lock-password'
  'etc/pam.d/karchy-login'
  'etc/pam.d/karchy-polkit-auth'
)
source=("karchy-src.tar.gz")
sha256sums=('SKIP')

package() {
  local unit
  cd "$srcdir/karchy/system"
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -m440 sudoers.d/karchy sudoers.d/karchy-theme-browser "$pkgdir/etc/sudoers.d/"
  install -Dm755 limine/95-karchy-limine-fallback "$pkgdir/etc/boot/hooks/post.d/95-karchy-limine-fallback"
  install -Dm644 makepkg.conf.d/karchy.conf "$pkgdir/etc/makepkg.conf.d/karchy.conf"
  # Limine's look (D-121): karchy's name, the default theme's colours and
  # the font as an 8x32 bitmap (D-154), written into limine.conf by
  # limine-brand.
  install -Dm755 limine/limine-brand "$pkgdir/usr/lib/karchy/limine-brand"
  install -Dm644 console/karchy-8x32.bin "$pkgdir/usr/share/karchy/limine/karchy-8x32.bin"
  # The console font (D-121): karchy's monospace font as bitmaps
  # (tools/console-font), which the installer names in vconsole.conf.
  install -Dm644 -t "$pkgdir/usr/share/kbd/consolefonts" console/karchy-*.psfu
  install -Dm644 console/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-JetBrainsMono.txt"
  # The boot screen behind the disk-password prompt (D-121), with the
  # mkinitcpio hook that puts it in the initramfs.
  install -Dm755 boot-screen/boot-banner "$pkgdir/usr/lib/karchy/boot-banner"
  install -Dm644 -t "$pkgdir/usr/lib/karchy" ../logo.txt ../logo-mark.txt
  install -Dm644 boot-screen/karchy-boot-banner.service "$pkgdir/usr/lib/systemd/system/karchy-boot-banner.service"
  install -Dm644 boot-screen/sd-karchy-banner "$pkgdir/usr/lib/initcpio/install/sd-karchy-banner"
  # ...and the way back to it when Plymouth dies in the initramfs.
  install -Dm755 boot-screen/prompt-fallback "$pkgdir/usr/lib/karchy/prompt-fallback"
  install -Dm644 boot-screen/plymouth-start-fallback.conf "$pkgdir/usr/lib/karchy/plymouth-start-fallback.conf"
  install -Dm644 boot-screen/karchy-prompt-fallback.service \
    "$pkgdir/usr/lib/systemd/system/karchy-prompt-fallback.service"
  # The disk-password screen (D-122): karchy's Plymouth theme. The pictures
  # are drawn by tools/plymouth-theme and committed. The installer and a
  # migration make it the default theme and set Plymouth's scale to 1
  # (/etc/plymouth/plymouthd.conf; D-173).
  install -Dm644 -t "$pkgdir/usr/share/plymouth/themes/karchy" plymouth/karchy/*
  # ...and Plymouth only with "splash" on the kernel line, so a boot without
  # it is karchy's text screen.
  for unit in start poweroff reboot halt kexec; do
    install -Dm644 plymouth/10-karchy-splash.conf \
      "$pkgdir/usr/lib/systemd/system/plymouth-$unit.service.d/10-karchy-splash.conf"
  done
  # ...and the shutdown splash without Pango, which held /var/cache busy.
  for unit in poweroff reboot halt kexec; do
    install -Dm644 plymouth/20-karchy-shutdown-no-pango.conf \
      "$pkgdir/usr/lib/systemd/system/plymouth-$unit.service.d/20-karchy-shutdown-no-pango.conf"
  done
  # Hooks that must be in place before the desktop packages arrive (karchy-settings
  # is pacstrapped with the base system), such as limiting nethogs.
  install -Dm644 -t "$pkgdir/usr/share/libalpm/hooks" pacman/settings-hooks/*.hook
  install -Dm644 mkinitcpio.conf.d/karchy.conf "$pkgdir/etc/mkinitcpio.conf.d/karchy.conf"
  install -Dm644 mkinitcpio.conf.d/karchy-thunderbolt.conf "$pkgdir/etc/mkinitcpio.conf.d/karchy-thunderbolt.conf"
  install -Dm644 snapper/root "$pkgdir/etc/snapper/config-templates/karchy"
  install -Dm644 systemd/tmp.mount.d/karchy.conf "$pkgdir/etc/systemd/system/tmp.mount.d/karchy.conf"
  install -Dm644 systemd/oomd.conf.d/10-karchy.conf "$pkgdir/etc/systemd/oomd.conf.d/10-karchy.conf"
  # Rescue and emergency shells work with root's password locked.
  install -Dm644 systemd/sulogin.conf "$pkgdir/usr/lib/systemd/system/rescue.service.d/10-karchy-sulogin.conf"
  install -Dm644 systemd/sulogin.conf "$pkgdir/usr/lib/systemd/system/emergency.service.d/10-karchy-sulogin.conf"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/coredump.conf.d" systemd/coredump.conf.d/10-karchy.conf
  install -Dm644 systemd/fprintd.service.d/10-stop-timeout.conf \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/10-stop-timeout.conf"
  # LocalSend's port follows the trusted-network list (D-33).
  install -Dm755 NetworkManager/dispatcher.d/90-karchy-localsend \
    "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-karchy-localsend"
  # ...and is closed at boot until a trusted network connects; the installer
  # enables the unit.
  install -Dm644 systemd/system/karchy-localsend-firewall.service \
    "$pkgdir/usr/lib/systemd/system/karchy-localsend-firewall.service"
  # karchy's DNS on networks that aren't trusted, the network's own on trusted
  # ones (D-68; karchy-network-dns is in karchy).
  # avahi only on trusted networks (karchy-network-privacy).
  install -Dm755 NetworkManager/dispatcher.d/91-karchy-privacy \
    "$pkgdir/usr/lib/NetworkManager/dispatcher.d/91-karchy-privacy"
  install -Dm644 systemd/system/karchy-network-privacy.service \
    "$pkgdir/usr/lib/systemd/system/karchy-network-privacy.service"
  install -Dm755 NetworkManager/dispatcher.d/95-karchy-dns \
    "$pkgdir/usr/lib/NetworkManager/dispatcher.d/95-karchy-dns"
  # The WireGuard VPN with a kill switch (D-68, part of karchy since D-156;
  # docs/vpn.md): the root helpers the policy, the guard and the commands
  # run, its units (nothing starts until `karchy-vpn setup` writes
  # /etc/karchy-vpn/config), the dispatcher hook that asks the policy to look
  # again (also in pre-up.d, so the guard closes before a new link carries
  # anything), and the polkit rule letting the person at the computer switch
  # modes, reconnect and pause for a sign-in page without a password. The
  # paths are the ones the karchy-vpn add-on used, so a VPN set up with it
  # carries on.
  install -Dm644 vpn/common.sh -t "$pkgdir/usr/lib/karchy-vpn"
  install -Dm755 vpn/control vpn/policy vpn/guard vpn/configure -t "$pkgdir/usr/lib/karchy-vpn"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" vpn/karchy-vpn-check.service vpn/karchy-vpn-guard.service \
    vpn/karchy-vpn-policy.path vpn/karchy-vpn-policy.service
  install -Dm644 vpn/karchy-vpn.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/karchy-vpn.conf"
  install -Dm644 vpn/config.example "$pkgdir/usr/share/karchy-vpn/config.example"
  install -Dm755 NetworkManager/dispatcher.d/90-karchy-vpn "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-karchy-vpn"
  install -d "$pkgdir/usr/lib/NetworkManager/dispatcher.d/pre-up.d"
  ln -sf ../90-karchy-vpn "$pkgdir/usr/lib/NetworkManager/dispatcher.d/pre-up.d/90-karchy-vpn"
  install -Dm644 polkit/actions/org.karchy.vpn.policy -t "$pkgdir/usr/share/polkit-1/actions"
  install -Dm644 polkit/rules.d/50-karchy-vpn.rules -t "$pkgdir/usr/share/polkit-1/rules.d"

  # Network tuning: Wi-Fi power save off, ARP, MTU probing, BBR + fq, and
  # avahi as the only .local responder. In /usr/lib, so files in /etc win.
  install -Dm644 -t "$pkgdir/usr/lib/NetworkManager/conf.d" NetworkManager/conf.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/sysctl.d" sysctl.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/modules-load.d" modules-load.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/systemd/resolved.conf.d" systemd/resolved.conf.d/*.conf
  # Weekly mirror ranking (D-29) and the lock it shares with karchy update.
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" systemd/system/karchy-mirrors.service systemd/system/karchy-mirrors.timer
  install -Dm644 tmpfiles.d/karchy.conf "$pkgdir/usr/lib/tmpfiles.d/karchy.conf"
  # bees, the background deduplicator of the system disk (D-86): the service,
  # its runner and karchy's defaults; the installer enables the service.
  install -Dm644 bees/karchy-bees.service "$pkgdir/usr/lib/systemd/system/karchy-bees.service"
  install -Dm755 bees/bees-run "$pkgdir/usr/lib/karchy/bees-run"
  install -Dm644 bees/bees.conf "$pkgdir/usr/share/karchy/bees.conf"
  # logind: the power key opens karchy's menu; lock before sleep may take 15 s.
  install -Dm644 -t "$pkgdir/usr/lib/systemd/logind.conf.d" systemd/logind.conf.d/*.conf
  # System tuning (docs/ownership-audit.md): stop timeouts, open-file and
  # mount-event limits, per-disk I/O schedulers, logout order, mpv on the GPU,
  # spare GPG key servers. /usr/lib files lose to same-named files in /etc.
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system.conf.d" systemd/system.conf.d/*.conf
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user.conf.d" systemd/user.conf.d/*.conf
  install -Dm644 udev/60-karchy-ioschedulers.rules "$pkgdir/usr/lib/udev/rules.d/60-karchy-ioschedulers.rules"
  # USB autosuspend off (user 2026-11-16).
  install -Dm644 udev/90-karchy-usb-autosuspend.rules "$pkgdir/usr/lib/udev/rules.d/90-karchy-usb-autosuspend.rules"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user/wayland-wm@hyprland.desktop.service.d" \
    "systemd/user/wayland-wm@hyprland.desktop.service.d/10-karchy-keep-shell.conf"
  install -Dm644 mpv/mpv.conf "$pkgdir/etc/mpv/mpv.conf"
  install -Dm644 gnupg/dirmngr.conf "$pkgdir/etc/gnupg/dirmngr.conf"
  install -Dm755 systemd/system-sleep/fprintd-resume "$pkgdir/usr/lib/systemd/system-sleep/fprintd-resume"
  # PipeWire and JACK clients ask rtkit for realtime themselves, not through
  # the portal (Omarchy #16824). In /usr/share, so files in /etc/pipewire win.
  install -Dm644 -t "$pkgdir/usr/share/pipewire/client.conf.d" pipewire/client.conf.d/50-karchy-rtkit.conf
  install -Dm644 -t "$pkgdir/usr/share/pipewire/jack.conf.d" pipewire/jack.conf.d/50-karchy-rtkit.conf
  install -Dm644 uwsm/env "$pkgdir/etc/xdg/uwsm/env"
  install -Dm644 profile.d/karchy.sh "$pkgdir/etc/profile.d/karchy.sh"
  install -Dm644 fish/karchy.fish "$pkgdir/etc/fish/conf.d/karchy.fish"
  # karchy's prompt; a fish_prompt.fish in ~/.config/fish/functions wins.
  install -Dm644 fish/functions/fish_prompt.fish "$pkgdir/usr/share/fish/vendor_functions.d/fish_prompt.fish"
  install -Dm644 xdg/xdg-terminals.list "$pkgdir/etc/xdg/xdg-terminals.list"
  install -Dm644 xdg/mimeapps.list "$pkgdir/etc/xdg/mimeapps.list"
  # fastfetch with karchy's mark (logo-mark.txt in /usr/lib/karchy, above),
  # for a terminal and for Settings › About; ~/.config/fastfetch wins.
  install -Dm644 xdg/fastfetch/config.jsonc "$pkgdir/etc/xdg/fastfetch/config.jsonc"
  # Brave reads its theme color from here; karchy-theme-set-browser writes
  # color.json only into policy folders that exist.
  install -d -m 755 "$pkgdir/etc/brave/policies/managed"
  # foot entries that tell xdg-terminal-exec how to pass --app-id and friends.
  install -Dm644 -t "$pkgdir/usr/share/applications" applications/karchy-*.desktop
  # Thunar's Send To › LocalSend; hidden while LocalSend isn't installed.
  install -Dm644 thunar/sendto/karchy-localsend.desktop "$pkgdir/usr/share/Thunar/sendto/karchy-localsend.desktop"
  install -Dm644 pam.d/karchy-lock-password "$pkgdir/etc/pam.d/karchy-lock-password"
  # The login screen's PAM service (D-131, D-142): greetd's config names it,
  # and it runs keyring-login, below.
  install -Dm644 pam.d/karchy-login "$pkgdir/etc/pam.d/karchy-login"
  # polkit's password check (D-163): a cancelled password dialog is not a
  # failed login. polkit-pam points /etc/pam.d/polkit-1 at it.
  install -Dm644 pam.d/karchy-polkit-auth "$pkgdir/etc/pam.d/karchy-polkit-auth"
  install -Dm755 pam.d/polkit-pam "$pkgdir/usr/lib/karchy/polkit-pam"
  # Font defaults: monospace is Noto Sans Mono, unless karchy-font-set
  # chose another (the state file it includes) or the user's fontconfig does.
  install -Dm644 fontconfig/50-karchy.conf "$pkgdir/usr/share/fontconfig/conf.avail/50-karchy.conf"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s ../../../usr/share/fontconfig/conf.avail/50-karchy.conf "$pkgdir/etc/fonts/conf.d/50-karchy.conf"
  # GNOME setting defaults: GTK's monospace text follows that font (D-120).
  # glib2's pacman hook compiles the schemas.
  install -Dm644 glib-schemas/50_karchy.gschema.override "$pkgdir/usr/share/glib-2.0/schemas/50_karchy.gschema.override"
  # karchy's XKB option (Shift + Caps Lock is Compose), read before the system rules.
  install -Dm644 xkb/rules/evdev "$pkgdir/etc/xkb/rules/evdev"
  install -Dm644 xkb/symbols/karchy "$pkgdir/etc/xkb/symbols/karchy"
  # The login keyring's key, imported by each user manager (D-57).
  # Wi-Fi regulatory domain from the timezone (ported from CachyOS): set when
  # a Wi-Fi device appears; karchy-menu-timezone reruns it.
  install -Dm755 wifi/wifi-regdomain "$pkgdir/usr/lib/karchy/wifi-regdomain"
  install -Dm644 wifi/85-karchy-wifi-regdomain.rules "$pkgdir/usr/lib/udev/rules.d/85-karchy-wifi-regdomain.rules"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" wifi/karchy-wifi-regdomain.service
  # ...and the timezone menu may restart it without a password.
  install -Dm644 polkit/rules.d/50-karchy-wifi-regdomain.rules "$pkgdir/usr/share/polkit-1/rules.d/50-karchy-wifi-regdomain.rules"
  # Settings › Power: the root helper that writes the lid and hibernate-delay
  # drop-ins (/etc/systemd/{logind,sleep}.conf.d/60-karchy-settings.conf), its
  # polkit action, and the rule that spares the person at the computer the
  # password. Its drop-ins sort after karchy-laptop's (30) and karchy-nvidia's
  # (40), and before a file the user numbers higher.
  install -Dm755 power/power-settings "$pkgdir/usr/lib/karchy/power-settings"
  install -Dm644 polkit/actions/org.karchy.power-settings.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.karchy.power-settings.policy"
  install -Dm644 polkit/rules.d/50-karchy-power-settings.rules \
    "$pkgdir/usr/share/polkit-1/rules.d/50-karchy-power-settings.rules"

  # Settings › Storage: the root helper behind the page (disk health, bees'
  # progress and switch, "Measure now"), with its polkit action and the rule
  # that spares the person at the computer the password; the count "Measure
  # now" starts (no timer runs it, D-123); the SMART reader; the lister of a
  # btrfs filesystem's subvolumes (D-141); and the one reader of bees' status
  # file.
  install -Dm755 -t "$pkgdir/usr/lib/karchy" storage/storage-measure storage/storage-settings storage/storage-health \
    storage/storage-subvolumes storage/bees-summary
  # Quick install's root side (D-109): installs and removes catalog apps by
  # id, always with an administrator's password.
  install -Dm755 packages/app-packages "$pkgdir/usr/lib/karchy/app-packages"
  install -Dm644 polkit/actions/org.karchy.app-packages.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.karchy.app-packages.policy"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" storage/karchy-storage-measure.service
  install -Dm644 polkit/actions/org.karchy.storage-settings.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.karchy.storage-settings.policy"
  install -Dm644 polkit/rules.d/50-karchy-storage-settings.rules \
    "$pkgdir/usr/share/polkit-1/rules.d/50-karchy-storage-settings.rules"

  # Settings › Network › VPN and the VPN's bar widget: the reader of the
  # WireGuard tunnels' health (last handshake, server, data), which the
  # kernel tells only root, with its polkit action (the active local session,
  # no password; nothing it prints is a secret).
  install -Dm755 network/wireguard-status "$pkgdir/usr/lib/karchy/wireguard-status"
  install -Dm644 polkit/actions/org.karchy.wireguard-status.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.karchy.wireguard-status.policy"

  # Settings › Users (D-139): the root helper that owns what an account is
  # and when the computer logs in by itself, with its polkit action (an
  # administrator's password for every change). The installer makes the first
  # account with it, so it comes with the base.
  install -Dm755 users/users-settings "$pkgdir/usr/lib/karchy/users-settings"
  install -Dm644 polkit/actions/org.karchy.users-settings.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.karchy.users-settings.policy"

  install -Dm755 keyring/keyring-key "$pkgdir/usr/lib/karchy/keyring-key"
  # The login keyring follows how its owner gets in (D-142): the root hook
  # karchy-login's PAM file runs, the part of it that runs as the person
  # logging in, and the session bus that part gets.
  install -Dm755 -t "$pkgdir/usr/lib/karchy" keyring/keyring-login keyring/keyring-rekey
  install -Dm644 keyring/rekey-bus.conf "$pkgdir/usr/lib/karchy/keyring-rekey-bus.conf"
  install -Dm644 keyring/rekey-secrets.service \
    "$pkgdir/usr/lib/karchy/keyring-rekey-services/org.freedesktop.secrets.service"
  install -Dm644 systemd/system/karchy-keyring-key@.service "$pkgdir/usr/lib/systemd/system/karchy-keyring-key@.service"
  install -Dm644 systemd/system/user@.service.d/karchy-keyring.conf \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/karchy-keyring.conf"
  # A boot into a snapshot is noted before the session starts, so the login
  # notice can name the snapshot (karchy-snapshot-boot).
  install -Dm644 systemd/system/karchy-snapshot-boot.service "$pkgdir/usr/lib/systemd/system/karchy-snapshot-boot.service"
  install -Dm644 systemd/system/user@.service.d/karchy-snapshot-boot.conf \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/karchy-snapshot-boot.conf"

  # Disk-health warnings reach the desktop: root's helper records what smartd
  # (through /etc/smartd.conf, which the installer points at it) and each
  # btrfs scrub found in /var/lib/karchy/disk-health (tmpfiles.d above); the
  # session's karchy-disk-health.service turns a new record into a
  # notification (karchy-disk-health, in karchy).
  install -Dm755 disk-health/disk-health "$pkgdir/usr/lib/karchy/disk-health"
  install -Dm644 disk-health/btrfs-scrub.conf \
    "$pkgdir/usr/lib/systemd/system/btrfs-scrub@.service.d/10-karchy-disk-health.conf"

  cd "$srcdir/karchy"
  # User units and drop-ins; the installer enables the units per machine.
  install -d "$pkgdir/usr/lib/systemd/user"
  cp -a default/systemd/user/. "$pkgdir/usr/lib/systemd/user/"
  # ...and the ones that start with every session without being enabled: the
  # disk-health watcher, and disconnecting network shares before sleep.
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" system/systemd/user/karchy-disk-health.service \
    system/systemd/user/karchy-sleep-shares.service
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  for unit in karchy-disk-health.service karchy-sleep-shares.service; do
    ln -s "../$unit" "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/$unit"
  done

  # Starting configs for new users, never touched again after creation (D-07).
  # No shell.json: the shell reads karchy's defaults and a user file holds only
  # what differs (D-92), so default changes keep reaching every user.
  install -d "$pkgdir/etc/skel/.config/karchy/themes"
  cp -a config/. "$pkgdir/etc/skel/.config/"
  # The terminals' text-size files those configs include (D-117), written by
  # the command that owns them so the two can't drift.
  HOME="$pkgdir/etc/skel" XDG_STATE_HOME="$pkgdir/etc/skel/.local/state" bash bin/karchy-display-text-size sync
}
