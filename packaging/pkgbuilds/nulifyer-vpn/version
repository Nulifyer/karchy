#!/bin/bash
# nulifyer-vpn's version for packaging/build (karchy:version-cmd): the pinned
# release (nothing while _commit is the placeholder), or for a branch build (NULIFYER_VPN_REF) that branch's own version
# in karchy's scheme: v2.0.0 plus 3 commits is 2.0.0.r3.gabc1234, and before
# the first tag 0.0.0.r<commits>.g<hash>.
set -euo pipefail
cd "$(dirname "$0")"
if [[ -z ${NULIFYER_VPN_REF:-} ]]; then
  # Nothing to build until a release is pinned (packaging/build skips it).
  grep -q '^_commit=0\{40\}' PKGBUILD && exit 0
  sed -n 's/^pkgver=//p' PKGBUILD
  exit 0
fi
repo=${NULIFYER_VPN_GIT:?NULIFYER_VPN_GIT names the checkout to build}
ref=$NULIFYER_VPN_REF
if described=$(git -C "$repo" describe --tags --long --match 'v[0-9]*' "$ref" 2>/dev/null); then
  [[ $described =~ ^v([0-9.]+)-([0-9]+)-(g[0-9a-f]+)$ ]]
  base=${BASH_REMATCH[1]} count=${BASH_REMATCH[2]} hash=${BASH_REMATCH[3]}
else
  base=0.0.0 count=$(git -C "$repo" rev-list --count "$ref") hash=g$(git -C "$repo" rev-parse --short=7 "$ref")
fi
if (( count == 0 )); then echo "$base"; else echo "$base.r$count.$hash"; fi
