#!/usr/bin/env python3
"""Vendor selected Omarchy files into karchy and keep them in sync.

Usage: tools/vendor-sync <command> [args]

  status                 Compare vendored files with the lock
  update <tag>           Move vendored files to an upstream tag (also the first import)
  override <path>...     Mark files as karchy overrides (kept on update; upstream
                         changes are reported for a manual merge)
  unoverride <path>...   Return files to plain vendored status
  upstream-diff <path>   Show what upstream changed in an override since it was last merged
  merged <path>...       Record that upstream changes to overrides are merged

Rules live in vendor/omarchy.paths, the result in vendor/omarchy.lock. The
upstream repository is cached in ${XDG_CACHE_HOME:-~/.cache}/karchy/omarchy.git.
Nothing is committed; review the result and open a PR.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RULES = REPO / "vendor" / "omarchy.paths"
LOCK = REPO / "vendor" / "omarchy.lock"
UPSTREAM_URL = os.environ.get("KARCHY_OMARCHY_URL", "https://github.com/basecamp/omarchy.git")
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "karchy" / "omarchy.git"


def die(message):
    print(f"vendor-sync: {message}", file=sys.stderr)
    sys.exit(1)


def git(*args, cwd=None, binary=False):
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True)
    if result.returncode != 0:
        die(f"git {' '.join(args)} failed: {result.stderr.decode().strip()}")
    return result.stdout if binary else result.stdout.decode()


def upstream(*args, binary=False):
    return git("--git-dir", str(CACHE), *args, binary=binary)


def glob_to_regex(pattern):
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**", i):
            out += ".*"
            i += 2
        elif pattern[i] == "*":
            out += "[^/]*"
            i += 1
        elif pattern[i] == "?":
            out += "[^/]"
            i += 1
        else:
            out += re.escape(pattern[i])
            i += 1
    return re.compile("^" + out + "$")


def load_rules():
    rules = []
    for number, line in enumerate(RULES.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        sign, _, pattern = line.partition(" ")
        if sign not in "+-" or not pattern:
            die(f"{RULES.name}:{number}: expected '+ <glob>' or '- <glob>'")
        rules.append((sign == "+", glob_to_regex(pattern.strip())))
    return rules


def selected(path, rules):
    keep = False
    for include, regex in rules:
        if regex.match(path):
            keep = include
    return keep


def read_lock():
    meta, entries = {}, {}
    if not LOCK.exists():
        return meta, entries
    for line in LOCK.read_text().splitlines():
        if line.startswith("# ") and ":" in line:
            key, _, value = line[2:].partition(":")
            meta[key.strip()] = value.strip()
        elif line and not line.startswith("#"):
            path, blob, mode, status = line.split("\t")
            entries[path] = {"blob": blob, "mode": mode, "status": status}
    return meta, entries


def write_lock(meta, entries):
    lines = [
        "# Vendored Omarchy files. Generated by tools/vendor-sync; do not edit by hand.",
        f"# upstream: {meta['upstream']}",
        f"# tag: {meta['tag']}",
        f"# commit: {meta['commit']}",
        "# columns: path, upstream blob, mode, status (vendored | override)",
    ]
    for path in sorted(entries):
        e = entries[path]
        lines.append(f"{path}\t{e['blob']}\t{e['mode']}\t{e['status']}")
    LOCK.write_text("\n".join(lines) + "\n")


def local_blob(path):
    full = REPO / path
    if not full.is_file():
        return None
    return git("hash-object", str(full)).strip()


def fetch(tag):
    if not CACHE.exists():
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        git("init", "--bare", "--quiet", str(CACHE))
        upstream("remote", "add", "origin", UPSTREAM_URL)
    upstream("fetch", "--quiet", "--depth", "1", "origin", f"refs/tags/{tag}:refs/tags/{tag}")
    return upstream("rev-list", "-n", "1", tag).strip()


def tree(commit):
    files = {}
    for line in upstream("ls-tree", "-r", commit).splitlines():
        info, path = line.split("\t", 1)
        mode, kind, blob = info.split()
        if kind == "blob":
            files[path] = {"blob": blob, "mode": mode}
    return files


def write_file(path, blob, mode):
    full = REPO / path
    full.parent.mkdir(parents=True, exist_ok=True)
    if mode == "120000":
        target = upstream("cat-file", "blob", blob)
        if full.is_symlink() or full.exists():
            full.unlink()
        full.symlink_to(target)
        return
    full.write_bytes(upstream("cat-file", "blob", blob, binary=True))
    full.chmod(0o755 if mode == "100755" else 0o644)


def cmd_update(tag):
    rules = load_rules()
    meta, entries = read_lock()
    old_commit = meta.get("commit")
    commit = fetch(tag)
    files = tree(commit)
    wanted = {p: f for p, f in files.items() if selected(p, rules)}

    report = {"added": [], "updated": [], "removed": [], "merge": [], "dirty": []}

    for path, f in sorted(wanted.items()):
        entry = entries.get(path)
        if entry is None:
            write_file(path, f["blob"], f["mode"])
            entries[path] = {"blob": f["blob"], "mode": f["mode"], "status": "vendored"}
            report["added"].append(path)
            continue
        if entry["blob"] == f["blob"]:
            continue
        if entry["status"] == "override":
            report["merge"].append(path)
            continue
        if local_blob(path) not in (entry["blob"], None):
            report["dirty"].append(path)
            continue
        write_file(path, f["blob"], f["mode"])
        entries[path] = {"blob": f["blob"], "mode": f["mode"], "status": "vendored"}
        report["updated"].append(path)

    for path in sorted(set(entries) - set(wanted)):
        entry = entries[path]
        if entry["status"] == "override":
            report["merge"].append(path + " (no longer selected or removed upstream)")
            continue
        if local_blob(path) == entry["blob"]:
            (REPO / path).unlink(missing_ok=True)
        del entries[path]
        report["removed"].append(path)

    # Override entries keep the blob of the tag they were last merged against,
    # so upstream-diff can show what changed since then.
    meta.update({"upstream": UPSTREAM_URL, "tag": tag, "commit": commit})
    if old_commit and old_commit != commit:
        meta["previous-commit"] = old_commit
    write_lock(meta, entries)

    print(f"vendor-sync: {tag} ({commit[:12]}), {len(entries)} files locked")
    for key, label in [("added", "added"), ("updated", "updated"), ("removed", "removed"),
                       ("merge", "overrides to merge by hand"),
                       ("dirty", "locally edited but not marked override (left unchanged)")]:
        if report[key]:
            print(f"\n{label} ({len(report[key])}):")
            for path in report[key]:
                print(f"  {path}")
    if report["dirty"]:
        sys.exit(2)


def cmd_status():
    meta, entries = read_lock()
    if not entries:
        die("no lock yet; run: tools/vendor-sync update <tag>")
    missing, edited, overrides = [], [], []
    for path, e in sorted(entries.items()):
        blob = local_blob(path) if e["mode"] != "120000" else e["blob"]
        if blob is None:
            missing.append(path)
        elif e["status"] == "override":
            overrides.append(path)
        elif blob != e["blob"]:
            edited.append(path)
    print(f"upstream {meta.get('tag')} ({meta.get('commit', '')[:12]}): {len(entries)} files, "
          f"{len(overrides)} overrides")
    for label, items in [("missing", missing), ("edited without override", edited), ("overrides", overrides)]:
        if items:
            print(f"\n{label} ({len(items)}):")
            for path in items:
                print(f"  {path}")
    sys.exit(1 if missing or edited else 0)


def set_status(paths, status):
    meta, entries = read_lock()
    for path in paths:
        if path not in entries:
            die(f"{path} is not vendored")
        entries[path]["status"] = status
    write_lock(meta, entries)
    for path in paths:
        print(f"{path}: {status}")


def cmd_merged(paths):
    meta, entries = read_lock()
    fetch(meta["tag"])
    files = tree(meta["commit"])
    for path in paths:
        if path not in entries or entries[path]["status"] != "override":
            die(f"{path} is not an override")
        if path in files:
            entries[path]["blob"] = files[path]["blob"]
    write_lock(meta, entries)
    for path in paths:
        print(f"{path}: merged against {meta['tag']}")


def cmd_upstream_diff(path):
    meta, entries = read_lock()
    entry = entries.get(path) or die(f"{path} is not vendored")
    tag = meta["tag"]
    fetch(tag)
    current = tree(meta["commit"]).get(path)
    if current is None:
        print(f"{path} no longer exists upstream at {tag}")
        return
    if current["blob"] == entry["blob"]:
        print(f"{path}: no upstream change since it was last merged")
        return
    subprocess.run(["git", "--git-dir", str(CACHE), "diff", entry["blob"], current["blob"]])


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    command, args = argv[1], argv[2:]
    if command == "update" and len(args) == 1:
        cmd_update(args[0])
    elif command == "status" and not args:
        cmd_status()
    elif command == "override" and args:
        set_status(args, "override")
    elif command == "unoverride" and args:
        set_status(args, "vendored")
    elif command == "merged" and args:
        cmd_merged(args)
    elif command == "upstream-diff" and len(args) == 1:
        cmd_upstream_diff(args[0])
    else:
        die("bad arguments; see tools/vendor-sync --help")


if __name__ == "__main__":
    main(sys.argv)
