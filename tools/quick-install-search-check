#!/usr/bin/env node

// Checks the Quick install window's search and its headings against the real list
// (default/karchy/quick-install.json), and the sentence its bar says about
// the last install. Run it from anywhere, with node or bun:
// tools/quick-install-search-check

"use strict"

const assert = require("node:assert/strict")
const fs = require("node:fs")
const path = require("node:path")
const root = path.join(__dirname, "..")
const Search = require(path.join(root, "shell", "plugins", "quick-install", "Search.js"))
const Model = require(path.join(root, "shell", "plugins", "quick-install", "Model.js"))
const catalog = JSON.parse(fs.readFileSync(path.join(root, "default", "karchy", "quick-install.json"), "utf8"))
const apps = catalog.apps

const checks = []
function check(name, fn) {
  checks.push([name, fn])
}

function names(query, count) {
  return Search.search(apps, query).slice(0, count).map((r) => r.app.name)
}

function rank(query, name) {
  return Search.search(apps, query).findIndex((r) => r.app.name === name)
}

const fake = (name, extra) => Object.assign({ id: name.toLowerCase(), name: name, description: "", packages: [] }, extra || {})

check("an empty query keeps every app", () => {
  assert.equal(Search.search(apps, "").length, apps.length)
  assert.equal(Search.search(apps, "   ").length, apps.length)
})

check("tiers: start > word start > substring > subsequence > other text", () => {
  const list = [
    fake("Xobs Thing"),                 // substring
    fake("Hobs Obs"),                   // word start
    fake("Ocean Bus Stop"),             // subsequence
    fake("Plain", { description: "obs plugin" }),
    fake("Obsidian")                    // start
  ]
  assert.deepEqual(Search.search(list, "obs").map((r) => r.app.name),
    ["Obsidian", "Hobs Obs", "Xobs Thing", "Ocean Bus Stop", "Plain"])
})

check("obs: OBS Studio and Obsidian above names that only hold o-b-s", () => {
  const top = names("obs", 2).sort()
  assert.deepEqual(top, ["OBS Studio", "Obsidian"])
})

check("vsc finds VSCodium first", () => {
  assert.equal(names("vsc", 1)[0], "VSCodium")
})

check("vs code (with a space) still finds VSCodium", () => {
  assert.ok(rank("vs code", "VSCodium") >= 0)
})

// Names that contain "ff" (Ruff, Kaffeine, OnlyOffice) would rank above its
// letters in Firefox; Firefox has "ff" as a keyword, which people type for it.
check("ff finds Firefox first", () => {
  assert.equal(names("ff", 1)[0], "Firefox", names("ff", 5).join(", "))
})

// A keyword match marks the name only where the name's own letters match:
// never letters that aren't the query's, in order.
check("a keyword match highlights only the name's own letters", () => {
  const ff = Search.search(apps, "ff")[0]
  assert.deepEqual(ff.positions, [0, 4]) // F and f of Firefox
  assert.deepEqual(Search.search(apps, "npm")[0].positions, []) // Node.js
  for (const app of apps) {
    for (const word of (app.keywords || []).concat(app.packages || [], [app.id])) {
      const q = word.toLowerCase()
      const m = Search.match(app, q)
      if (m.tier !== 4.5) continue
      const marked = m.positions.map((i) => app.name.charAt(i).toLowerCase()).join("").replace(/\s+/g, "")
      assert.ok(marked === "" || marked === q.replace(/\s+/g, ""), app.name + " for " + q + ": " + marked)
    }
  }
})

check("word starts beat scattered letters: kpx finds KeePassXC", () => {
  assert.equal(names("kpx", 1)[0], "KeePassXC")
})

check("keywords, packages and descriptions are searched", () => {
  assert.ok(rank("podman", "Containers") >= 0)
  assert.ok(rank("vscodium-bin", "VSCodium") >= 0)
  assert.ok(rank("redis", "Valkey") >= 0)
})

check("a whole keyword or package name beats letters inside other names", () => {
  // "adb" is inside MariaDB; the app people mean lists it as a keyword.
  assert.equal(names("adb", 1)[0], "Android platform tools")
  assert.equal(names("fastboot", 1)[0], "Android platform tools")
  assert.equal(rank("npm", "Node.js"), 0)
  // A name that starts with the query still comes first.
  assert.equal(names("go", 1)[0], "Go")
})

check("a word people type finds the apps of that kind, before chance letters", () => {
  // The word in keywords or the description outranks its letters scattered
  // through a name: ssh was Sched-ext schedulers, dj was Deja Dup. SSHFS
  // has it at the start of its name, which still comes first.
  assert.equal(names("ssh", 1)[0], "SSHFS")
  assert.ok(rank("ssh", "PuTTY") < rank("ssh", "Sched-ext schedulers"))
  assert.ok(rank("ssh", "PuTTY") < 4)
  assert.equal(names("dj", 1)[0], "Mixxx")
  assert.equal(names("vnc", 1)[0], "Remmina")
  assert.ok(names("excel", 4).includes("LibreOffice"))
  assert.equal(names("excel", 20).pop(), "Sched-ext schedulers")
  // A kind of app, in two words or while still typing the second.
  assert.ok(names("video editor", 4).includes("Kdenlive"))
  assert.ok(names("video edit", 4).includes("Kdenlive"))
  assert.ok(names("screen rec", 3).includes("OBS Studio"))
  assert.ok(names("pdf reader", 5).includes("Okular"))
  assert.ok(names("password manager", 5).includes("KeePassXC"))
  // An exact keyword before a name that only has the word inside it.
  assert.ok(rank("vm", "Virtual machines") < rank("vm", "ScummVM"))
  // A whole word before the start of another: Java before JavaScript.
  assert.deepEqual(names("java", 2), ["Java", "Java (latest)"])
  // An abbreviation of the name's words still beats words in descriptions.
  assert.equal(names("kpx", 1)[0], "KeePassXC")
})

check("everyday words all find something", () => {
  const kinds = ["terminal", "torrent", "vpn", "pdf", "email", "music", "screenshot", "backup", "password",
    "spreadsheet", "photo", "notes", "python", "ftp", "remote desktop", "virtual machine", "emulator", "rgb",
    "printer", "calculator", "ebook", "file manager", "partition", "bootable usb", "app store", "llm",
    "kubernetes", "sql", "diff", "firewall", "antivirus", "2fa", "gpg", "cloud storage", "irc", "video call",
    "photoshop", "cad", "daw", "burn", "color picker", "wallpaper", "ide", "docker", "git", "text editor",
    "video player", "image viewer", "screen recorder", "fan control", "task manager", "browser"]
  const none = kinds.filter((q) => Search.search(apps, q).length === 0)
  assert.deepEqual(none, [])
})

check("the bar says what the last install did, never Done after a failure", () => {
  const run = (states, verb) => Model.runText(states.map((s, i) => ({ name: "App" + i, state: s })), verb || "install")
  assert.equal(run(["done"]), "App0 installed.")
  assert.equal(run(["cancelled"]), "Nothing was changed.")
  assert.equal(run(["terminal"]), "App0 continues in a terminal.")
  assert.match(run(["failed"]), /^App0 failed\./)
  assert.match(run(["done", "done", "failed"]), /^2 installed and 1 failed\./)
  assert.equal(run(["done", "cancelled"], "remove"), "1 removed and 1 not removed.")
  assert.equal(run([]), "")
})

check("the size line says what its figures cover", () => {
  assert.equal(Model.sizeText({ download: "139 MiB", installed: "1.1 GiB", count: 130 }, false, false),
    "139 MiB download, 1.1 GiB installed, 130 packages with what it needs")
  assert.equal(Model.sizeText({ installed: "23 MiB" }, false, false), "23 MiB installed")
  // The 32-bit repository is still off: the app alone, said as that, or no figure.
  assert.match(Model.sizeText({ download: "30 MiB", installed: "110 MiB", alone: "lutris" }, false, true),
    /^30 MiB download, 110 MiB installed for lutris alone; the 32-bit packages/)
  assert.match(Model.sizeText({}, false, true), /^Counted once Arch's 32-bit repository is on/)
  assert.equal(Model.sizeText({}, false, false), "")
})

check("an AUR app says which of its packages are built here", () => {
  const droidcam = apps.find((a) => a.id === "droidcam")
  const text = Model.installsText(droidcam, {})
  assert.ok(text.indexOf("droidcam, v4l2loopback-dc-dkms from the AUR") === 0)
  assert.ok(/with android-tools, .*linux-cachyos-headers.* from the package repositories$/.test(text))
})

check("case is ignored", () => {
  assert.deepEqual(names("FIREFOX", 1), names("firefox", 1))
})

check("matched letters are the ones highlighted", () => {
  const firefox = apps.find((a) => a.id === "firefox")
  assert.deepEqual(Search.match(firefox, "fox").positions, [4, 5, 6])
  assert.deepEqual(Search.match(firefox, "ff").positions, [0, 4])
  assert.equal(Search.highlighted("A<b", [0], "#fff"), '<u><font color="#fff">A</font></u>&lt;b')
})

check("no match is no result", () => {
  assert.equal(Search.search(apps, "zzzzqqq").length, 0)
})

// The list under headings (D-158): the headings of a list, in its order,
// and whether rows that share one are always next to each other.
const headings = (rows) => rows.map((r) => r.section).filter((s, i, all) => i === 0 || all[i - 1] !== s)
const together = (rows) => new Set(headings(rows)).size === headings(rows).length

check("a category lists its apps by what they are for, by name under each heading", () => {
  const ai = Model.rows(catalog, apps, "ai", {}, null)
  assert.deepEqual(headings(ai), ["Coding agents", "Chat apps", "Run models on this computer"])
  assert.equal(ai[0].app.name, "Amp")
  assert.ok(ai.findIndex((r) => r.app.id === "pi-coding-agent") < ai.findIndex((r) => r.app.id === "claude-desktop"))
  for (const category of catalog.categories) {
    const rows = Model.rows(catalog, apps, category.id, {}, null)
    const own = apps.filter((a) => a.category === category.id)
    assert.equal(rows.length, own.length, category.id)
    assert.deepEqual(rows.map((r) => r.app.id).sort(), own.map((a) => a.id).sort(), category.id)
    assert.deepEqual(headings(rows), (category.groups || [{ name: "" }]).map((g) => g.name), category.id)
    assert.ok(together(rows), category.id)
    const counts = Model.sectionCounts(rows)
    for (const group of category.groups || []) {
      const names = rows.filter((r) => r.section === group.name).map((r) => r.app.name.toLowerCase())
      assert.deepEqual(names, names.slice().sort(), category.id + " › " + group.name)
      assert.equal(counts[group.name], names.length)
    }
  }
})

check("All, Installed and Picked keep the list's order, under the categories' names", () => {
  const all = Model.rows(catalog, apps, "all", {}, null)
  assert.deepEqual(all.map((r) => r.app.id), apps.map((a) => a.id))
  assert.deepEqual(headings(all), catalog.categories.map((c) => c.name))
  const installed = Model.rows(catalog, apps, "installed", { vlc: "vlc.desktop", "pi-coding-agent": "", mpv: "mpv.desktop" }, null)
  assert.deepEqual(installed.map((r) => r.app.name + " under " + r.section),
    ["mpv under Media & creative", "VLC under Media & creative", "Pi under AI"])
  const picked = Model.rows(catalog, apps, "picked", {}, { zed: true, firefox: true })
  assert.deepEqual(picked.map((r) => r.app.name + " under " + r.section), ["Firefox under Browsers", "Zed under Editors & IDEs"])
  assert.deepEqual(Model.sectionCounts(installed), { "Media & creative": 2, AI: 1 })
})

check("an app outside its category's groups still shows, last", () => {
  const made = { categories: [{ id: "x", name: "X", groups: [{ id: "a", name: "First" }, { id: "b", name: "Second" }] }] }
  const list = [fake("Stray", { category: "x" }), fake("Two", { category: "x", group: "b" }), fake("One", { category: "x", group: "a" })]
  assert.deepEqual(Model.rows(made, list, "x", {}, null).map((r) => r.app.name + " under " + r.section),
    ["One under First", "Two under Second", "Stray under Other"])
})

let failed = 0
for (const [name, fn] of checks) {
  try {
    fn()
    console.log("ok   " + name)
  } catch (error) {
    failed++
    console.log("FAIL " + name + "\n     " + String(error.message).split("\n").join("\n     "))
  }
}
console.log(checks.length - failed + "/" + checks.length + " checks passed")
process.exit(failed ? 1 : 0)
