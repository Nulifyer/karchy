#!/usr/bin/env python3
"""Check that icons come from the icon map (docs/architecture.md, "Shell design foundations").

Usage:
  tools/icon-check            Check the working tree; exit 1 on any problem

default/karchy/icons.json is the only place a glyph codepoint may appear, and
an icon is drawn in the icon font (Icons.family), never in the text font, so
it looks the same whichever font is chosen in Settings › Fonts.
This fails on:
  - a private-use character (a Nerd Font glyph), or an escape for one, in the
    shell's QML and JS, JSON and JSONC, Lua and the bash commands, outside the
    map
  - a map entry that breaks the family rule: every name outside brand.* is a
    Material Design icon (nf "md-*", U+F0001-U+F1AF0). The name in
    SINGLE_UNIT is the one more exception: TextInput.passwordCharacter takes
    one UTF-16 unit, a Material Design glyph takes two, so the password dot
    is a Nerd Font glyph of U+E000-F8FF
  - a password field that draws its own dots: the shell's QML masks what is
    typed only through Ui/PasswordDots (the dot's glyph, size and spacing in
    one place, D-169), so a file that sets echoMode to Password or names a
    passwordCharacter holds a PasswordDots, and nothing else uses the dot's
    name
  - an icon name used in code that the map doesn't have: Icons.glyph("x"),
    "iconName": "x", karchy-icon x and karchy-notification-send -g x
  - a symbol written as a character in the shell's QML and JS (shell/,
    addons/), outside comments: an arrow, a geometric shape, a technical or
    miscellaneous symbol, a dingbat, a braille pattern, a box or block
    character (SYMBOL_RANGES), or an escape for one. It would be drawn in the
    text font and change with it; use an icon from the map, or words.
    Punctuation (… · › ‹ — – “ ” × ° •) is not in those ranges and stays
    text; a chevron that stands for "opens" or "back" is ui.chevron.*
  - Icons.glyph(...) or Icons.resolve(...) joined to other text with + in
    that QML and JS: the whole string is drawn in one font, so the glyph
    would be drawn in the text font. Give the glyph its own Text in
    Icons.family. The files in JOIN_EXEMPT may, each for the reason given
Names built at run time ("net.wifi." + level) aren't checked here; the shell
warns about unknown names when it draws them. The join check reads one
expression at a time: a glyph joined through a variable or a conditional
passes it.
"""

import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MAP = "default/karchy/icons.json"
NAME = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z0-9-]+)*$")
MD_RANGE = (0xF0001, 0xF1AF0)
# The name that must be one UTF-16 unit, so can't be Material Design: the dot a
# password field shows for each character (TextInput.passwordCharacter).
SINGLE_UNIT = {"ui.password-dot"}
SINGLE_UNIT_RANGE = (0xE000, 0xF8FF)
# The one component that knows the dot, and what makes a file a masked field.
PASSWORD_DOTS = "shell/Ui/PasswordDots.qml"
PASSWORD_DOT_NAME = re.compile(r"""["']ui\.password-dot["']""")
MASKS = re.compile(r"\bTextInput\.Password\b|\bpasswordCharacter\s*:")
USES_PASSWORD_DOTS = re.compile(r"\bPasswordDots\s*\{")

# Symbols a text font draws its own way, so they change with the font:
# Arrows; Miscellaneous Technical; Box Drawing, Block Elements and Geometric
# Shapes; Miscellaneous Symbols and Dingbats; Braille Patterns; Miscellaneous
# Symbols and Arrows.
SYMBOL_RANGES = (
    (0x2190, 0x21FF), (0x2300, 0x23FF), (0x2500, 0x25FF), (0x2600, 0x27BF),
    (0x2800, 0x28FF), (0x2B00, 0x2BFF),
)
# Where the shell's QML and JS live.
SHELL_DIRS = ("shell/", "addons/")
# Files that may join a glyph to text, and why.
JOIN_EXEMPT = {
    "shell/plugins/settings/FontPicker.qml":
        "the font sample: a line of text with icons in it, to show how the chosen font sets them",
}
GLYPH_CALL = re.compile(r"\bIcons\.(?:glyph|resolve)\(")

# Text files that can carry a glyph: the shell, data and Lua by extension,
# commands by their place.
EXTENSIONS = (".qml", ".js", ".json", ".jsonc", ".lua", ".sh")
SCRIPT_DIRS = ("bin/", "install/", "migrations/", "tools/", "default/")

ESCAPES = re.compile(
    r"\\u\{([0-9a-fA-F]{4,6})\}"          # JS \u{f0001}
    r"|\\U([0-9a-fA-F]{8})"               # bash $'\U000f0001'
    r"|\\u([0-9a-fA-F]{4})"               # \ue900, or half of a surrogate pair
    r"|&#x([0-9a-fA-F]{4,6});"
)
USES = [
    re.compile(r"""Icons\.(?:glyph|has)\(\s*["']([^"']+)["']"""),
    re.compile(r""""iconName"\s*:\s*"([^"]*)\""""),
    re.compile(r"""\biconName\s*:\s*["']([^"']+)["']"""),
    re.compile(r"""karchy-icon\s+["']?([a-z][a-z0-9.-]*)"""),
    re.compile(r"""karchy-notification-send\b[^\n]*?\s(?:-g|--glyph)[ =]["']?([a-z][a-z0-9.-]*)"""),
]


def private_use(cp):
    return 0xE000 <= cp <= 0xF8FF or 0xF0000 <= cp <= 0xFFFFD or 0x100000 <= cp <= 0x10FFFD


def symbol(cp):
    return any(low <= cp <= high for low, high in SYMBOL_RANGES)


def shell_code(rel):
    return rel.startswith(SHELL_DIRS) and rel.endswith((".qml", ".js"))


def without_comments(text):
    """QML or JS with its comments blanked, line for line; strings stay.

    Not a parser: a regular expression literal that holds a quote or two
    slashes is read as a string or a comment to the end of its line.
    """
    out = []
    i, n = 0, len(text)
    quote = ""
    while i < n:
        ch = text[i]
        two = text[i:i + 2]
        if quote:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if ch == quote or (ch == "\n" and quote != "`"):
                quote = ""
        elif two == "//":
            end = text.find("\n", i)
            end = n if end == -1 else end
            out.append(" " * (end - i))
            i = end
            continue
        elif two == "/*":
            end = text.find("*/", i + 2)
            end = n if end == -1 else end + 2
            out.append("".join("\n" if c == "\n" else " " for c in text[i:end]))
            i = end
            continue
        else:
            out.append(ch)
            if ch in "\"'`":
                quote = ch
        i += 1
    return "".join(out)


def closing_paren(text, start):
    """The index of the ")" that closes the "(" at start - 1, or -1."""
    depth = 1
    quote = ""
    i = start
    while i < len(text):
        ch = text[i]
        if quote:
            if ch == "\\":
                i += 1
            elif ch == quote:
                quote = ""
        elif ch in "\"'`":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return -1


def check_shell_code(rel, text, problems):
    code = without_comments(text)
    for number, line in enumerate(code.split("\n"), 1):
        found = [ord(ch) for ch in line if symbol(ord(ch))]
        for m in ESCAPES.finditer(line):
            cp = int(next(g for g in m.groups() if g), 16)
            if symbol(cp):
                found.append(cp)
        for cp in found:
            problems.append(
                f"{rel}:{number}: U+{cp:04X} ({chr(cp)}) is drawn in the text font and changes with it;"
                f" use an icon from {MAP} in Icons.family, or words")
    if rel != PASSWORD_DOTS:
        for m in PASSWORD_DOT_NAME.finditer(code):
            number = code.count("\n", 0, m.start()) + 1
            problems.append(
                f"{rel}:{number}: the password dot belongs to Ui/PasswordDots;"
                " a field takes its glyph, size and spacing from there")
        m = MASKS.search(code)
        if m and not USES_PASSWORD_DOTS.search(code):
            number = code.count("\n", 0, m.start()) + 1
            problems.append(
                f"{rel}:{number}: a field that hides what is typed without Ui/PasswordDots;"
                " its dots would not follow the rule every password field shares")
    if rel in JOIN_EXEMPT:
        return
    for m in GLYPH_CALL.finditer(code):
        end = closing_paren(code, m.end())
        before = code[:m.start()].rstrip()
        after = code[end + 1:].lstrip() if end != -1 else ""
        joined = (before.endswith("+") and not before.endswith("++")) or \
            (after.startswith("+") and not after.startswith(("++", "+=")))
        if joined:
            number = code.count("\n", 0, m.start()) + 1
            problems.append(
                f"{rel}:{number}: an icon joined to text with +: the text font would draw it;"
                " give the glyph its own Text in Icons.family")


def tracked_files():
    out = subprocess.run(
        ["git", "-C", ROOT, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        check=True, capture_output=True,
    ).stdout.decode()
    for rel in out.split("\0"):
        if rel and os.path.isfile(os.path.join(ROOT, rel)):
            yield rel


def scanned(rel):
    if rel == MAP:
        return False
    if rel.endswith(EXTENSIONS):
        return True
    if not rel.startswith(SCRIPT_DIRS) or "." in os.path.basename(rel):
        return False
    try:
        with open(os.path.join(ROOT, rel), "rb") as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b"#!") and b"sh" in first


def check_map(problems):
    with open(os.path.join(ROOT, MAP), encoding="utf-8") as f:
        entries = json.load(f)
    for name, entry in entries.items():
        where = f"{MAP}: {name}"
        if not NAME.match(name):
            problems.append(f"{where}: names are lowercase words joined by dots")
        try:
            cp = int(entry["cp"], 16)
        except (KeyError, TypeError, ValueError):
            problems.append(f"{where}: needs \"cp\", a hex codepoint")
            continue
        nf = str(entry.get("nf", ""))
        if not nf:
            problems.append(f"{where}: needs \"nf\", the Nerd Font glyph name")
        if not private_use(cp):
            problems.append(f"{where}: U+{cp:04X} is not a Nerd Font glyph")
        if name in SINGLE_UNIT:
            if not SINGLE_UNIT_RANGE[0] <= cp <= SINGLE_UNIT_RANGE[1]:
                problems.append(f"{where}: must be one UTF-16 unit, U+E000-F8FF ({nf}, U+{cp:04X})")
        elif not name.startswith("brand.") and (
            not nf.startswith("md-") or not MD_RANGE[0] <= cp <= MD_RANGE[1]
        ):
            problems.append(f"{where}: only brand.* names may leave Material Design ({nf}, U+{cp:04X})")
    return set(entries)


def check_file(rel, names, problems):
    try:
        with open(os.path.join(ROOT, rel), encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        return
    if shell_code(rel):
        check_shell_code(rel, text, problems)
    lines = text.split("\n")
    for number, line in enumerate(lines, 1):
        found = [ord(ch) for ch in line if private_use(ord(ch))]
        for m in ESCAPES.finditer(line):
            cp = int(next(g for g in m.groups() if g), 16)
            if private_use(cp) or 0xD800 <= cp <= 0xDBFF:
                found.append(cp)
        for cp in found:
            problems.append(f"{rel}:{number}: U+{cp:04X} outside the icon map; use a name from {MAP}")
        for pattern in USES:
            for m in pattern.finditer(line):
                if m.group(1) not in names:
                    problems.append(f"{rel}:{number}: no icon named \"{m.group(1)}\" in {MAP}")


def main():
    if len(sys.argv) > 1:
        print(__doc__.strip())
        return 0 if sys.argv[1] in ("-h", "--help") else 2
    problems = []
    names = check_map(problems)
    files = [rel for rel in tracked_files() if scanned(rel)]
    for rel in files:
        check_file(rel, names, problems)
    for p in problems:
        print(p)
    print(f"icon-check: {len(names)} icons, {len(files)} files, {len(problems)} problems", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
