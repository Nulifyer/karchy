  "list --json") cat <<'J'
[{"name":"arch","state":"running","pid":4242,"cpu_seconds":120.5,"mem_used":2400000000,"disk_size":68719476736,"disk_used":9800000000,"os":"linux","ram":"4G","cpus":2,"disk_bus":"virtio","nic":"virtio","net":"user","uefi":"yes","secureboot":"no","tpm":"no","iso":"/home/u/Downloads/archlinux-2026.11.01-x86_64.iso","display":"virtio","gl":"on","audio":"spice","path":"/home/u/VMs/arch"},
{"name":"win11","state":"stopped","pid":0,"cpu_seconds":0,"mem_used":0,"disk_size":137438953472,"disk_used":41000000000,"os":"windows","ram":"8G","cpus":4,"disk_bus":"sata","nic":"e1000e","net":"user","uefi":"yes","secureboot":"yes","tpm":"yes","iso":"","display":"qxl","gl":"off","audio":"spice","path":"/home/u/VMs/win11"},
{"name":"debian-testing-server","state":"stopped","pid":0,"cpu_seconds":0,"mem_used":0,"disk_size":34359738368,"disk_used":3100000000,"os":"linux","ram":"2G","cpus":1,"disk_bus":"virtio","nic":"virtio","net":"user","uefi":"yes","secureboot":"no","tpm":"no","iso":"","display":"virtio","gl":"on","audio":"none","path":"/home/u/VMs/debian-testing-server"}]
J
  ;;
  "snapshot list") echo '[{"name":"clean-install","date":1763900000,"size":0},{"name":"before-update","date":1763990000,"size":0}]' ;;
