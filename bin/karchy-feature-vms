#!/bin/bash

# karchy:summary=Add or remove virtual machines (Quick install › System features, D-63)
# karchy:args=status | install | remove
# karchy:hidden=true

# install: QEMU/KVM with UEFI firmware, a software TPM and the SPICE viewer, so
# `karchy vm` and the VMs panel can create and run VMs. No libvirt. Arch's
# systemd gives /dev/kvm mode 0666, so no group is needed unless this machine
# says otherwise. VMs live in ~/VMs, marked no-copy-on-write on btrfs so disk
# images don't fragment. Remove takes the packages away and keeps ~/VMs.

set -euo pipefail

PACKAGES=(qemu-desktop edk2-ovmf swtpm spice-gtk)
VM_ROOT=${KARCHY_VM_ROOT:-$HOME/VMs}

status() {
  if pacman -Q qemu-desktop edk2-ovmf swtpm spice-gtk >/dev/null 2>&1; then
    echo installed
  else
    echo available
  fi
}

install_feature() {
  echo "Adding virtual machines: ${PACKAGES[*]}"
  sudo pacman --color auto -S --needed --noconfirm "${PACKAGES[@]}"
  # The ISO chooser asks the desktop portal through Python's GLib bindings.
  # A dependency, so removing VMs leaves it to whatever else uses it.
  pacman -Q python-gobject >/dev/null 2>&1 || sudo pacman --color auto -S --needed --noconfirm --asdeps python-gobject

  if [[ ! -e /dev/kvm ]]; then
    echo "Note: /dev/kvm is missing. Turn on virtualization (Intel VT-x or AMD-V) in the firmware settings."
  elif [[ ! -w /dev/kvm ]]; then
    # Only when this machine's udev rules don't open /dev/kvm to everyone.
    echo "Giving $USER access to /dev/kvm through the kvm group (takes effect at the next login)."
    sudo gpasswd -a "$USER" kvm
  fi

  if [[ ! -d $VM_ROOT ]]; then
    mkdir -p "$VM_ROOT"
    if [[ $(stat -f -c %T "$VM_ROOT") == btrfs ]]; then
      chattr +C "$VM_ROOT" && echo "Made $VM_ROOT no-copy-on-write (btrfs) for disk images."
    fi
  fi

  karchy-shell -q karchy.vms refresh
  karchy-notification-send -g vms "Virtual machines added" "Create one from the VMs window: karchy vm manage" 2>/dev/null || true
  echo "Done."
}

remove_feature() {
  echo "Removing virtual machines."
  if command -v karchy-vm >/dev/null && karchy-vm list --json 2>/dev/null | jq -e 'any(.[]; .state != "stopped")' >/dev/null; then
    echo "A VM is still running. Stop it first (karchy vm list shows which). Nothing was changed."
    exit 1
  fi
  local installed=()
  mapfile -t installed < <(pacman -Qq "${PACKAGES[@]}" 2>/dev/null)
  # Check first that pacman can remove them all, so a refusal leaves VMs as they were.
  if ((${#installed[@]} > 0)) && ! pacman -Rs --print "${installed[@]}" >/dev/null 2>&1; then
    echo "Another installed package needs part of this:"
    pacman -Rs --print "${installed[@]}" 2>&1 | grep -i "required by\|breaks dependency" || true
    echo "Remove that package first, then try again. Nothing was changed."
    exit 1
  fi
  ((${#installed[@]} == 0)) || sudo pacman --color auto -Rns --noconfirm "${installed[@]}"
  [[ -d $VM_ROOT ]] && echo "Your VMs stay in $VM_ROOT; delete that folder yourself if you don't need them."
  karchy-shell -q karchy.vms refresh
  karchy-notification-send -g vms "Virtual machines removed" 2>/dev/null || true
  echo "Done."
}

case "${1:-}" in
  status) status ;;
  install) install_feature ;;
  remove) remove_feature ;;
  *) sed -n 's/^# karchy:args=/Usage: karchy-feature-vms /p' "$0" >&2; exit 1 ;;
esac
