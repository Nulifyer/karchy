#!/bin/bash

# karchy:summary=Copy text to the clipboard and type or paste it
# karchy:group=clipboard
# karchy:args=[--paste] [--copy-only] <text>
# karchy:examples=karchy clipboard paste text "hello" | karchy clipboard paste text --paste "hello"
# karchy:hidden=true

# Without options the text is copied and typed into the focused window key by
# key. --paste pastes it instead (Ctrl+V, or Ctrl+Shift+V in a terminal),
# which is faster and right for long or multi-line text. --copy-only stops
# after copying.

paste=false
copy_only=false

while (( $# > 0 )); do
  case "$1" in
    --paste | --shift-insert)
      paste=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

text=${1:-}
[[ -n $text ]] || exit
printf '%s' "$text" | wl-copy

if [[ $copy_only == "true" ]]; then
  exit
fi

if [[ $paste == "true" ]]; then
  karchy-clipboard-paste-keys
else
  sleep 0.15
  wtype "$text" 2>/dev/null || true
fi
