#!/bin/bash

# karchy:summary=Send the low battery warning notification and run battery-low hooks.
# karchy:args=<percentage>
# karchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: karchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

karchy-notification-send -g power.battery.low -u normal "$(karchy-i18n battery.lowTitle)" "$(karchy-i18n battery.lowBody "$level")" -i battery-caution -t 30000
karchy-hook battery-low "$level"
