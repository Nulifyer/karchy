#!/bin/bash

# karchy:summary=Open LocalSend's, KDE Connect's and the media servers' ports only while a trusted network is connected (D-33)
# karchy:args=[status]
# karchy:hidden=true

# Run as root by NetworkManager's dispatcher on every connection change, by
# karchy-trusted-networks after the list changes, by Quick install after it
# installs or removes one of the apps, and once at boot before NetworkManager
# starts (karchy-localsend-firewall.service), which closes the ports
# everywhere. Whether a connection is trusted comes from
# `karchy-trusted-networks status --json`: the profile and its router must
# both match what was trusted (D-68).

set -euo pipefail

# The apps karchy opens ports for: "<id> <ports> <protocols> <installed>",
# where <installed> is a file the app's package installs. One port takes both
# protocols in one ufw rule ("any"); a range needs a rule per protocol. The
# ports of KDE Connect and the media servers open only while the app is
# installed; LocalSend ships with karchy and its port keeps the behaviour it
# had. The media servers get only the port their clients connect to (D-166):
# Jellyfin's HTTP port, not HTTPS (off until a certificate is set up) or the
# client discovery port; Plex's one required port, not DLNA, GDM discovery,
# Bonjour or Roku's companion port.
APPS=(
  "localsend 53317 any -"
  "kdeconnect 1714:1764 tcp,udp /usr/bin/kdeconnectd"
  "jellyfin 8096 tcp /usr/lib/systemd/system/jellyfin.service"
  "plex 32400 tcp /usr/lib/systemd/system/plexmediaserver.service"
)
# What this script opened last, for Settings (`status`): "<id> <device>" lines.
STATE=/run/karchy/firewall-open

# For anyone (Settings › Network › Sharing and firewall): whether ufw is on
# and refuses incoming connections, and where the ports are open now. ufw's
# own rule list needs root; karchy opens only these ports, and records where.
if [[ ${1:-} == "status" ]]; then
  enabled=$(sed -n 's/^ENABLED=//p' /etc/ufw/ufw.conf 2>/dev/null | head -n 1)
  policy=$(sed -n 's/^DEFAULT_INPUT_POLICY="\{0,1\}\([A-Z]*\)"\{0,1\}$/\1/p' /etc/default/ufw 2>/dev/null | head -n 1)
  apps=$(for app in "${APPS[@]}"; do
    read -r id ports _ program <<<"$app"
    [[ $program == - ]] && program=/usr/bin/$id
    [[ -e $program ]] && installed=true || installed=false
    jq -n --arg id "$id" --arg ports "$ports" --argjson installed "$installed" \
      --arg open "$(sed -n "s/^$id //p" "$STATE" 2>/dev/null || true)" \
      '{id: $id, ports: $ports, installed: $installed, open_on: ($open | split("\n") | map(select(length > 0)))}'
  done | jq -s .)
  jq -n --arg active "$(systemctl is-active ufw.service 2>/dev/null || true)" --arg enabled "$enabled" \
    --arg policy "$policy" --argjson apps "$apps" '{
      firewall: ($active == "active" and $enabled == "yes"),
      incoming: ($policy | ascii_downcase),
      localsend_installed: ($apps[0].installed),
      port: ($apps[0].ports | tonumber),
      open_on: $apps[0].open_on,
      apps: $apps
    }'
  exit 0
fi

(( EUID == 0 )) || { echo "karchy-localsend-firewall: run as root" >&2; exit 1; }

# The ports open only on the interfaces of trusted connections, never on a
# VPN, tether or second network that is up at the same time.
# Before NetworkManager runs (at boot) nothing is connected, so nothing is
# trusted; asking nmcli then could only wait on a daemon that isn't there.
trusted=()
if systemctl is-active --quiet NetworkManager.service; then
  while IFS= read -r device; do
    [[ $device =~ ^[A-Za-z0-9._@-]+$ ]] && trusted+=("$device")
  done < <(/usr/bin/karchy-trusted-networks status --json 2>/dev/null |
    jq -r '.active[] | select(.trusted) | .device' 2>/dev/null)
fi

status=$(ufw status)
mkdir -p "${STATE%/*}"
: >"$STATE.tmp"

for app in "${APPS[@]}"; do
  read -r id ports protocols program <<<"$app"
  comment=karchy-$id
  wanted=()
  [[ $program != - && ! -e $program ]] || wanted=("${trusted[@]}")

  # Rules this script added earlier: "53317 on wlan0 ... # karchy-localsend"
  # or "1714:1764/tcp on wlan0 ... # karchy-kdeconnect", plus the (v6) twins;
  # one with no interface is the old all-interfaces rule.
  mapfile -t present < <(sed -n "s|^$ports\(/[a-z]*\)\? \((v6) \)\?on \([^ ]*\) .*# $comment\$|\3|p" <<<"$status" | sort -u)
  if grep -qE "^$ports(/[a-z]+)?( \(v6\))? +ALLOW.*# $comment\$" <<<"$status"; then
    ufw delete allow "$ports" >/dev/null || true
  fi

  # "any" is one rule for both protocols; otherwise one rule per protocol.
  rule() {
    local action=$1 device=$2 proto
    if [[ $protocols == any ]]; then
      if [[ $action == add ]]; then
        ufw allow in on "$device" to any port "$ports" comment "$comment" >/dev/null
      else
        ufw delete allow in on "$device" to any port "$ports" >/dev/null
      fi
      return
    fi
    for proto in ${protocols//,/ }; do
      if [[ $action == add ]]; then
        ufw allow in on "$device" to any port "$ports" proto "$proto" comment "$comment" >/dev/null
      else
        ufw delete allow in on "$device" to any port "$ports" proto "$proto" >/dev/null
      fi
    done
  }

  for device in "${present[@]}"; do
    [[ " ${wanted[*]} " == *" $device "* ]] || rule delete "$device"
  done
  for device in "${wanted[@]}"; do
    [[ " ${present[*]} " == *" $device "* ]] || rule add "$device"
    echo "$id $device" >>"$STATE.tmp"
  done
done

mv "$STATE.tmp" "$STATE"
