#!/bin/bash

# karchy:summary=Install Arch packages if they are missing
# karchy:args=<packages...>
# karchy:examples=karchy pkg add jq ripgrep
# karchy:requires-sudo=true

if karchy-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    pacman --color auto -S --noconfirm --needed -- "$@" || exit 1
  else
    sudo pacman --color auto -S --noconfirm --needed -- "$@" || exit 1
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
