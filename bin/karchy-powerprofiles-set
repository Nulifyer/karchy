#!/bin/bash

# karchy:summary=Set and remember the power profile for AC or battery use
# karchy:args=[autodetect|ac|battery] [power-saver|balanced|performance]

# With a profile: remember it for that power source, and switch to it when
# that source is the one in use. So the bar's power panel changes the profile
# running now, and Settings › Power can also set the other source's.
#
# Without one: switch to the source's remembered profile, Balanced until one
# is picked. On battery at or under the low-battery warning that is Power
# saver instead, unless `battery.saver` is off in shell.json (Settings ›
# Power), and nothing is remembered: the charger, or a profile picked by
# hand, ends it. The decision is made here so that every caller agrees: the
# session's start (karchy-powerprofiles-init), the charger going in or out
# and the low-battery warning (the shell's battery service).

action="${1:-autodetect}"
requested_profile="${2:-}"

usage() {
  echo "Usage: karchy-powerprofiles-set [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
  exit 1
}

(( $# <= 2 )) || usage

# The same signal as the shell (UPower.onBattery), so every entry point saves
# and restores the profile under the same ac/battery key.
in_use=ac
if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
  in_use=battery
fi

case "$action" in
  autodetect) action=$in_use ;;
  ac | battery) ;;
  *) usage ;;
esac

mapfile -t profiles < <(karchy-powerprofiles-list)

profile_available() {
  [[ " ${profiles[*]} " == *" $1 "* ]]
}

# Power saver at a low battery: `battery.saver` is on (karchy's default; off
# is a choice kept in shell.json) and the battery is low, which is
# karchy-battery-running-low's to say.
battery_saver_due() {
  local saver
  # shellcheck source=bin/karchy-shell-config
  saver=$(source karchy-shell-config 2>/dev/null && effective_config 2>/dev/null | jq -r '(.battery.saver)? == true') || return 1
  [[ $saver == true ]] && karchy-battery-running-low
}

state_dir="${KARCHY_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/karchy/powerprofiles}"
state_file="$state_dir/$action"

remember() {
  mkdir -p "$state_dir"
  printf '%s\n' "$requested_profile" >"$state_file"
}

if [[ -n $requested_profile ]]; then
  profile_available "$requested_profile" || {
    echo "Power profile is not available: $requested_profile" >&2
    exit 1
  }

  # The other source's profile waits for that source.
  if [[ $action != "$in_use" ]]; then
    remember
    exit 0
  fi
  profile="$requested_profile"
elif [[ $action == battery ]] && profile_available power-saver && battery_saver_due; then
  profile=power-saver
elif [[ -r $state_file ]]; then
  profile=$(<"$state_file")
fi

# Balanced on both sources until a profile is picked for that source (user
# 2026-11-16: less heat and fan noise at a desk; Performance is one click away).
if [[ -z ${profile:-} ]] || ! profile_available "$profile"; then
  profile=balanced
fi

powerprofilesctl set "$profile" || exit
karchy-shell -q battery refreshPowerProfile >/dev/null 2>&1 || true

[[ -z $requested_profile ]] || remember
