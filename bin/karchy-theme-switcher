#!/bin/bash

# karchy:summary=Open the Karchy theme switcher

print_rows=false

# The shell's picker opens from rows it already holds and runs this to refresh
# them, so the theme list never waits on the index below.
if [[ $1 == "--print-rows" ]]; then
  print_rows=true
  shift
fi

USER_THEMES_PATH="$HOME/.config/karchy/themes"
KARCHY_THEMES_PATH="$KARCHY_PATH/themes"
CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/karchy/theme-selector"
preview_dir="$CACHE_PATH/previews"
signature_file="$CACHE_PATH/signature"
fast_signature_file="$CACHE_PATH/fast-signature"

mkdir -p "$preview_dir"

find_preview() {
  local theme_path="$1"
  local preview preview_name

  for preview_name in preview.png preview.jpg preview.jpeg preview.webp preview.gif preview.bmp preview.mp4 preview.m4v preview.mov preview.webm preview.mkv preview.avi; do
    preview=$(find -L "$theme_path" -maxdepth 1 -type f -iname "$preview_name" -print -quit 2>/dev/null)

    if [[ -n $preview ]]; then
      printf '%s\n' "$preview"
      return
    fi
  done

  if [[ -d $theme_path/backgrounds ]]; then
    find -L "$theme_path/backgrounds" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \
         -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \) \
      -print 2>/dev/null | sort | head -n 1
  fi
}

add_theme_preview() {
  local theme_name="$1"
  local preview="$2"
  local extension="${preview##*.}"
  extension="${extension,,}"

  [[ -n $preview ]] || return
  [[ -e $preview_dir/$theme_name.$extension ]] && return

  ln -s "$preview" "$preview_dir/$theme_name.$extension"
}

fast_signature="v2"$'\n'
for theme_dir in "$USER_THEMES_PATH" "$KARCHY_THEMES_PATH"; do
  if [[ -d $theme_dir ]]; then
    fast_signature+="$theme_dir:$(stat -Lc '%Y' "$theme_dir")"$'\n'

    while IFS= read -r -d '' theme_path; do
      fast_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path")"$'\n'
    done < <(find -L "$theme_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print0 2>/dev/null | sort -z)
  fi
done

if [[ ! -f $fast_signature_file ]] || ! cmp -s "$fast_signature_file" <(printf '%s' "$fast_signature"); then
  theme_signature=""
  for theme_dir in "$USER_THEMES_PATH" "$KARCHY_THEMES_PATH"; do
    if [[ -d $theme_dir ]]; then
      theme_signature+="$theme_dir:$(stat -Lc '%Y' "$theme_dir")"$'\n'

      while IFS= read -r -d '' theme_path; do
        preview=$(find_preview "$theme_path")
        theme_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path")"$'\n'

        if [[ -n $preview ]]; then
          theme_signature+="$preview:$(stat -Lc '%s:%Y' "$preview")"$'\n'
        fi
      done < <(find -L "$theme_dir" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print0 2>/dev/null | sort -z)
    fi
  done
fi

if [[ ! -f $fast_signature_file ]] || ! cmp -s "$fast_signature_file" <(printf '%s' "$fast_signature"); then
  rm -rf "$preview_dir"
  mkdir -p "$preview_dir"

  while IFS= read -r theme_path; do
    theme_name=${theme_path##*/}
    preview=$(find_preview "$theme_path")

    if [[ -z $preview ]]; then
      preview=$(find_preview "$KARCHY_THEMES_PATH/$theme_name")
    fi

    add_theme_preview "$theme_name" "$preview"
  done < <(find -L "$USER_THEMES_PATH" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print 2>/dev/null | sort)

  while IFS= read -r theme_path; do
    theme_name=${theme_path##*/}
    preview=$(find_preview "$theme_path")
    add_theme_preview "$theme_name" "$preview"
  done < <(find -L "$KARCHY_THEMES_PATH" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort)

  printf '%s' "$theme_signature" >"$signature_file"
  printf '%s' "$fast_signature" >"$fast_signature_file"
fi

# Themes in color-wheel order (user 2026-11-16): by the hue of each theme's
# accent, red through orange, yellow, green and blue to violet; themes whose
# accent is gray come last, darkest background first. A theme in
# ~/.config/karchy/themes wins over the stock one of the same name, as above.
order_file="$CACHE_PATH/order"
{
  for theme_dir in "$USER_THEMES_PATH" "$KARCHY_THEMES_PATH"; do
    for colors in "$theme_dir"/*/colors.toml; do
      [[ -f $colors ]] || continue
      name=${colors%/colors.toml}
      name=${name##*/}
      printf '%s\t%s\t%s\n' "$name" \
        "$(sed -n 's/^accent *= *"#\([0-9a-fA-F]\{6\}\)".*/\1/p' "$colors" | head -n 1)" \
        "$(sed -n 's/^background *= *"#\([0-9a-fA-F]\{6\}\)".*/\1/p' "$colors" | head -n 1)"
    done
  done
} | awk -F'\t' '
  function hex(s) { return index("0123456789abcdef", tolower(substr(s, 1, 1))) * 16 + index("0123456789abcdef", tolower(substr(s, 2, 1))) - 17 }
  function channels(c) { r = hex(substr(c, 1, 2)) / 255; g = hex(substr(c, 3, 2)) / 255; b = hex(substr(c, 5, 2)) / 255
    mx = r; if (g > mx) mx = g; if (b > mx) mx = b; mn = r; if (g < mn) mn = g; if (b < mn) mn = b }
  !seen[$1]++ {
    key = 2000
    if ($3 != "") { channels($3); key = 1000 + (mx + mn) * 50 }
    if ($2 != "") {
      channels($2); d = mx - mn; l = (mx + mn) / 2
      s = (d == 0) ? 0 : d / (1 - (2 * l - 1 < 0 ? 1 - 2 * l : 2 * l - 1))
      if (s >= 0.1) {
        if (mx == r) h = 60 * ((g - b) / d); else if (mx == g) h = 60 * ((b - r) / d + 2); else h = 60 * ((r - g) / d + 4)
        key = (h < 0) ? h + 360 : h
      }
    }
    printf "%09.3f\t%s\n", key, $1
  }' | sort -s -k1,1n | cut -f2 >"$order_file.tmp" && mv "$order_file.tmp" "$order_file"

current_theme=$(cat "$HOME/.local/state/karchy/current/theme.name" 2>/dev/null)
selected_preview=""
for extension in png jpg jpeg webp gif bmp mp4 m4v mov webm mkv avi; do
  if [[ -e $preview_dir/$current_theme.$extension ]]; then
    selected_preview="$preview_dir/$current_theme.$extension"
    break
  fi
done
menu_args=(
  --print-name
  --show-labels
  --filterable
  --lazy-thumbnails
  --order "$order_file"
  --selected "$selected_preview"
)

if [[ $print_rows == true ]]; then
  menu_args+=(--print-rows)
fi

exec karchy-menu-images "${menu_args[@]}" "$preview_dir"
