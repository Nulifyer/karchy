#!/bin/bash

# karchy:summary=Take a screenshot
# karchy:group=capture
# karchy:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# karchy:examples=karchy screenshot | karchy capture screenshot region
# karchy:aliases=karchy screenshot

if [[ -n ${KARCHY_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$KARCHY_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   karchy-i18n capture.screenshotSaved, karchy-i18n capture.screenshotSavedCopied,
#   karchy-i18n capture.screenshotOpen, karchy-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
