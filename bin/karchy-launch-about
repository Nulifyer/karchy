#!/bin/bash

# karchy:summary=Show system information (fastfetch) with the karchy logo.

# karchy simplification (D-48): Karchy's version sized the window to its logo
# and animated a sheen across it. This shows the same facts in the floating
# About window and waits for a key.
#
# What it shows is karchy's fastfetch config (/etc/xdg/fastfetch/config.jsonc,
# from system/xdg/fastfetch): the mark, and no Terminal Font row. A plain
# `fastfetch` in a terminal reads the same file, and a config of the user's
# own replaces it in both.
#
# fastfetch names the process that started it as the shell, so it is started
# from the user's shell, not from the bash that waits for the key ("Shell:
# bash" for everyone). The `; true` keeps bash and zsh from replacing
# themselves with fastfetch, which would make this bash the parent again.
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.karchy.about --title=About -e bash -c \
  '"${SHELL:-bash}" -c "fastfetch; true" || fastfetch; read -rsn1'
