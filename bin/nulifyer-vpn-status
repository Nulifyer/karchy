#!/bin/bash
# The Omarchy bar widget's view of the VPN: the published status
# (/run/nulifyer-vpn/status) plus live tunnel details. The widget runs it when
# the status file changes, and while its panel is open. Other readers use the
# status file itself (see README, "Status").
set -u

readonly STATUS=/run/nulifyer-vpn/status
command -v jq >/dev/null || { printf 'Missing required command: jq\n' >&2; exit 1; }

status=$(cat "$STATUS" 2>/dev/null || true)
[[ -n $status ]] || status='{"mode":"off","state":"unknown","reason":"not-running"}'
state=$(jq -r '.state // "unknown"' <<<"$status")

# The widget's older state names.
case $state in
  protecting) legacy=connected ;;
  standing-by) [[ $(jq -r '.reason' <<<"$status") == trusted ]] && legacy=off || legacy=waiting ;;
  connecting|paused) legacy=connecting ;;
  failed|off) legacy=$state ;;
  *) legacy=unknown ;;
esac

if [[ ${1:-} != --json ]]; then
  printf '%s\n' "$legacy"
  exit 0
fi

iface=$(jq -r '.tunnel.interface // empty' <<<"$status")
tunnel=$(jq -r '.tunnel.name // empty' <<<"$status")
vpn_nm=inactive vpn_ip='' handshake_age=-1 guard=unknown
if [[ -n $tunnel ]]; then
  vpn_nm=$(nmcli --escape no -g GENERAL.STATE connection show "$tunnel" 2>/dev/null || true)
  vpn_nm=${vpn_nm:-inactive}
fi
if [[ -n $iface ]]; then
  vpn_ip=$(ip -4 -o address show dev "$iface" 2>/dev/null | awk 'NR == 1 { split($4, a, "/"); print a[1] }')
fi
guard=$(sed -n '1p' /run/nulifyer-vpn/guard-mode 2>/dev/null || printf unknown)
[[ $guard == closed || $guard == portal ]] && guard=connecting
latest=$(wg show "$iface" latest-handshakes 2>/dev/null | awk 'BEGIN { n = 0 } $2 > n { n = $2 } END { print n }' || true)
if [[ ${latest:-0} =~ ^[0-9]+$ ]] && (( latest > 0 )); then
  handshake_age=$(( $(date +%s) - latest ))
fi

jq -c --arg legacy "$legacy" --arg vpnNm "$vpn_nm" --arg vpnIp "$vpn_ip" --arg guard "$guard" \
  --argjson handshakeAge "$handshake_age" '
  . as $s
  | ($s.network // {}) as $n
  | {
      status: $s,
      state: $legacy, mode: $s.mode, intent: $s.mode,
      effective: (if $s.state == "protecting" or $s.state == "connecting" or $s.state == "failed" then "on"
                  elif $s.state == "standing-by" and $s.reason == "no-network" then "waiting" else "off" end),
      tunnel: ($s.tunnel.name // "wgclient"), vpnNm: $vpnNm, vpnIp: $vpnIp,
      upstreamInterface: ($n.device // ""), upstreamName: ($n.name // ""), upstreamType: ($n.type // ""),
      networkClass: (if $s.network == null then "none" elif $n.trusted then "trusted" else "public" end),
      trusted: ($n.trusted // false),
      probe: (if $s.state == "protecting" then "reachable" elif $s.state == "failed" then "unreachable" else "unavailable" end),
      guard: $guard,
      traffic: (if $s.state == "protecting" then "protected"
                elif $s.state == "off" or $s.state == "standing-by" and $s.reason == "trusted" then "direct"
                elif $s.state == "unknown" then "unknown" else "blocked" end),
      routeMode: (if $s.state == "protecting" then "full"
                  elif $s.state == "off" or $s.state == "standing-by" and $s.reason == "trusted" then "direct"
                  elif $s.state == "unknown" then "unknown" else "blocked" end),
      dnsMode: (if $s.state == "protecting" then "vpn"
                elif $s.state == "off" or $s.state == "standing-by" and $s.reason == "trusted" then
                  (if $s.integration == "karchy" then "network" elif $n.trusted then "dhcp" else "doh" end)
                elif $s.state == "unknown" then "unknown" else "blocked" end),
      dnsServer: "",
      handshakeAge: $handshakeAge, statusAge: 0
    }' <<<"$status"
