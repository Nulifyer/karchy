#!/bin/bash

# karchy:summary=Print the day your password was last changed
# karchy:hidden=true

# The system keeps a password's last change as a day counted in UTC, and
# `passwd -S` prints that day: on the evening of 19 November in New York it
# already reads 2026-11-20. Shown beside the local date, a change made a
# minute ago was dated tomorrow.
#
# This prints the day to show (Settings › Security): today's local date when
# the change falls in the current UTC day, so within the last 24 hours; else
# the recorded day. The record has no time of day, so near midnight this can
# be a day off, but never in the future.
#
# Prints YYYY-MM-DD, or nothing when the day isn't known. passwd answers for
# one's own account without root. KARCHY_PASSWORD_STATUS (a `passwd -S`
# line) and KARCHY_NOW (seconds since 1970) stand in for the system in tests.

set -uo pipefail

(($# == 0)) || {
  echo "Usage: karchy-password-changed" >&2
  exit 64
}

# "name P 2026-11-19 0 99999 7 -1"
line=${KARCHY_PASSWORD_STATUS-$(LC_ALL=C passwd -S 2>/dev/null)}
changed=$(awk '$3 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ { print $3; exit }' <<<"$line")
[[ -n $changed ]] || exit 0

now=${KARCHY_NOW:-$(date +%s)}
# ISO days compare as text.
[[ $changed < $(date -u -d "@$now" +%F) ]] || changed=$(date -d "@$now" +%F)
printf '%s\n' "$changed"
