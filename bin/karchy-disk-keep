#!/bin/bash

# karchy:summary=Mount an internal data disk at /mnt/<label> from now on, stop doing so, or stop asking about it (D-24)
# karchy:args=<device> | --remove [--yes] <device> | --ignore <device>
# karchy:hidden=true

# Run from the "new disk" notification (karchy-disks-check) and from Settings ›
# Storage: in a floating terminal to keep a disk or stop keeping it, since the
# fstab change goes through sudo; directly to stop being asked about it.
# --remove unmounts the disk and takes its line back out of /etc/fstab; --yes
# skips its question for a caller that has asked already.

set -euo pipefail

IGNORED="${XDG_STATE_HOME:-$HOME/.local/state}/karchy/disks-ignored"

if [[ ${1:-} == "--ignore" ]]; then
  uuid=$(lsblk -dno UUID "${2:?}")
  mkdir -p "$(dirname "$IGNORED")"
  echo "$uuid" >>"$IGNORED"
  exit 0
fi

if [[ ${1:-} == "--remove" ]]; then
  shift
  confirmed=""
  if [[ ${1:-} == "--yes" ]]; then
    confirmed=1
    shift
  fi
  device="${1:?Usage: karchy-disk-keep --remove [--yes] <device>}"
  uuid=$(lsblk -dno UUID "$device")
  line=$(grep -F "# karchy-data-disk" /etc/fstab | awk -v source="UUID=$uuid" '$1 == source' | head -n 1 || true)
  if [[ -z $uuid || -z $line ]]; then
    echo "$device is not a disk karchy keeps mounted." >&2
    exit 1
  fi
  mount=$(awk '{ print $2 }' <<<"$line")
  label=$(lsblk -dno LABEL "$device")
  size=$(lsblk -dno SIZE "$device" | tr -d " ")

  echo "Stop keeping ${label:-the disk} ($size, $device) mounted at $mount."
  echo "It is unmounted now and no longer mounts at startup. The files on it are not touched."
  echo
  [[ -n $confirmed ]] || karchy-gum confirm "Stop keeping it mounted?" || exit 130
  sudo -v -p "Your password, to change /etc/fstab: " || exit 130

  # Unmounted first: while something holds it open, nothing is changed.
  if mountpoint -q "$mount" && ! sudo umount "$mount"; then
    echo "$mount is in use, probably open in an app or a terminal. Close it and try again; nothing was changed."
    exit 1
  fi
  sudo sed -i "\\|^UUID=$uuid $mount .*# karchy-data-disk\$|d" /etc/fstab
  sudo systemctl daemon-reload
  if [[ $(awk '{ print $3 }' <<<"$line") == btrfs ]]; then
    sudo systemctl disable --now "btrfs-scrub@$(systemd-escape -p "$mount").timer" >/dev/null 2>&1 || true
  fi
  # The mount folder goes when it is empty; one that isn't was never the disk's.
  sudo rmdir "$mount" 2>/dev/null || true

  karchy-notification-send -g disk "Disk no longer kept" "${label:-$device} was at $mount"
  echo "Done: ${label:-$device} is no longer kept at $mount."
  exit 0
fi

device="${1:?Usage: karchy-disk-keep <device> | --remove [--yes] <device> | --ignore <device>}"
# The floating terminal shows Failed and waits for a key after an error.
line=$(karchy-disk-fstab line "$device" "$(id -u)" "$(id -g)") || exit 1
mount=$(awk '{ print $2 }' <<<"$line")
label=$(lsblk -dno LABEL "$device")
size=$(lsblk -dno SIZE "$device" | tr -d " ")

echo "Mount ${label:-the disk} ($size, $device) at $mount from now on."
echo "It appears in the file manager and never delays startup if it's missing."
echo
# Declining closes the window (exit 130, the menu terminal's cancel).
karchy-gum confirm "Keep it mounted?" || exit 130

sudo mkdir -p "$mount"
echo "$line" | sudo tee -a /etc/fstab >/dev/null
sudo systemctl daemon-reload
if ! sudo mount "$mount"; then
  # Leave nothing behind, so the disk is offered again once it can mount
  # (a Windows volume left hibernated by Fast Startup refuses, for one).
  uuid=$(awk '{ print $1 }' <<<"$line")
  sudo sed -i "\\|^$uuid $mount .*# karchy-data-disk\$|d" /etc/fstab
  sudo systemctl daemon-reload
  sudo rmdir "$mount" 2>/dev/null || true
  echo "The disk did not mount, so nothing was changed. If it holds Windows, shut Windows down fully (turn off Fast Startup) and try again."
  if [[ $(awk '{ print $3 }' <<<"$line") == ntfs3 ]]; then
    echo "If Windows isn't installed on it any more, clear its dirty flag with: sudo ntfsfix --clear-dirty $device (from the ntfsprogs package)"
  fi
  exit 1
fi

# A btrfs data disk gets the same monthly scrub as the system disk.
if [[ $(awk '{ print $3 }' <<<"$line") == btrfs ]]; then
  sudo systemctl enable --now "btrfs-scrub@$(systemd-escape -p "$mount").timer" >/dev/null 2>&1 || true
fi

# A new Linux filesystem's top folder belongs to root, so nobody could write to
# it. Hand an empty one to the user; one holding data keeps its owners.
if [[ $(stat -c %u "$mount") == "0" ]]; then
  if [[ -z $(find "$mount" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit 2>/dev/null) ]]; then
    sudo chown "$(id -u):$(id -g)" "$mount"
  else
    echo "The disk's top folder belongs to root and holds files; ownership was left as it is."
  fi
fi

karchy-notification-send -g disk "Disk mounted" "${label:-$device} is at $mount"
echo "Done: ${label:-$device} is at $mount."
