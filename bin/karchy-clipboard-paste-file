#!/bin/bash

# karchy:summary=Copy a file's content to the clipboard and paste it
# karchy:group=clipboard
# karchy:args=[--copy-only] <mime-type> <path>
# karchy:examples=karchy clipboard paste file image/png /tmp/screenshot.png | karchy clipboard paste file --copy-only text/plain notes.txt
# karchy:hidden=true

# The clipboard history (D-167) pastes an entry with this: the entry's file
# goes back on the clipboard, then the focused window is sent the paste keys,
# as if the user had pressed them. A text/uri-list file is a list of files
# and is copied the way a file manager copies them.

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: karchy-clipboard-paste-file [--copy-only] <mime-type> <path>" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

if [[ $mime == text/uri-list ]]; then
  karchy-clipboard-copy-files --uri-list "$path" || exit 1
else
  wl-copy --type "$mime" <"$path" || exit 1
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

karchy-clipboard-paste-keys
