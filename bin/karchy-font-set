#!/bin/bash

# karchy:summary=Set the monospace font of terminals, code editors and code in the shell
# karchy:args=[--no-restart] <font-name> | reset
# karchy:examples=karchy font list | karchy font set "FiraCode Nerd Font" | karchy font set reset

# fontconfig is the single source of truth: the terminals ask for "monospace"
# (their starter configs say so), and so do code editors, the shell for what
# reads as code (D-149), and GTK and Qt apps for their monospace text. The choice is one file in karchy's own
# state, which /etc/fonts/conf.d/50-karchy.conf includes (D-120); no file of
# the user's is written (D-23), and a rule in ~/.config/fontconfig/ still wins.
#
#   <font-name>   an installed fixed-width family, as `karchy font list` prints it
#   reset         back to karchy's default, Noto Sans Mono
#   --no-restart  only write the choice: apps follow as they start, and the
#                 shell at its next start

usage() {
  sed -n 's/^# karchy:args=/Usage: karchy-font-set /p' "$0"
}

restart=1
if [[ ${1:-} == --no-restart ]]; then
  restart=0
  shift
fi
font_name="${1:-}"

case "$font_name" in
  -h | --help)
    usage
    exit 0
    ;;
  "" | -*)
    usage >&2
    exit 1
    ;;
esac

state_file="$HOME/.local/state/karchy/fontconfig/font.conf"
# Where karchy-font-set kept the choice before D-120.
legacy_file="$HOME/.config/fontconfig/conf.d/60-karchy-font.conf"

if [[ $font_name == reset ]]; then
  rm -f "$state_file"
else
  # The family as fontconfig spells it, among the fixed-width ones: a
  # proportional font or part of a name would otherwise become the terminal font.
  family=$(karchy-font-list --names | grep -ixF -m1 -- "$font_name")
  if [[ -z $family ]]; then
    echo "'$font_name' is not an installed monospace font. karchy font list shows the ones that are." >&2
    exit 1
  fi
  font_name=$family
  font_xml=$(printf '%s' "$font_name" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
  mkdir -p "${state_file%/*}"
  tmp=$(mktemp "$state_file.XXXXXX")
  # Before "monospace", not first of all: asking for the generic monospace
  # gives this font, asking for a font by name still gives that font.
  # (Unquoted, for the family: no backticks or dollars in the text below.)
  cat >"$tmp" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Written by karchy-font-set (Settings › Fonts). Change it there or with
     "karchy font set"; your own rules go in ~/.config/fontconfig/fonts.conf. -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$font_xml</string>
    </edit>
  </match>
</fontconfig>
XML
  mv "$tmp" "$state_file"
fi

# The file karchy wrote there itself; it would outrank the new one.
if grep -qs 'Written by karchy-font-set' "$legacy_file"; then
  rm -f "$legacy_file"
  rmdir "${legacy_file%/*}" "${legacy_file%/*/*}" 2>/dev/null || true
fi

((restart)) || exit 0

karchy-restart-shell

# A running terminal keeps the font it resolved "monospace" to when it
# started, also after reloading its config (kitty's SIGUSR1 and Ghostty's
# SIGUSR2 change nothing here): its open windows stay as they are, and a
# terminal started from now on uses the new font. foot's server is such a
# running terminal too; karchy-footclient gives its next window the font.
waiting=()
# A foot window is a footclient, or a foot that isn't the server.
if pgrep -x footclient >/dev/null || pgrep -a -x foot | grep -qv -- '--server'; then waiting+=(foot); fi
for terminal in kitty alacritty ghostty; do
  if pgrep -x "$terminal" >/dev/null; then waiting+=("${terminal^}"); fi
done
now=$(fc-match monospace -f '%{family[0]}')
if ((${#waiting[@]})); then
  # "foot", "foot and Kitty", "foot, Kitty and Ghostty".
  list=${waiting[0]}
  for ((i = 1; i < ${#waiting[@]}; i++)); do
    if ((i == ${#waiting[@]} - 1)); then list+=" and ${waiting[i]}"; else list+=", ${waiting[i]}"; fi
  done
  karchy-notification-send -g look.font "$(karchy-i18n font.changed "$now")" "$(karchy-i18n font.openWindowsKeep "$list")"
else
  karchy-notification-send -g look.font "$(karchy-i18n font.changed "$now")"
fi

if [[ $font_name == reset ]]; then
  karchy-hook font-set "$now"
else
  karchy-hook font-set "$font_name"
fi
