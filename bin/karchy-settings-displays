#!/bin/bash

# karchy:summary=Read and save per-monitor display settings (Settings › Displays)
# karchy:args=status | set <monitor> <setting> <value> | forget <monitor>
# karchy:hidden=true

# Settings are saved per physical monitor, keyed by Hyprland's description of it
# (make, model and serial, as `desc:` rules match), so a
# laptop finds its desk monitor's settings again after docking. They live in
# ~/.config/karchy/displays.json and are written as Hyprland rules into
# ~/.local/state/karchy/hypr/displays.lua, which karchy loads before
# ~/.config/hypr/monitors.lua: a rule written there by hand always wins (D-27).
#
#   status                         JSON: each connected monitor, its modes,
#                                  current state and saved settings
#   set <monitor> <setting> <value>
#       monitor: a connector name (DP-1) or a saved key
#       setting: mode (WxH@Hz or preferred), scale (number or auto),
#                position (auto, auto-left, auto-right, auto-up, auto-down or XxY),
#                transform (0-7), enabled (true or false),
#                vrr (0 off, 1 always, 2 in fullscreen apps),
#                bitdepth (8 or 10), cm (color mode: auto, srgb, wide, edid,
#                hdr or hdredid), sdrbrightness (0.5-3) and sdrsaturation
#                (0.5-2) for SDR content in HDR, mirror (a connector or none)
#   forget <monitor>               Drop the saved settings for a monitor

set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/karchy/displays.json"
HYPR_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/karchy/hypr/displays.lua"

usage() {
  sed -n 's/^# karchy:args=/Usage: karchy-settings-displays /p' "$0" >&2
  exit 1
}

saved() {
  if [[ -f $CONFIG_FILE ]] && jq -e '.version == 1' "$CONFIG_FILE" >/dev/null 2>&1; then
    jq -c . "$CONFIG_FILE"
  else
    echo '{"version":1,"monitors":{}}'
  fi
}

# Every monitor Hyprland knows, connected and disabled alike, with the key its
# settings are saved under.
monitors() {
  hyprctl monitors all -j | jq -c '[.[] | {
    name,
    key: .description,
    description,
    enabled: (.disabled | not),
    width, height, refreshRate, scale, x, y, transform,
    format: .currentFormat, colorMode: .colorManagementPreset,
    mirrorOf: (.mirrorOf // "none"),
    modes: [.availableModes[] | sub("Hz$"; "")]
  }]'
}

status() {
  jq -n -c --argjson monitors "$(monitors)" --argjson saved "$(saved)" '
    {monitors: [$monitors[] | . + {saved: ($saved.monitors[.key] // null)}]}'
}

# A monitor argument is a connector name or a saved key; print its key.
resolve_key() {
  local monitor="$1" key
  key=$(monitors | jq -r --arg m "$monitor" 'map(select(.name == $m or .key == $m)) | first | .key // empty')
  if [[ -z $key ]]; then
    key=$(saved | jq -r --arg m "$monitor" '.monitors | keys[] | select(. == $m)')
  fi
  [[ -n $key ]] || { echo "No monitor named or saved as '$monitor'" >&2; exit 1; }
  printf '%s\n' "$key"
}

lua_quote() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/ }
  printf '"%s"' "$value"
}

write_files() {
  local config="$1" config_tmp hypr_tmp key line vrr
  mkdir -p "$(dirname "$CONFIG_FILE")" "$(dirname "$HYPR_FILE")"
  config_tmp=$(mktemp "$(dirname "$CONFIG_FILE")/.displays.json.XXXXXX")
  hypr_tmp=$(mktemp "$(dirname "$HYPR_FILE")/.displays.lua.XXXXXX")
  trap 'rm -f "$config_tmp" "$hypr_tmp"' RETURN

  jq . <<<"$config" >"$config_tmp"
  {
    echo "-- Generated by karchy Settings › Displays (karchy-settings-displays)."
    echo "-- Change these there. A rule in ~/.config/hypr/monitors.lua for the same"
    echo "-- monitor loads later and wins."
    while IFS= read -r key; do
      line="hl.monitor({ output = $(lua_quote "desc:$key")"
      if [[ $(jq -r --arg k "$key" '.monitors[$k].enabled // true' <<<"$config") == "false" ]]; then
        line+=", disabled = true"
      else
        line+=", mode = $(lua_quote "$(jq -r --arg k "$key" '.monitors[$k].mode // "preferred"' <<<"$config")")"
        line+=", position = $(lua_quote "$(jq -r --arg k "$key" '.monitors[$k].position // "auto"' <<<"$config")")"
        line+=", scale = $(jq -r --arg k "$key" '.monitors[$k].scale // "auto" | if type == "number" then tostring else "\"auto\"" end' <<<"$config")"
        line+=", transform = $(jq -r --arg k "$key" '.monitors[$k].transform // 0' <<<"$config")"
        # Variable refresh only when chosen: Hyprland's default (off) otherwise.
        vrr=$(jq -r --arg k "$key" '.monitors[$k].vrr // empty' <<<"$config")
        [[ -z $vrr ]] || line+=", vrr = $vrr"
        # Advanced (Settings › Displays › Advanced): only what was chosen.
        line+=$(jq -r --arg k "$key" '.monitors[$k] as $m
          | [ (if $m.bitdepth then ", bitdepth = \($m.bitdepth)" else empty end),
              (if $m.cm then ", cm = \"\($m.cm)\"" else empty end),
              (if $m.sdrbrightness then ", sdrbrightness = \($m.sdrbrightness)" else empty end),
              (if $m.sdrsaturation then ", sdrsaturation = \($m.sdrsaturation)" else empty end),
              (if ($m.mirror // "none") != "none" then ", mirror = \"\($m.mirror)\"" else empty end) ]
          | join("")' <<<"$config")
      fi
      echo "$line })"
    done < <(jq -r '.monitors | keys[]' <<<"$config")
  } >"$hypr_tmp"

  chmod 644 "$config_tmp" "$hypr_tmp"
  mv "$config_tmp" "$CONFIG_FILE"
  mv "$hypr_tmp" "$HYPR_FILE"
  trap - RETURN
  hyprctl reload >/dev/null 2>&1 || true
}

set_value() {
  local monitor="${1:-}" setting="${2:-}" value="${3:-}" key config modes
  [[ -n $monitor && -n $setting ]] || usage
  key=$(resolve_key "$monitor")
  config=$(saved)

  case "$setting" in
    mode)
      if [[ $value != "preferred" ]]; then
        modes=$(monitors | jq -c --arg k "$key" 'map(select(.key == $k)) | first | .modes // []')
        jq -e --arg v "$value" 'index($v) != null' <<<"$modes" >/dev/null ||
          { echo "Mode '$value' is not offered by this monitor" >&2; exit 1; }
      fi
      config=$(jq -c --arg k "$key" --arg v "$value" '.monitors[$k].mode = $v' <<<"$config")
      ;;
    scale)
      if [[ $value == "auto" ]]; then
        config=$(jq -c --arg k "$key" '.monitors[$k].scale = "auto"' <<<"$config")
      else
        if ! [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! awk -v s="$value" 'BEGIN { exit !(s >= 0.5 && s <= 4) }'; then
          echo "Scale must be auto or a number from 0.5 to 4" >&2
          exit 1
        fi
        config=$(jq -c --arg k "$key" --argjson v "$value" '.monitors[$k].scale = $v' <<<"$config")
      fi
      ;;
    position)
      [[ $value =~ ^(auto|auto-left|auto-right|auto-up|auto-down|-?[0-9]+x-?[0-9]+)$ ]] ||
        { echo "Position must be auto, auto-left, auto-right, auto-up, auto-down or XxY" >&2; exit 1; }
      config=$(jq -c --arg k "$key" --arg v "$value" '.monitors[$k].position = $v' <<<"$config")
      ;;
    transform)
      [[ $value =~ ^[0-7]$ ]] || { echo "Transform must be 0-7" >&2; exit 1; }
      config=$(jq -c --arg k "$key" --argjson v "$value" '.monitors[$k].transform = $v' <<<"$config")
      ;;
    bitdepth)
      [[ $value == 8 || $value == 10 ]] || { echo "Color depth must be 8 or 10" >&2; exit 1; }
      config=$(jq -c --arg k "$key" --argjson v "$value" '.monitors[$k].bitdepth = $v' <<<"$config")
      ;;
    cm)
      [[ $value =~ ^(auto|srgb|wide|edid|hdr|hdredid)$ ]] ||
        { echo "Color mode must be auto, srgb, wide, edid, hdr or hdredid" >&2; exit 1; }
      config=$(jq -c --arg k "$key" --arg v "$value" '.monitors[$k].cm = $v' <<<"$config")
      ;;
    sdrbrightness | sdrsaturation)
      local low=0.5 high=3
      [[ $setting == sdrsaturation ]] && high=2
      if ! [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! awk -v v="$value" -v l="$low" -v h="$high" 'BEGIN { exit !(v >= l && v <= h) }'; then
        echo "$setting must be a number from $low to $high" >&2
        exit 1
      fi
      config=$(jq -c --arg k "$key" --arg s "$setting" --argjson v "$value" '.monitors[$k][$s] = $v' <<<"$config")
      ;;
    mirror)
      if [[ $value != none ]]; then
        monitors | jq -e --arg v "$value" --arg k "$key" 'any(.[]; .name == $v and .key != $k)' >/dev/null ||
          { echo "There's no other monitor named $value to mirror" >&2; exit 1; }
      fi
      config=$(jq -c --arg k "$key" --arg v "$value" '.monitors[$k].mirror = $v' <<<"$config")
      ;;
    vrr)
      [[ $value =~ ^[0-2]$ ]] || { echo "Variable refresh must be 0 (off), 1 (always) or 2 (in fullscreen apps)" >&2; exit 1; }
      config=$(jq -c --arg k "$key" --argjson v "$value" '.monitors[$k].vrr = $v' <<<"$config")
      ;;
    enabled)
      [[ $value == "true" || $value == "false" ]] || usage
      if [[ $value == "false" ]]; then
        local others
        others=$(status | jq --arg k "$key" '[.monitors[] | select(.key != $k and .enabled)] | length')
        ((others > 0)) || { echo "Keep at least one monitor on" >&2; exit 1; }
      fi
      config=$(jq -c --arg k "$key" --argjson v "$value" '.monitors[$k].enabled = $v' <<<"$config")
      ;;
    *) usage ;;
  esac

  write_files "$config"
  status
}

forget() {
  local key config
  key=$(resolve_key "${1:-}")
  config=$(saved | jq -c --arg k "$key" 'del(.monitors[$k])')
  write_files "$config"
  status
}

case "${1:-}" in
  status) status ;;
  set) set_value "${2:-}" "${3:-}" "${4:-}" ;;
  forget) forget "${2:-}" ;;
  *) usage ;;
esac
