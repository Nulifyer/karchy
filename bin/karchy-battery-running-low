#!/bin/bash

# karchy:summary=Succeed when the computer runs on a battery at or under the first battery warning level
# karchy:hidden=true

# The one test of "the battery is low" for what follows from it: Power saver
# (karchy-powerprofiles-set, with `battery.saver` on) and no screensaver
# (karchy-launch-screensaver). The level is the first battery warning that is
# on: `battery.low` in shell.json, or `battery.critical` when the low warning
# is off (0) or not above it. The levels are read as the shell reads them for
# the warnings themselves (BatteryModel.js `warningThresholds`); keep the two
# in step. With both warnings off the battery is never low.
#
# Exits 0 when low, 1 when not: plugged in, no battery that powers the
# machine, above the level, or a charge that can't be read.

(( $# == 0 )) || { echo "Usage: karchy-battery-running-low" >&2; exit 2; }

[[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]] || exit 1

# shellcheck source=bin/karchy-shell-config
level=$(source karchy-shell-config 2>/dev/null && effective_config 2>/dev/null | jq -r '
  def percent($fallback):
    (if type == "string" then (tonumber? // null) else . end)
    | if type == "number" then (if . < 0 then 0 elif . > 100 then 100 else floor end) else $fallback end;
  (.battery | if type == "object" then . else {} end) as $battery
  | ($battery.low | percent(15)) as $low | ($battery.critical | percent(5)) as $critical
  | if $critical >= $low then $critical else $low end') || exit 1
[[ $level =~ ^[0-9]+$ ]] && (( level > 0 )) || exit 1

# A battery that powers the machine, as the shell counts one, and its charge.
reading=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice \
  org.freedesktop.UPower.Device Type PowerSupply IsPresent Percentage 2>/dev/null | tr '\n' ' ') || exit 1
[[ $reading =~ ^u\ 2\ b\ true\ b\ true\ d\ ([0-9]+(\.[0-9]+)?)\ $ ]] || exit 1
percent=$(LC_ALL=C printf '%.0f' "${BASH_REMATCH[1]}")
(( percent <= level ))
