#!/bin/bash

# karchy:summary=List, add, change and remove this computer's accounts, and set automatic login (Settings › Users)
# karchy:args=[status | add <name> admin|standard [full name] | remove <name> | full-name <name> [full name] | role <name> admin|standard | reset-password <name> | autologin on|off | password]
# karchy:examples=karchy settings users | karchy-settings-users status | karchy-settings-users add sam standard "Sam Example" | karchy-settings-users remove sam
# karchy:hidden=true

# The page's side of Settings › Users. Nothing here runs as root: every
# change goes to /usr/lib/karchy/users-settings through pkexec, which asks
# for an administrator's password each time. That helper owns the rules (what
# a name may be, who can't be removed, when automatic login is allowed); this
# asks it to judge a change first, as you, so a change it would refuse says
# why without asking for a password.
#
#   (nothing)           Open the Settings window at Users
#   status              JSON: you, whether you are an administrator, whether
#                       the disk is encrypted, automatic login (on, for whom,
#                       pending: asked for and waiting for a login, why it
#                       can't be turned on), keyringPassword (keyrings open
#                       with the login password here), each person (name, full
#                       name, administrator, signed in, why they can't be
#                       removed or change role)
#   add                 A new account; "admin" is an administrator (group
#                       wheel). The password is one line on stdin, or asked
#                       for at a terminal. On an encrypted computer, adding
#                       the second person turns automatic login off and
#                       prints "autologin=off"
#   remove              Removes the account and its data: /home/<name> with
#                       everything in it is deleted for good
#   full-name, role     Another person's shown name, or administrator or not
#   reset-password      Another person's password (stdin or the terminal).
#                       Where the login screen asks for passwords, their
#                       saved passwords (the keyring) stay locked with the
#                       old one; they reset them with `karchy-keyring reset`
#                       or in Settings › Security (D-142)
#   autologin on|off    On an encrypted computer with one person: start the
#                       desktop after the disk password, or show the login
#                       screen. Applies at the next start. Off locks saved
#                       passwords with the login password from that person's
#                       next login. On prints "autologin=pending" when it has
#                       to wait for their next login at the login screen,
#                       where saved passwords get a key of this computer
#                       instead (D-142)
#   password            Change your own password (passwd)
#
# Passwords are never arguments: argv can be read by every user.

set -euo pipefail

HELPER=/usr/lib/karchy/users-settings

# Messages here are shown on the Settings page as they are.
fail() {
  echo "$1" >&2
  exit "${2:-1}"
}

usage() {
  sed -n 's/^# karchy:args=/Usage: karchy-settings-users /p' "$0" >&2
  exit 1
}

[[ -x $HELPER ]] || fail "$HELPER is missing; update karchy-settings."

# The helper judges the change as you first; then pkexec runs it, with this
# command's stdin (a password) and output. pkexec exits 126 when the
# password prompt is closed and 127 when the request isn't authorized.
as_root() {
  local reason code=0
  reason=$("$HELPER" check "$@" 2>&1 >/dev/null) || code=$?
  ((code == 0)) || fail "${reason#users-settings: }" "$code"
  exec pkexec "$HELPER" "$@"
}

case "${1:-}" in
  "") exec karchy-settings users ;;
  status)
    (($# == 1)) || usage
    exec "$HELPER" status
    ;;
  add | remove | full-name | role | reset-password | autologin) as_root "$@" ;;
  password)
    (($# == 1)) || usage
    exec passwd
    ;;
  *) usage ;;
esac
