#!/bin/bash

# karchy:summary=Enable a shell plugin
# karchy:group=plugin
# karchy:args=<id> [placement]
# karchy:examples=karchy plugin enable karchy.microphone --after karchy.audio

set -euo pipefail

fail() {
  echo "karchy-plugin-enable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: karchy plugin enable <id> [placement]"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"
shift

section=""
index=""
before=""
after=""
if (( $# > 0 )) && [[ $1 != --* ]]; then
  section="$1"
  shift
fi
while (( $# > 0 )); do
  case "$1" in
    --section)
      [[ -z $section ]] || fail "specify a section positionally or with --section, not both"
      section="${2:-}"
      [[ -n $section ]] || fail "--section requires a section"
      shift 2
      ;;
    --index)
      index="${2:-}"
      [[ -n $index ]] || fail "--index requires an index"
      shift 2
      ;;
    --before)
      before="${2:-}"
      [[ -n $before ]] || fail "--before requires a widget id"
      shift 2
      ;;
    --after)
      after="${2:-}"
      [[ -n $after ]] || fail "--after requires a widget id"
      shift 2
      ;;
    *)
      fail "unknown placement option: $1"
      ;;
  esac
done

[[ -z $section || $section =~ ^(left|centerBegin|center|centerEnd|tray|right)$ ]] ||
  fail "section must be left, centerBegin, center, centerEnd, tray, or right"
[[ -z $index || $index =~ ^[0-9]+$ ]] ||
  fail "index must be a non-negative integer"
[[ -z $before || -z $after ]] || fail "use only one of --before or --after"

placement=$(jq -cn \
  --arg section "$section" \
  --arg index "$index" \
  --arg before "$before" \
  --arg after "$after" '
    {}
    + (if $section == "" then {} else {section: $section} end)
    + (if $index == "" then {} else {index: ($index | tonumber)} end)
    + (if $before == "" then {} else {before: $before} end)
    + (if $after == "" then {} else {after: $after} end)
  ')

result=$(karchy-shell shell enablePlugin "$id" "$placement")
# A plugin its package installed a moment ago (Quick install) is unknown until
# the shell scans again; the scan takes well under a second.
if [[ $result == "unknown" || $result == "not ready" ]]; then
  karchy-shell shell rescanPlugins >/dev/null
  for _ in {1..20}; do
    sleep 0.25
    result=$(karchy-shell shell enablePlugin "$id" "$placement")
    [[ $result == "unknown" || $result == "not ready" ]] || break
  done
fi
if [[ $result == "unknown" ]]; then
  fail "plugin '$id' is not known; is its package installed?"
elif [[ $result != "ok" ]]; then
  fail "$result"
fi

if [[ $placement != "{}" ]]; then
  echo "Enabled and moved $id"
else
  echo "Enabled $id"
fi
