#!/bin/bash

# karchy:summary=Toggle bar visibility without killing the Karchy shell (on hides the bar, off shows it)
# karchy:args=[toggle|on|off]
# karchy:examples=karchy toggle bar | karchy toggle bar off | karchy toggle bar on

karchy-toggle bar-off "${1:-toggle}"

# The shell's watch on the toggles directory can miss flag changes that land in
# quick succession, stranding the bar off screen until the shell restarts.
# Nudge the bar to re-read the flag; quiet best-effort so the toggle still
# works when the shell is not up.
karchy-shell -q karchy.bar syncHidden
