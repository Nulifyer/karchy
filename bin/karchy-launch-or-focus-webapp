#!/bin/bash

# karchy:summary=Launch or focus on a given web app identified by the window-pattern.
# karchy:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: karchy-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="karchy-launch-webapp $@"

exec karchy-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
