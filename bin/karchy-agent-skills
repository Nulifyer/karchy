#!/bin/bash

# karchy:summary=Keep every AI coding agent's skills in ~/.agents/skills, with karchy's skills in it
# karchy:args=[status | --move | --no-move | keep <folder> | share <folder>]
# karchy:examples=karchy agent skills | karchy agent skills status | karchy agent skills keep ~/.claude/skills | karchy agent skills share ~/.claude/skills

# ~/.agents/skills is the one real skills folder for AI coding agents, and
# every skill is managed there (D-115, D-168). Most agents read it
# themselves; for the ones that don't, their own skills folder is a link to
# it, so every agent sees the same skills, the user's and karchy's, with
# nothing to relink when one is added.
#
# karchy's packages ship Agent Skills (folders with a SKILL.md) in
# /usr/share/karchy/agents/skills, each in the package it describes, so an
# agent is told only about what is installed. Each is linked as
# ~/.agents/skills/<name>.
#
#   ~/.agents/skills   made if missing; one link per karchy skill.
#   Claude Code        reads only ~/.claude/skills: made a link to
#                      ~/.agents/skills, ahead of time, even before Claude
#                      Code is installed.
#   Antigravity, Kiro  (FOLDER_AGENTS below) the same link, once the agent's
#                      own config folder exists, so no folders are made for
#                      agents the user never installs.
#   Hermes             (EACH_AGENTS) manages its skills folder itself (its
#                      bundled skills, a manifest, hub state, a folder per
#                      profile), so it is never redirected: one link per
#                      karchy skill in it.
#   not touched        agents that read ~/.agents/skills themselves: Codex
#                      (its ~/.codex/skills holds its built-in skills), Gemini
#                      CLI, Pi, OpenCode, GitHub Copilot CLI, Cursor, Amp,
#                      Goose, Crush, Qwen Code, Cline, Droid, Kilo Code. A
#                      link from their own folder would show them every skill
#                      twice.
#
# Bringing a folder in. A FOLDER_AGENTS skills folder that is a real folder
# (the agent ran before karchy linked it) is brought into ~/.agents/skills:
# what it holds is moved there, then the folder is removed and made the link.
# An empty one is simply replaced by the link. Everything in it moves, hidden
# entries included: skills, links, and what isn't a skill (Claude Code's
# skill sync keeps `synced/` and `.trash/` there), so the agent keeps finding
# its own files through the link. For each entry:
#
#   karchy's own per-skill link (from before D-168)  removed; ~/.agents/skills
#                      has its own.
#   a name free in ~/.agents/skills  moved there (a rename, never a copy). A
#                      relative link is made again with an absolute target, so
#                      it still reaches the same place.
#   the same thing already there (a link to the same place, or identical
#                      content, compared with diff -r)  removed from the
#                      folder: it is in ~/.agents/skills already.
#   the name is karchy's link there, the entry is the user's  karchy's link
#                      goes and the user's entry moves in, as a skill of the
#                      user's always wins over karchy's.
#   the name is taken by something different (a clash)  both are kept: the one
#                      in ~/.agents/skills stays where it is, the folder's is
#                      moved to ~/.agents/skill-clashes/<agent>/<name> (with
#                      .2, .3... if that is taken), where no agent reads it,
#                      and a line names both to compare.
#
# Only renames move things (mv --no-copy), so nothing is copied and then
# deleted, and nothing is removed that is not already in ~/.agents/skills.
# Before anything moves, the whole folder is checked; the folder is left as
# it is, karchy's skills are linked into it one by one, and a line says why,
# when:
#
#   - it, or an entry in it, is on another filesystem than ~/.agents/skills
#     (or than ~/.agents/skill-clashes, for a clash), since a move there
#     would be a copy and a delete. Move its contents by hand, then run this
#     again.
#   - ~/.agents/skills is inside it, or it is inside ~/.agents/skills.
#
# A folder that is a link to somewhere else (the user's own arrangement), or
# a file, is left alone, and that is said once.
#
# Interrupted runs: each step is a rename or a link made next to the
# original, so an interrupted run leaves every entry in one place or the
# other, and the next run finishes the job. Runs take a lock on
# ~/.agents/skills, so the session's run and an update's don't overlap.
#
# A git repository: if ~/.agents/skills is inside one (usually ~/.agents),
# what was moved shows there as new files; the run says so and touches
# nothing of git's (no add, no commit). karchy's own links are ignored there,
# once: a marked `skills/karchy*` line is added to ~/.agents/.gitignore, or
# to .git/info/exclude when the repository has no .gitignore. The other way
# round also works: on a new machine the user can `git init` in the existing
# ~/.agents, fetch and check out their repository, since karchy's links don't
# collide with its files.
#
# What was moved is recorded in ~/.local/state/karchy/agent-skills-moved
# (folder, name, how, where it went), for the way back:
#
#   keep <folder>   gives the folder back: the link is replaced by a real
#                   folder, everything brought in from it moves back (an
#                   identical entry that was removed is copied back from
#                   ~/.agents/skills, which keeps its own), and the folder is
#                   remembered as kept (~/.local/state/karchy/agent-skills-
#                   kept): it is never brought in again, and karchy's skills
#                   are linked into it one by one. Safe to run again.
#   share <folder>  forgets that, and brings the folder in again now.
#   status          the agents' folders, then one line per karchy skill and
#                   folder: linked, missing, yours (a skill of the user's
#                   with that name), or not installed here.
#   --move          bring such a folder in. For callers that show the output
#                   to a person: karchy update, Quick install's terminal path.
#   --no-move       everything but bringing a folder in: such a folder gets
#                   karchy's skills one by one for now, and a line says it
#                   waits for the next update. For runs whose output nobody
#                   sees.
#   (neither)       brings a folder in only when a terminal is attached
#                   (standard input or output is one): a person running it by
#                   hand, or an update typed in a terminal that predates
#                   --move. With no terminal it is --no-move (D-180).
#
# Moving happens only where a person sees it (D-168, D-180), and a caller
# has to ask for it: a caller that knows no option and has no terminal (a
# unit file from before --no-move, still loaded while an update replaces this
# command, or a window whose output goes to a log) moves nothing. --move is
# passed by `karchy update` (which shows each line and repeats what moved in
# its summary) and Quick install after it adds an AI app in a terminal; by
# hand, the terminal is enough. With --no-move: the session's
# karchy-agent-skills.service at login and whenever karchy's skills folder
# gains or loses a skill (karchy-agent-skills.path), karchy-feature-vms,
# Quick install's window, and the new account's setup. It changes nothing
# when everything is in place, and prints only what it changed.
#
# What it never does: replace a skill of the user's (a real folder, or a link
# that points anywhere but karchy's skills), overwrite anything, delete
# anything that isn't in ~/.agents/skills already, or touch git. The only
# links it removes are its own per-skill links, when the skill is gone (the
# package was removed) or no longer applies, and a folder link only on
# `keep`.
#
# A skill folder may hold `.requires`: commands, one per line, that must all
# be installed for the skill to be linked (karchy-vms needs QEMU, which Quick
# install adds without a karchy package).
#
# KARCHY_AGENT_SKILLS_DIR overrides where the skills are read from (tests).

set -euo pipefail

SOURCE=${KARCHY_AGENT_SKILLS_DIR:-/usr/share/karchy/agents/skills}
MAIN=$HOME/.agents/skills
CLASHES=$HOME/.agents/skill-clashes
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/karchy
RECORD=$STATE/agent-skills-moved
KEPT=$STATE/agent-skills-kept
SAID=$STATE/agent-skills-said
IGNORE_LINE='skills/karchy*'
IGNORE_COMMENT="# karchy's agent skills: links into /usr/share/karchy (karchy-agent-skills)"

# Agents that don't read ~/.agents/skills and write nothing of their own into
# their skills folder: "<config folder>:<skills folder>[:always]", under
# $HOME. The skills folder becomes a link to ~/.agents/skills once the config
# folder exists ("always": made ahead of time). Sources for each path:
# docs/architecture.md › Agent skills.
FOLDER_AGENTS=(
  ".claude:.claude/skills:always"
  ".gemini/config:.gemini/config/skills"
  ".kiro:.kiro/skills"
)
# Agents that manage their own skills folder: one link per karchy skill, once
# the folder before the colon exists. A glob is allowed.
EACH_AGENTS=(
  ".hermes:.hermes/skills"
  ".hermes/profiles/*:.hermes/profiles/*/skills"
)

say() { printf '%s\n' "$*"; }
short() { printf '%s' "${1/#"$HOME"/\~}"; }
exists() { [[ -e $1 || -L $1 ]]; }

# Say something once per key, for things that stay true until the user acts.
say_once() {
  local key=$1
  shift
  grep -qxF -- "$key" "$SAID" 2>/dev/null && return 0
  say "$*"
  mkdir -p "$STATE"
  printf '%s\n' "$key" >>"$SAID"
}

# The skills to link: every folder in SOURCE whose requirements are met.
wanted=()
find_wanted() {
  local dir requirement ok
  wanted=()
  [[ -d $SOURCE ]] || return 0
  # "$SOURCE"/* rather than */: with the slash, the C locale sorts karchy/
  # after karchy-troubleshoot/, and the order would depend on the locale.
  for dir in "$SOURCE"/*; do
    [[ -d $dir ]] || continue
    ok=true
    if [[ -f $dir/.requires ]]; then
      while read -r requirement _; do
        [[ -z $requirement || $requirement == \#* ]] && continue
        command -v "$requirement" >/dev/null 2>&1 || ok=false
      done <"$dir/.requires"
    fi
    [[ $ok == true ]] && wanted+=("${dir##*/}")
  done
  return 0
}

is_wanted() {
  local name
  for name in "${wanted[@]}"; do
    [[ $name == "$1" ]] && return 0
  done
  return 1
}

is_karchy_link() { [[ -L $1 && $(readlink "$1") == "$SOURCE"/* ]]; }

# shared, missing, folder or elsewhere: what an agent's skills folder is now.
folder_state() {
  local dir=$1
  if ! exists "$dir"; then
    echo missing
  elif [[ -d $dir && $(realpath -m "$dir") == "$(realpath -m "$MAIN")" ]]; then
    echo shared
  elif [[ -d $dir && ! -L $dir ]]; then
    echo folder
  else
    echo elsewhere
  fi
}

# ~/.claude/skills -> claude, ~/.gemini/config/skills -> gemini-config.
agent_slug() {
  local rel=${1#"$HOME"/}
  rel=${rel%/skills}
  rel=${rel#.}
  printf '%s' "${rel//\//-}"
}

is_kept() { grep -qxF -- "${1#"$HOME"/}" "$KEPT" 2>/dev/null; }

# The skills folders of the EACH_AGENTS that are installed.
each_agent_dirs() {
  local pair parent
  for pair in "${EACH_AGENTS[@]}"; do
    # Unquoted on purpose: the entry may be a glob.
    # shellcheck disable=SC2231
    for parent in $HOME/${pair%%:*}; do
      [[ -d $parent ]] || continue
      printf '%s\n' "$parent/skills"
    done
  done
}

# Same thing at both paths: a link to the same place, or identical content.
same_thing() {
  local a=$1 b=$2
  if [[ -L $a || -L $b ]]; then
    [[ $(realpath -m "$a") == "$(realpath -m "$b")" ]]
  else
    diff -rq --no-dereference "$a" "$b" >/dev/null 2>&1
  fi
}

device_of() { stat -c %d -- "$1"; }

# A free place in the clash folder for <agent>/<name>.
clash_place() {
  local base=$CLASHES/$1/$2 n=2 place
  place=$base
  while exists "$place"; do
    place=$base.$n
    n=$((n + 1))
  done
  printf '%s' "$place"
}

record() { mkdir -p "$STATE" && printf '%s\t%s\t%s\t%s\n' "${1#"$HOME"/}" "$2" "$3" "$4" >>"$RECORD"; }

# Where a link points, as an absolute path (not resolved further).
link_target() {
  local target
  target=$(readlink "$1")
  [[ $target == /* ]] || target=$(realpath -ms "${1%/*}/$target")
  printf '%s' "$target"
}

# mv's refusal to fall back to copying, where this coreutils has it (Arch's
# does). The device check in bring_in already keeps every move on one
# filesystem; this is the second guard.
MV_RENAME_ONLY=()
if mv --help 2>/dev/null | grep -q -- '--no-copy'; then MV_RENAME_ONLY=(--no-copy); fi

# Move one entry to a place that must not exist yet: a rename only. A
# relative link is made again with an absolute target at the new place, and
# the old link is removed only once the new one is there.
move_entry() {
  local from=$1 to=$2 target
  exists "$to" && return 1
  mkdir -p "${to%/*}"
  if [[ -L $from && $(readlink "$from") != /* ]]; then
    target=$(link_target "$from")
    ln -sT -- "$target" "$to" || return 1
    rm -f -- "$from"
  else
    mv "${MV_RENAME_ONLY[@]}" -nT -- "$from" "$to" || return 1
    exists "$from" && return 1
  fi
  return 0
}

# Is ~/.agents/skills inside a git work tree? Prints the tree's top.
repo_top() {
  command -v git >/dev/null 2>&1 || return 1
  git -C "$MAIN" rev-parse --show-toplevel 2>/dev/null
}

# Bring one real skills folder into ~/.agents/skills and make it the link.
# Returns 1 when the folder was left as it is. It runs under `||`, where
# errexit is off, so each step that matters checks its own result.
bring_in() {
  local dir=$1 slug main_real dev item name place top
  local -a items=() blocked=() moved=() same=() karchy=() clashes=()
  slug=$(agent_slug "$dir")
  main_real=$(realpath "$MAIN")

  if [[ $main_real == "$(realpath "$dir")"/* || $(realpath "$dir") == "$main_real"/* ]]; then
    say_once "nested:$dir" "left $(short "$dir") as it is: it and $(short "$MAIN") are inside one another, so it can't be made a link to it."
    return 1
  fi

  shopt -s nullglob dotglob
  items=("$dir"/*)
  shopt -u nullglob dotglob

  # Check everything first: only renames are safe, and they need one
  # filesystem.
  dev=$(device_of "$main_real")
  if [[ $(device_of "$dir") != "$dev" ]]; then
    blocked=("${items[@]##*/}")
  else
    for item in "${items[@]}"; do
      name=${item##*/}
      [[ $(device_of "$item") == "$dev" ]] || blocked+=("$name")
      if exists "$MAIN/$name" && ! is_karchy_link "$item" && ! same_thing "$item" "$MAIN/$name" &&
        ! is_karchy_link "$MAIN/$name"; then
        [[ $(device_of "${CLASHES%/*}") == "$dev" ]] || blocked+=("$name")
      fi
    done
  fi
  if ((${#blocked[@]} > 0)); then
    say_once "device:$dir" "left $(short "$dir") as it is: ${blocked[*]} would have to cross to another filesystem to reach $(short "$MAIN"), and karchy moves only by renaming, which can't lose anything. Move them into $(short "$MAIN") yourself, then run: karchy agent skills"
    return 1
  fi

  for item in "${items[@]}"; do
    name=${item##*/}
    if is_karchy_link "$item"; then
      rm -f -- "$item"
      karchy+=("$name")
    elif ! exists "$MAIN/$name"; then
      record "$dir" "$name" moved "$MAIN/$name" || return 1
      move_entry "$item" "$MAIN/$name" && moved+=("$name")
    elif same_thing "$item" "$MAIN/$name"; then
      # Recorded so `keep` can give it back as it was: a link as a link.
      if [[ -L $item ]]; then
        record "$dir" "$name" same-link "$(link_target "$item")" || return 1
      else
        record "$dir" "$name" same "$MAIN/$name" || return 1
      fi
      rm -rf -- "$item"
      same+=("$name")
    elif is_karchy_link "$MAIN/$name"; then
      # The user's skill wins over karchy's of the same name.
      rm -f -- "$MAIN/$name"
      record "$dir" "$name" moved "$MAIN/$name" || return 1
      move_entry "$item" "$MAIN/$name" && moved+=("$name")
    else
      place=$(clash_place "$slug" "$name")
      record "$dir" "$name" clash "$place" || return 1
      move_entry "$item" "$place" && clashes+=("$name|$place")
    fi
  done

  if ! rmdir -- "$dir" 2>/dev/null; then
    say "left $(short "$dir") a folder for now: something in it could not be moved, or appeared while this ran. Run again: karchy agent skills"
    return 1
  fi
  # A run stopped here leaves the folder missing, and the next one links it.
  ln -sr "$MAIN" "$dir" || return 1

  say "brought $(short "$dir") into $(short "$MAIN"); $(short "$dir") is now a link to it."
  ((${#moved[@]} == 0)) || say "  moved: ${moved[*]}"
  ((${#same[@]} == 0)) || say "  already there, so removed from $(short "$dir"): ${same[*]}"
  ((${#karchy[@]} == 0)) || say "  karchy's old links removed: ${karchy[*]}"
  for item in "${clashes[@]}"; do
    say "  kept both of ${item%%|*}: $(short "$MAIN/${item%%|*}") stays, and the one from $(short "$dir") is now $(short "${item#*|}"). Compare them and keep the one you want in $(short "$MAIN")."
  done
  if ((${#moved[@]} > 0)) && top=$(repo_top); then
    say "  $(short "$top") is a git repository: what moved is new there (git status shows it). Nothing was added or committed."
  fi
  say "  to undo: karchy agent skills keep $(short "$dir")"
  return 0
}

# Make the folder links, bring real folders in, and collect the folders that
# get one link per skill (`folders`).
folders=()
find_folders() {
  local move=$1 entry parent dir always
  local -a entries=()

  mkdir -p "$MAIN"
  folders=("$MAIN")
  for entry in "${FOLDER_AGENTS[@]}"; do
    IFS=: read -r parent dir always <<<"$entry"
    parent=$HOME/$parent dir=$HOME/$dir
    [[ -d $parent || $always == always ]] || continue
    if is_kept "$dir"; then
      if ! exists "$dir"; then mkdir -p "$dir"; fi
      [[ $(folder_state "$dir") == folder ]] && folders+=("$dir")
      continue
    fi
    case $(folder_state "$dir") in
      missing)
        mkdir -p "${dir%/*}"
        ln -sr "$MAIN" "$dir"
        say "linked $(short "$dir") -> $(short "$MAIN")"
        ;;
      folder)
        shopt -s nullglob dotglob
        entries=("$dir"/*)
        shopt -u nullglob dotglob
        if ((${#entries[@]} == 0)); then
          rmdir -- "$dir"
          ln -sr "$MAIN" "$dir"
          say "linked $(short "$dir") -> $(short "$MAIN")"
        elif [[ $move != true ]]; then
          say "$(short "$dir") holds files of its own; it waits for the next karchy update, which brings them into $(short "$MAIN") and makes it a link (or now: karchy agent skills)"
          folders+=("$dir")
        else
          bring_in "$dir" || folders+=("$dir")
        fi
        ;;
      elsewhere)
        if [[ -L $dir ]]; then
          say_once "elsewhere:$dir:$(readlink "$dir")" "left $(short "$dir") as it is: it is a link to $(readlink "$dir"), your own arrangement."
        else
          say_once "elsewhere:$dir" "left $(short "$dir") as it is: it is not a folder."
        fi
        ;;
    esac
  done
  while read -r dir; do
    # A link (to the main folder or anywhere else) is the user's arrangement.
    [[ -L $dir ]] && continue
    mkdir -p "$dir"
    [[ $(folder_state "$dir") == folder ]] && folders+=("$dir")
  done < <(each_agent_dirs)
  return 0
}

# linked, missing or yours: what <folder>/<name> is now.
state_of() {
  local dest=$1/$2
  if [[ -L $dest ]]; then
    if is_karchy_link "$dest"; then echo linked; else echo yours; fi
  elif [[ -e $dest ]]; then
    echo yours
  else
    echo missing
  fi
}

sync_folder() {
  local folder=$1 name dest target

  # Links of karchy's whose skill is gone or no longer applies.
  for dest in "$folder"/*; do
    is_karchy_link "$dest" || continue
    target=$(readlink "$dest")
    if [[ ! -d $target ]] || ! is_wanted "${dest##*/}"; then
      rm -f "$dest"
      say "removed $(short "$dest")"
    fi
  done

  for name in "${wanted[@]}"; do
    dest=$folder/$name
    case $(state_of "$folder" "$name") in
      missing)
        ln -s "$SOURCE/$name" "$dest"
        say "linked $(short "$dest")"
        ;;
      linked)
        if [[ $(readlink "$dest") != "$SOURCE/$name" ]]; then
          ln -sfn "$SOURCE/$name" "$dest"
          say "linked $(short "$dest")"
        fi
        ;;
      yours)
        say_once "yours:$dest" "kept $(short "$dest"): your own skill of that name, so karchy's is not linked here"
        ;;
    esac
  done
}

# Keep karchy's links out of the user's ~/.agents repository, once.
ignore_in_repo() {
  local repo=$HOME/.agents marker=$STATE/agent-skills-ignored file top

  [[ -e $repo/.git && ! -e $marker ]] || return 0
  command -v git >/dev/null 2>&1 || return 0
  top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || return 0
  [[ $(realpath -m "$top") == "$(realpath -m "$repo")" ]] || return 0

  if [[ -f $repo/.gitignore ]]; then
    file=$repo/.gitignore
  else
    file=$(git -C "$repo" rev-parse --git-path info/exclude)
    [[ $file == /* ]] || file=$repo/$file
    mkdir -p "${file%/*}"
  fi
  if ! grep -qxF -e "$IGNORE_LINE" -e "/$IGNORE_LINE" "$file" 2>/dev/null; then
    # Start on a new line when the file doesn't end with one.
    if [[ -s $file && -n $(tail -c 1 "$file") ]]; then echo >>"$file"; fi
    printf '%s\n%s\n' "$IGNORE_COMMENT" "$IGNORE_LINE" >>"$file"
    say "ignored karchy's skills in $(short "$file")"
  fi
  mkdir -p "$STATE"
  short "$file" >"$marker"
}

# One run at a time: the session's and an update's can meet.
lock() {
  mkdir -p "$MAIN"
  exec 9<"$MAIN"
  flock -w 120 9 || {
    echo "karchy-agent-skills: another run has held $(short "$MAIN") for two minutes; try again later." >&2
    exit 1
  }
}

run() {
  local move=$1 folder
  lock
  find_wanted
  find_folders "$move"
  for folder in "${folders[@]}"; do
    sync_folder "$folder"
  done
  ignore_in_repo
}

# The FOLDER_AGENTS skills folder an argument names, or nothing.
known_folder() {
  local arg=$1 entry dir
  [[ -n $arg ]] || return 1
  arg=${arg/#\~/$HOME}
  arg=$(realpath -ms -- "$arg")
  for entry in "${FOLDER_AGENTS[@]}"; do
    IFS=: read -r _ dir _ <<<"$entry"
    [[ $arg == "$HOME/$dir" ]] && { printf '%s' "$arg"; return 0; }
  done
  return 1
}

folder_usage() {
  local entry dir list=()
  for entry in "${FOLDER_AGENTS[@]}"; do
    IFS=: read -r _ dir _ <<<"$entry"
    list+=("$(short "$HOME/$dir")")
  done
  echo "karchy-agent-skills $1: name one of: ${list[*]}" >&2
  exit 2
}

# keep: give a folder back what was brought in, and leave it a folder.
keep() {
  local dir=$1 rel folder name how place ok back=() copied=() left=() rest=()
  rel=${dir#"$HOME"/}
  lock
  case $(folder_state "$dir") in
    elsewhere)
      say "left $(short "$dir") as it is: it is a link to $(readlink "$dir") or not a folder, so there is nothing to give back."
      return 1
      ;;
    shared)
      if [[ ! -L $dir ]]; then
        say "left $(short "$dir") as it is: $(short "$MAIN") is a link to it."
        return 1
      fi
      ;;
  esac
  # Remembered first, so a run meanwhile leaves the folder alone.
  if ! is_kept "$dir"; then
    mkdir -p "$STATE"
    printf '%s\n' "$rel" >>"$KEPT"
  fi
  if [[ -L $dir ]]; then rm -f -- "$dir"; fi
  mkdir -p "$dir"

  if [[ -f $RECORD ]]; then
    while IFS=$'\t' read -r folder name how place; do
      if [[ $folder != "$rel" ]]; then
        rest+=("$folder"$'\t'"$name"$'\t'"$how"$'\t'"$place")
        continue
      fi
      # Already back.
      exists "$dir/$name" && continue
      ok=true
      case $how in
        same-link)
          ln -sT -- "$place" "$dir/$name" && copied+=("$name") || ok=false
          ;;
        same)
          # Never moved: an interrupted run, or gone from ~/.agents/skills since.
          exists "$place" || continue
          cp -aT -- "$place" "$dir/$name" && copied+=("$name") || ok=false
          ;;
        *)
          exists "$place" || continue
          move_entry "$place" "$dir/$name" && back+=("$name") || ok=false
          ;;
      esac
      if [[ $ok != true ]]; then
        left+=("$name")
        rest+=("$folder"$'\t'"$name"$'\t'"$how"$'\t'"$place")
      fi
    done <"$RECORD"
    if ((${#rest[@]} > 0)); then
      printf '%s\n' "${rest[@]}" >"$RECORD.new"
      mv -f -- "$RECORD.new" "$RECORD"
    else
      rm -f -- "$RECORD"
    fi
  fi

  say "kept $(short "$dir") as a folder of its own; karchy's skills are linked into it one by one."
  ((${#back[@]} == 0)) || say "  moved back: ${back[*]}"
  ((${#copied[@]} == 0)) || say "  copied back (still in $(short "$MAIN") too): ${copied[*]}"
  ((${#left[@]} == 0)) || say "  not given back: ${left[*]} (they are still where they were brought; run keep again to retry)"
  say "  to share it again: karchy agent skills share $(short "$dir")"
  exec 9<&-
  run true
}

share() {
  local dir=$1 rel
  rel=${dir#"$HOME"/}
  if is_kept "$dir"; then
    grep -vxF -- "$rel" "$KEPT" >"$KEPT.new" || true
    mv -f -- "$KEPT.new" "$KEPT"
    [[ -s $KEPT ]] || rm -f -- "$KEPT"
  fi
  run true
}

status() {
  local entry parent dir always folder name
  find_wanted
  folders=("$MAIN")
  for entry in "${FOLDER_AGENTS[@]}"; do
    IFS=: read -r parent dir always <<<"$entry"
    dir=$HOME/$dir
    case $(folder_state "$dir") in
      shared) say "shared   $(short "$dir") -> $(short "$MAIN")" ;;
      folder)
        if is_kept "$dir"; then
          say "kept     $(short "$dir") (a folder of its own, as asked; share it with: karchy agent skills share $(short "$dir"))"
        else
          say "folder   $(short "$dir") (not brought in yet: karchy agent skills)"
        fi
        folders+=("$dir")
        ;;
      elsewhere) say "elsewhere $(short "$dir") -> $(readlink "$dir") (left alone)" ;;
    esac
  done
  while read -r dir; do
    [[ $(folder_state "$dir") == folder ]] && folders+=("$dir")
  done < <(each_agent_dirs)
  [[ -d $SOURCE ]] || return 0
  for dir in "$SOURCE"/*; do
    [[ -d $dir ]] || continue
    name=${dir##*/}
    if ! is_wanted "$name"; then
      say "not installed here  $name (needs: $(tr '\n' ' ' <"$dir/.requires" | sed 's/ *$//'))"
      continue
    fi
    for folder in "${folders[@]}"; do
      printf '%-8s %s\n' "$(state_of "$folder" "$name")" "$(short "$folder/$name")"
    done
  done
}

case ${1:-} in
  "")
    # No option: move only with a person at a terminal (see the header).
    if [[ -t 0 || -t 1 ]]; then run true; else run false; fi
    ;;
  --move) run true ;;
  --no-move) run false ;;
  status) status ;;
  keep)
    dir=$(known_folder "${2:-}") || folder_usage keep
    keep "$dir"
    ;;
  share)
    dir=$(known_folder "${2:-}") || folder_usage share
    share "$dir"
    ;;
  *)
    echo "Usage: karchy-agent-skills [status | --move | --no-move | keep <folder> | share <folder>]" >&2
    exit 2
    ;;
esac
