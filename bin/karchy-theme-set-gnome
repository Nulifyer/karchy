#!/bin/bash

# karchy:summary=Apply the current theme to GNOME color mode and icon settings
# karchy:hidden=true

# gsettings needs a user DBus session. During ISO installs this command can be
# reached from arch-chroot while applying the initial Karchy theme; defer until
# the user has a real session instead of emitting dconf warnings.
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  exit 0
fi

THEME_DIR=$HOME/.local/state/karchy/current/theme
COLORS_FILE="$THEME_DIR/colors.toml"

# karchy-theme-color resolves mode from colors.toml (`mode = "light"`), a
# legacy light.mode marker beside it, or background luminance for user themes.
mode=$(karchy-theme-color --file "$COLORS_FILE" mode)
if [[ $mode == "light" ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
  base=adw-gtk3
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
  base=adw-gtk3-dark
fi

# GTK 3 reads custom colors only at start, but reloads its whole theme when the
# theme's name changes. So the theme's colors are layered on adw-gtk3 in a
# generated theme whose name alternates on every switch, and open GTK 3 apps
# repaint at once.
themes_dir="${XDG_DATA_HOME:-$HOME/.local/share}/themes"
current=$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")
next=karchy-a
[[ $current == "karchy-a" ]] && next=karchy-b
mkdir -p "$themes_dir/$next/gtk-3.0"
{
  printf '@import url("file:///usr/share/themes/%s/gtk-3.0/gtk.css");\n' "$base"
  printf '@import url("file://%s");\n' "$THEME_DIR/gtk.css"
} >"$themes_dir/$next/gtk-3.0/gtk.css"
printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=karchy\nComment=Generated by karchy-theme-set-gnome\n' >"$themes_dir/$next/index.theme"
gsettings set org.gnome.desktop.interface gtk-theme "$next"
[[ $current == karchy-[ab] && $current != "$next" ]] && rm -rf "${themes_dir:?}/$current"

# Icons: Papirus for the mode, with its folders in the theme's accent. Papirus
# draws every folder from two blues and a dark emblem color; a small theme in
# ~/.local/share/icons holds recolored copies of just those folder icons and
# inherits the rest from Papirus-Dark or Papirus-Light. Like the GTK theme, its
# name alternates so open apps reload it. A theme's icons.theme can still name
# an installed icon theme to use instead.
icons_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
system_icons=/usr/share/icons
current_icons=$(gsettings get org.gnome.desktop.interface icon-theme | tr -d "'")
next_icons=karchy-icons-a
[[ $current_icons == "karchy-icons-a" ]] && next_icons=karchy-icons-b

remove_old_icons() {
  [[ $current_icons == karchy-icons-[ab] && $current_icons != "$1" ]] && rm -rf "${icons_dir:?}/$current_icons"
  return 0
}

override=
[[ -f $THEME_DIR/icons.theme ]] && read -r override <"$THEME_DIR/icons.theme"
if [[ -n $override && ( -d $system_icons/$override || -d $icons_dir/$override ) ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$override"
  remove_old_icons "$override"
  exit 0
fi

icons_base=Papirus-Dark
[[ $mode == "light" ]] && icons_base=Papirus-Light
if [[ ! -d $system_icons/$icons_base ]]; then
  gsettings set org.gnome.desktop.interface icon-theme Adwaita
  remove_old_icons Adwaita
  exit 0
fi

# The accent, and Papirus' own proportions for the folder back (0.8) and the
# emblem drawn on it (0.35).
accent=$(karchy-theme-color --file "$COLORS_FILE" accent)
[[ $accent =~ ^#[0-9a-fA-F]{6}$ ]] || accent="#5294e2"
shade() {
  local hex=${1#\#} factor=$2
  printf '#%02x%02x%02x' $((16#${hex:0:2} * factor / 100)) $((16#${hex:2:2} * factor / 100)) $((16#${hex:4:2} * factor / 100))
}
front=$accent
back=$(shade "$accent" 80)
emblem=$(shade "$accent" 35)

theme="$icons_dir/$next_icons"
rm -rf "$theme"
directories=()
sections=""
for size in 22 24 32 48 64 96 128; do
  dir="${size}x${size}"
  src="$system_icons/$icons_base/$dir/places"
  [[ -d $src ]] || continue

  # Every name in places that ends at one of the blue folders, through any
  # chain of links (folder.svg -> folder-blue.svg, user-home.svg ->
  # user-blue-home.svg, certificate-server.svg -> folder-locked.svg ->
  # folder-blue-locked.svg). folder-bluegrey-* is another color.
  # Only links and the blue files themselves can end there.
  declare -A link_of=()
  names=()
  mapfile -d '' -t entries < <(find "$src/" -maxdepth 1 -name '*.svg' \
    \( -type l -o -name 'folder-blue*' -o -name 'user-blue*' \) -printf '%f\0%l\0')
  for ((i = 0; i < ${#entries[@]}; i += 2)); do
    names+=("${entries[i]}")
    [[ -n ${entries[i + 1]} ]] && link_of[${entries[i]}]=${entries[i + 1]}
  done
  files=()
  links=()
  for name in "${names[@]}"; do
    end=$name
    while [[ -n ${link_of[$end]:-} && ${link_of[$end]} != */* ]]; do
      end=${link_of[$end]}
    done
    [[ $end =~ ^(folder|user)-blue(-.*)?\.svg$ ]] || continue
    if [[ -n ${link_of[$name]:-} ]]; then
      links+=("$src/$name")
    else
      files+=("$src/$name")
    fi
  done
  unset link_of
  ((${#files[@]})) || continue

  mkdir -p "$theme/$dir/places"
  cp -t "$theme/$dir/places" "${files[@]}"
  ((${#links[@]})) && cp -P -t "$theme/$dir/places" "${links[@]}"
  sed -i -e "s/#5294e2/$front/gI" -e "s/#4877b1/$back/gI" -e "s/#1d344f/$emblem/gI" "$theme/$dir/places/"{folder,user}-blue*.svg
  directories+=("$dir/places")
  sections+=$(printf '\n[%s/places]\nContext=Places\nSize=%s\nType=Fixed\n' "$dir" "$size")
  if [[ -e $system_icons/$icons_base/${dir}@2x ]]; then
    ln -s "$dir" "$theme/${dir}@2x"
    directories+=("${dir}@2x/places")
    sections+=$(printf '\n\n[%s@2x/places]\nContext=Places\nSize=%s\nScale=2\nType=Fixed\n' "$dir" "$size")
  fi
  sections+=$'\n'
done

# At 16 px Papirus draws places as symbolic icons in the text color. Without
# its own 16 px copies, this theme would answer those lookups with its colored
# 22 px folders, so the same names come along unchanged.
small="$system_icons/$icons_base/16x16/places"
if [[ -d $theme/22x22/places && -d $small ]]; then
  small_files=()
  for name in "$theme/22x22/places/"*.svg; do
    name=${name##*/}
    [[ -e $small/$name ]] && small_files+=("$small/$name")
  done
  if ((${#small_files[@]})); then
    mkdir -p "$theme/16x16/places"
    cp -L -t "$theme/16x16/places" "${small_files[@]}"
    sed -i -e "s/#5294e2/$front/gI" "$theme/16x16/places/"*.svg
    ln -s 16x16 "$theme/16x16@2x"
    directories+=("16x16/places" "16x16@2x/places")
    sections+=$'\n[16x16/places]\nContext=Places\nSize=16\nType=Fixed\n\n[16x16@2x/places]\nContext=Places\nSize=16\nScale=2\nType=Fixed\n'
  fi
fi

IFS=,
printf '[Icon Theme]\nName=karchy\nComment=Papirus folders in the theme accent, generated by karchy-theme-set-gnome\nInherits=%s,hicolor\nDirectories=%s\n%s' \
  "$icons_base" "${directories[*]}" "$sections" >"$theme/index.theme"
unset IFS
gsettings set org.gnome.desktop.interface icon-theme "$next_icons"
remove_old_icons "$next_icons"
