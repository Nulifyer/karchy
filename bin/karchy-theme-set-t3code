#!/bin/bash

# karchy:summary=Sync the generated Karchy theme to T3 Code
# karchy:hidden=true

set -euo pipefail

T3CODE_SOURCE_PATH="$HOME/.local/state/karchy/current/theme/t3code.json"
# `t3` is given the same home.
export T3CODE_HOME="${T3CODE_HOME:-$HOME/.t3}"
T3CODE_STATE_DIR="$T3CODE_HOME/userdata"
# The filename is the theme id T3 Code shows and `t3 theme set` accepts, and
# it stays stable while the colors change underneath on every theme switch.
T3CODE_THEME_ID="karchy"
T3CODE_THEMES_DIR="$T3CODE_STATE_DIR/themes"
T3CODE_THEME_PATH="$T3CODE_THEMES_DIR/$T3CODE_THEME_ID.json"
# The environment theme, `defaultTheme` here, is what `t3 theme set` writes.
T3CODE_SETTINGS_PATH="$T3CODE_STATE_DIR/settings.json"
# Where the t3code-bin package puts the app. Its `t3` command is the app run
# as Node on the server bundle inside it.
T3CODE_APP_DIR="${T3CODE_APP_DIR:-/opt/t3code-bin}"
# The desktop app's own browser data. A theme picked in Settings › Appearance
# is kept there, in the window's local storage, out of karchy's sight.
T3CODE_DESKTOP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/t3code-v2"
T3CODE_DESKTOP_V1_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/t3code"
# Written once karchy has decided whether to select the theme. After that the
# choice in T3 Code's Settings › Appearance is the user's alone.
T3CODE_OFFERED_PATH="$HOME/.local/state/karchy/t3code-theme-offered"

[[ -f $T3CODE_SOURCE_PATH ]] || exit 0

# A theme without an accent or a background leaves its placeholder unresolved.
# Publishing that would only make T3 Code reject the file, so skip instead and
# leave the previous palette in place.
if grep -q '{{' "$T3CODE_SOURCE_PATH"; then
  echo "Skipping T3 Code theme: $(basename "$T3CODE_SOURCE_PATH") has unresolved colors." >&2
  exit 0
fi

# Follow T3 Code where it has run, or where it is installed and has yet to:
# then the theme is in place for its first start. Nothing is created on a
# machine without it.
if [[ ! -d $T3CODE_STATE_DIR ]] && ! karchy-cmd-present t3code; then
  exit 0
fi

# The `t3` command, as T3 Code itself runs it: the launcher it writes into
# its home on first start, one on PATH, or the packaged app run as Node.
t3_cli() {
  if [[ -x $T3CODE_HOME/bin/t3 ]]; then
    "$T3CODE_HOME/bin/t3" "$@"
  elif command -v t3 >/dev/null; then
    t3 "$@"
  elif [[ -x $T3CODE_APP_DIR/t3code && -f $T3CODE_APP_DIR/resources/app.asar ]]; then
    ELECTRON_RUN_AS_NODE=1 "$T3CODE_APP_DIR/t3code" "$T3CODE_APP_DIR/resources/app.asar/apps/server/dist/bin.mjs" "$@"
  else
    return 127
  fi
}

# Their own choice: an environment theme set already, a theme of their own
# published, or a T3 Code window that has opened, where a theme picked in its
# Settings can't be seen from here and would be replaced once.
user_has_own_theme() {
  local file

  [[ -d $T3CODE_DESKTOP_DIR || -d $T3CODE_DESKTOP_V1_DIR ]] && return 0

  for file in "$T3CODE_THEMES_DIR"/*.json; do
    [[ -e $file && $file != "$T3CODE_THEME_PATH" ]] && return 0
  done

  [[ -f $T3CODE_SETTINGS_PATH ]] || return 1
  jq -e '(.defaultTheme // "") != ""' "$T3CODE_SETTINGS_PATH" >/dev/null
}

# Select the theme, once, for someone who has not chosen one. `t3 theme set`
# writes the settings atomically, retries when the server writes at the same
# time, and the server watches the file, so this is safe with T3 Code running.
# Each T3 Code window applies a newly set environment theme once; switching
# away in its Settings then holds, as long as nothing sets it again.
offer_theme() {
  [[ -f $T3CODE_OFFERED_PATH ]] && return 0

  # A linked settings file is kept in someone's dotfiles (D-23): `t3` would
  # replace the link with a file. One that is not JSON is not ours to repair.
  # Neither is decided for.
  [[ -L $T3CODE_SETTINGS_PATH ]] && return 0
  if [[ -f $T3CODE_SETTINGS_PATH ]] && ! jq -e 'type == "object"' "$T3CODE_SETTINGS_PATH" >/dev/null 2>&1; then
    return 0
  fi

  if ! user_has_own_theme; then
    # Not decided when `t3` can't run: the next theme change tries again.
    t3_cli theme set "$T3CODE_THEME_ID" >/dev/null 2>&1 || return 0
  fi

  mkdir -p "$(dirname "$T3CODE_OFFERED_PATH")"
  : >"$T3CODE_OFFERED_PATH"
}

# T3 Code watches this file and retints every connected client on change, so
# the write has to be atomic: a half-written file would read as invalid. It is
# skipped when nothing changed, so clients aren't made to reload for the same
# colors.
if ! cmp -s "$T3CODE_SOURCE_PATH" "$T3CODE_THEME_PATH"; then
  mkdir -p "$T3CODE_THEMES_DIR"
  tmp=$(mktemp "$T3CODE_THEME_PATH.XXXXXX")
  cp "$T3CODE_SOURCE_PATH" "$tmp"
  mv "$tmp" "$T3CODE_THEME_PATH"
fi

offer_theme
