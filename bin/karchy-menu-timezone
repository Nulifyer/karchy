#!/bin/bash

# karchy:summary=Select and set the system timezone
# karchy:group=menu
# karchy:name=timezone

set -e

timezone=$(timedatectl list-timezones | karchy-menu-select "$(karchy-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
# The Wi-Fi country follows the timezone (karchy-settings). A path unit on
# /etc/localtime misses timedatectl replacing the link, so ask directly; boot
# sets it again whenever the Wi-Fi device appears.
sudo systemctl start --no-block karchy-wifi-regdomain.service 2>/dev/null || true
karchy-shell -q karchy.clock refresh
karchy-notification-send -g timezone "$(karchy-i18n timezone.changed "$timezone")"
