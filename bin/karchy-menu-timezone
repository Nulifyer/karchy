#!/bin/bash

# karchy:summary=Select and set the system timezone
# karchy:group=menu
# karchy:name=timezone

# A picker for the timezone without the Settings window (Settings › Date &
# Time has the same choice). The change itself is karchy-settings-datetime's:
# no terminal and no sudo, the shell's password dialog asks.

current=$(timedatectl show -p Timezone --value 2>/dev/null || true)
timezone=$(karchy-settings-datetime timezones | karchy-menu-select "$(karchy-i18n timezone.setTitle)" -- --width 520 --maxheight 520 ${current:+--selected "$current"}) || exit 0
[[ -n $timezone ]] || exit 0
if ! karchy-settings-datetime timezone "$timezone" >/dev/null; then
  karchy-notification-send -g timezone "$(karchy-i18n timezone.failed "$timezone")"
  exit 1
fi
karchy-notification-send -g timezone "$(karchy-i18n timezone.changed "$timezone")"
