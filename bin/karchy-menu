#!/bin/bash

# karchy:summary=Control the Karchy menu (toggle / summon / close / refresh)
# karchy:args=[toggle|summon|close|refresh|ping] [route]
# karchy:examples=karchy menu | karchy menu toggle system | karchy menu summon restart | karchy menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `karchy.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec karchy-shell shell toggle karchy.menu "$(menu_payload "$route")" >/dev/null
    ;;
  summon)
    exec karchy-shell shell summon karchy.menu "$(menu_payload "$route")" >/dev/null
    ;;
  close)
    exec karchy-shell shell hide karchy.menu
    ;;
  refresh | ping)
    exec karchy-shell shell call karchy.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: karchy menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. restart.shell) or alias (e.g. power-menu). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "karchy-menu: unknown verb '$verb'. Try 'karchy menu --help'." >&2
    exit 2
    ;;
esac
