#!/bin/bash

# karchy:summary=Install or remove an app from the Quick install list
# karchy:args=[search] | window [search] | status | info <id> | apply install|remove <id>... | install <id> | remove <id> | open <id>
# karchy:examples=karchy quick-install install firefox | karchy quick-install status

# The list is default/karchy/quick-install.json (D-70): apps from Arch's
# repos, [cachyos], [omarchy], and well-kept AUR packages, plus karchy's own
# features, whose scripts answer status, install and remove themselves.
# The Quick install window (shell plugin karchy.quick-install) installs and
# removes through `apply` (D-109): apps from the signed repositories go
# through karchy's root helper (/usr/lib/karchy/app-packages, by catalog id,
# with the password in the shell's own prompt) and report their progress to
# the window; AUR apps and karchy's features then open in a floating
# terminal, where paru's review and build or the feature's own steps are
# visible. install and remove are those terminal steps, one app each.
#
#   [search], window [search]
#                 open the Quick install window (the default), searching for
#                 the given text, or at a category with `window @<category>`
#   status        {"installed": {"<id>": "<desktop file or empty>"}}
#   info <id>     {"download": "412 MiB", "installed": "1.9 GiB", "count": 37,
#                 "repo": "extra"}: what installing it would add, with the
#                 packages it needs that aren't here yet, and the repository
#                 pacman takes it from; for an installed app, what its own
#                 packages take ({"installed": ..., "repo": ...})
#   apply install|remove <id>...
#                 the window's action for several apps at once. Prints, one
#                 line each: "log <file>", "terminal <id>" for each app the
#                 terminal takes, then the root helper's "queued|working|
#                 done|failed <id> [reason]" lines for the rest (an install
#                 is done once its user-level setup ran too; "cancelled
#                 <id> <reason>" when the password prompt was closed), and
#                 "finished". The terminal tells the window when it is
#                 through (`finished terminal`)
#   install <id>  install the packages and apply the entry's setup:
#                 multilib    turn on Arch's 32-bit repository first
#                 gpu32       add the 32-bit graphics driver this machine needs
#                 services    system units to enable and start
#                 userServices user units to enable and start
#                 groups      groups to add you to (applies at next login)
#                 modules     kernel modules to load now; the app's package
#                             loads them at each start (DroidCam's camera)
#                 run         commands to run as you afterwards
#                 firewall    have karchy open the app's ports on trusted
#                             networks only (D-33), now and not at the next
#                             network change; remove closes them the same way
#                 A failed setup step is reported and the command fails; running
#                 install again retries the setup (pacman skips what's there)
#                 An entry's `conflicts` are packages the app can't be
#                 installed beside: install refuses while one is there,
#                 naming the app it belongs to (Docker beside karchy's Podman
#                 setup, whose podman-docker stands in for docker)
#   remove <id>   remove the app, and with it the packages that came with it
#                 and nothing else needs, after pacman confirms nothing else
#                 needs the app; apps karchy needs (`required`) can't be
#                 removed, and removing the default browser says where links
#                 open now
#
# An app that is more than one package is installed as its `karchy-app-<id>`
# package from [karchy] (D-150, packaging/pkgbuilds/karchy-apps), which
# depends on the entry's packages, so pacman knows what came with the app.
#   open <id>     start the app

set -uo pipefail

# Headlines in bold in a terminal (the floating install window); plain when
# piped or with NO_COLOR.
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then BOLD=$'\e[1m' DIM=$'\e[2m' RESET=$'\e[0m'; else BOLD="" DIM="" RESET=""; fi

CATALOG=${KARCHY_PATH:-/usr/share/karchy}/default/karchy/quick-install.json

die() {
  echo "$*" >&2
  exit 1
}

entry() {
  jq -ce --arg id "$1" '.apps[] | select(.id == $id)' "$CATALOG" 2>/dev/null || die "No app '$1' in the Quick install list."
}

field() { jq -r "$2" <<<"$1"; }

# The package that stands for an app (D-150): `karchy-app-<id>` when the app
# is more than its first package, else that package. Written the same in
# system/packages/app-packages and install/setup.sh (tests/app-packages-rule.sh).
TARGET='if (.packages | length) > 1 or .setup.gpu32 == true then "karchy-app-" + .id else .packages[0] end'

# Exact names: pacman -Q also answers for what a package provides.
installed() { [[ $(pacman -Qq -- "$1" 2>/dev/null) == "$1" ]]; }
installed_explicitly() { [[ $(pacman -Qeq -- "$1" 2>/dev/null) == "$1" ]]; }

# pacman takes one lock; say so instead of failing midway in the terminal.
pacman_free() {
  [[ ! -e /var/lib/pacman/db.lck ]] || die "Another install or update is running. Wait for it to finish, then try again."
}

refresh_window() {
  command -v karchy-shell >/dev/null && karchy-shell -q shell call karchy.quick-install finished "" >/dev/null 2>&1
  # Thunar's right-click actions follow what is installed (Open in VS Code,
  # Disktree, LocalSend).
  command -v karchy-thunar-actions >/dev/null && karchy-thunar-actions >/dev/null 2>&1
  # A code editor installed just now (VS Code, VSCodium, Cursor) gets the
  # generated "Karchy" color theme without waiting for a theme switch (D-88).
  command -v karchy-theme-set-vscode >/dev/null && karchy-theme-set-vscode >/dev/null 2>&1
  # Vesktop installed just now has the theme, turned on, before its first start.
  command -v karchy-theme-set-vesktop >/dev/null && karchy-theme-set-vesktop >/dev/null 2>&1
  # So has T3 Code, selected as its environment theme.
  command -v karchy-theme-set-t3code >/dev/null && karchy-theme-set-t3code >/dev/null 2>&1
  # The containers icon in the bar follows the engine, which may have come or
  # gone with this app (Docker, or Podman under another app).
  command -v karchy-shell >/dev/null && karchy-shell -q karchy.containers refresh >/dev/null 2>&1
  return 0
}

# An entry with `setup.firewall` has its ports opened by karchy's root helper,
# and only on trusted networks (D-33: LocalSend, KDE Connect). The helper
# opens an app's ports while the app is installed, and NetworkManager runs it
# at every connection change; running it here makes the rule follow the
# install or removal at once.
FIREWALL=/usr/bin/karchy-localsend-firewall
refresh_firewall() {
  [[ $(field "$1" '.setup.firewall // false') == true && -x $FIREWALL ]] || return 0
  sudo "$FIREWALL"
}

# Each package's launcher, for Open: "<package>\t<desktop file>". Of the
# visible desktop files a package installs, the one named after it (thunar,
# not thunar-bulk-rename; foot, not foot-server), else the first.
launchers() {
  (($#)) || return 0
  pacman -Ql "$@" 2>/dev/null |
    awk '$2 ~ "^/usr/share/applications/[^/]+[.]desktop$" { print $1 "\t" $2 }' |
    while IFS=$'\t' read -r pkg file; do
      grep -qiE '^NoDisplay=true' "$file" 2>/dev/null || printf '%s\t%s\n' "$pkg" "$file"
    done |
    awk -F'\t' '
      {
        pkg = $1; base = $2; sub(/.*\//, "", base)
        name = tolower(base); sub(/[.]desktop$/, "", name)
        stem = pkg; sub(/-(bin|git)$/, "", stem)
        tail = "." stem
        named = name == stem || (length(name) > length(tail) && substr(name, length(name) - length(tail) + 1) == tail)
        if (!(pkg in best) || (named && !won[pkg])) { best[pkg] = base; won[pkg] = named }
        if (!(pkg in order)) order[pkg] = NR
      }
      END { for (p in best) print order[p] "\t" p "\t" best[p] }
    ' | sort -n | cut -f2-
}

# The launcher of the first of these packages that has one.
desktop_of() {
  local found
  found=$(launchers "$@" | awk -F'\t' -v want="$*" '
    BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) rank[w[i]] = i }
    { if (!best || rank[$1] < bestrank) { best = $2; bestrank = rank[$1] } }
    END { if (best) print best }')
  [[ -n $found ]] || return 1
  echo "$found"
}

status() {
  local id main
  # Catalog apps that are installed, with all their packages: an app of one
  # package when that package is there; an app with a package of its own
  # (karchy-app-<id>) when that is there, or when its first package was
  # installed by hand (as a dependency of another app it isn't this app:
  # docker under WinBoat). Each one's launcher is the first of its packages
  # that has one (scrcpy for Android platform tools), from a single pacman -Ql.
  local have
  have=$(awk -F'\t' '
    FILENAME == ARGV[1] { have[$1]; next }
    FILENAME == ARGV[2] { mine[$1]; next }
    { split($3, p, " ") }
    ($2 in have) || ($2 != p[1] && p[1] in mine) { print $1 "\t" $3 }' \
    <(pacman -Qq) <(pacman -Qeq) \
    <(jq -r ".apps[] | select(.feature | not) | \"\(.id)\t\($TARGET)\t\(.packages | join(\" \"))\"" "$CATALOG"))
  {
    if [[ -n $have ]]; then
      local pkgs=()
      mapfile -t pkgs < <(cut -f2 <<<"$have" | tr ' ' '\n' | sort -u)
      awk -F'\t' '
        FILENAME == ARGV[1] { file[$1] = $2; next }
        {
          n = split($2, p, " "); found = ""
          for (i = 1; i <= n && found == ""; i++) if (p[i] in file) found = file[p[i]]
          print $1 "\t" found
        }
      ' <(launchers "${pkgs[@]}") <(printf '%s\n' "$have")
    fi
    while IFS=$'\t' read -r id main; do
      [[ $("$main" status 2>/dev/null) == installed ]] && printf '%s\t\n' "$id"
    done < <(jq -r '.apps[] | select(.feature) | "\(.id)\t\(.feature)"' "$CATALOG")
  } | jq -Rsc '{installed: (split("\n") | map(select(length > 0) | split("\t") | {(.[0]): (.[1] // "")}) | add // {})}'
}

# "412 MiB" from a count of bytes.
human_size() {
  awk -v b="${1:-0}" 'BEGIN {
    if (b >= 1073741824) printf "%.1f GiB", b / 1073741824
    else if (b >= 10485760) printf "%.0f MiB", b / 1048576
    else if (b >= 1048576) printf "%.1f MiB", b / 1048576
    else if (b > 0) printf "%.0f KiB", (b < 1024 ? 1024 : b) / 1024
  }'
}

# "86.65 MiB" on stdin to bytes.
size_bytes() {
  awk '{ printf "%.0f", $1 * ($2 == "GiB" ? 1073741824 : $2 == "MiB" ? 1048576 : $2 == "KiB" ? 1024 : 1) }'
}

# The sum of the "Installed Size" lines of pacman -Si or -Qi, in bytes.
installed_bytes() {
  awk -F': *' '/^Installed Size/ {
    split($2, v, " ")
    s += v[1] * (v[2] == "GiB" ? 1073741824 : v[2] == "MiB" ? 1048576 : v[2] == "KiB" ? 1024 : 1)
  } END { printf "%.0f", s }'
}

# An app that isn't installed: everything pacman would install for it, its
# dependencies that aren't here yet included, which is what the download and
# the disk space come to (Steam is 2 MiB by itself and far more with its
# 32-bit libraries). An installed app: what its own packages take now. For an
# AUR app, the part that comes from the repositories.
info() {
  local app main target repo="" pkg plan names=() want=() extra=() missing=() bytes
  app=$(entry "$1") || exit 1
  [[ -z $(field "$app" '.feature // empty') ]] || { echo '{}'; return; }
  main=$(field "$app" '.packages[0]')
  target=$(field "$app" "$TARGET")
  if [[ $(field "$app" .source) == aur ]]; then
    [[ $target != "$main" ]] || { echo '{}'; return; }
  else
    repo=$(LC_ALL=C pacman -Si -- "$main" 2>/dev/null | sed -n 's/^Repository *: //p' | head -n1)
  fi
  if installed "$target" || { [[ $main != "$target" ]] && installed_explicitly "$main"; }; then
    while read -r pkg; do
      installed "$pkg" && names+=("$pkg")
    done < <(field "$app" '.packages[]')
    ((${#names[@]})) || { echo '{}'; return; }
    bytes=$(LC_ALL=C pacman -Qi -- "${names[@]}" 2>/dev/null | installed_bytes)
    jq -cn --arg i "$(human_size "$bytes")" --arg r "$repo" '{installed: $i, repo: $r}'
    return
  fi
  want=("$target")
  if [[ $(field "$app" '.setup.gpu32 // false') == true ]]; then
    mapfile -t extra < <(gpu32_packages)
    ((${#extra[@]})) && mapfile -t missing < <(pacman -T -- "${extra[@]}")
    want+=("${missing[@]}")
  fi
  # No root and no lock: pacman only says what it would do. It can't while
  # the app needs Arch's 32-bit repository and that is still off (Lutris,
  # Steam on a fresh machine): then the app's first package alone, if pacman
  # knows it, and said as that.
  if ! plan=$(pacman -Sp --print-format '%r/%n %s' -- "${want[@]}" 2>/dev/null) || [[ -z $plan ]]; then
    local alone
    [[ $(field "$app" .source) != aur ]] && alone=$(LC_ALL=C pacman -Si -- "$main" 2>/dev/null) || { echo '{}'; return; }
    jq -cn --arg d "$(human_size "$(sed -n 's/^Download Size *: //p' <<<"$alone" | head -n1 | size_bytes)")" \
      --arg i "$(human_size "$(sed -n 's/^Installed Size *: //p' <<<"$alone" | head -n1 | size_bytes)")" --arg r "$repo" --arg a "$main" \
      '{download: $d, installed: $i, repo: $r, alone: $a}'
    return
  fi
  mapfile -t names < <(cut -d' ' -f1 <<<"$plan")
  bytes=$(LC_ALL=C pacman -Si -- "${names[@]}" 2>/dev/null | installed_bytes)
  # The app's own package (karchy-app-<id>) has no files and isn't counted.
  jq -cn --arg d "$(human_size "$(awk '{ s += $2 } END { printf "%.0f", s }' <<<"$plan")")" \
    --arg i "$(human_size "$bytes")" --arg r "$repo" \
    --argjson n "$(grep -cv '/karchy-app-' <<<"$plan")" \
    '{download: $d, installed: $i, repo: $r, count: $n}'
}

# The 32-bit graphics driver games need, for the GPUs in this machine. Every
# GPU gets a Vulkan driver by name: left to pacman, Steam's lib32-vulkan-driver
# and vulkan-driver go to the first package that provides them, which is an
# old NVIDIA driver (lib32-nvidia-390xx-utils) on any machine.
gpu32_packages() {
  local dev vendor
  local nvidia chosen pkg
  # pacman -Qq answers with the package that provides the name, and
  # nvidia-580xx-utils provides nvidia-utils (D-69): compare exact names.
  nvidia=$(pacman -Qq nvidia-utils 2>/dev/null)
  chosen=$(
    case $nvidia in
      nvidia-580xx-utils) echo lib32-nvidia-580xx-utils ;;
      nvidia-utils) echo lib32-nvidia-utils ;;
    esac
    for dev in /sys/bus/pci/devices/*; do
      [[ $(<"$dev/class") == 0x03* ]] 2>/dev/null || continue
      vendor=$(<"$dev/vendor")
      case $vendor in
        0x1002) echo lib32-mesa lib32-vulkan-radeon ;;
        0x8086) echo lib32-mesa lib32-vulkan-intel ;;
        # NVIDIA on nouveau.
        0x10de) [[ -n $nvidia ]] || echo lib32-mesa lib32-vulkan-nouveau ;;
        # A virtual machine's virtio GPU.
        0x1af4) echo lib32-mesa lib32-vulkan-virtio ;;
      esac
    done
  )
  # Any other GPU: Mesa's 32-bit OpenGL and its software Vulkan.
  [[ $chosen == *lib32-vulkan-* || $chosen == *lib32-nvidia-* ]] || chosen+=" lib32-mesa lib32-vulkan-swrast"
  # karchy installs the 64-bit Vulkan driver for AMD, Intel and NVIDIA's own
  # driver; where there is none, the 32-bit one's twin comes along.
  if ! pacman -Qq vulkan-driver >/dev/null 2>&1; then
    for pkg in $chosen; do
      [[ $pkg == lib32-vulkan-* ]] && chosen+=" ${pkg#lib32-}"
    done
  fi
  tr ' ' '\n' <<<"$chosen" | grep . | sort -u
}

install_app() {
  local app name feature target pkgs=() aur=() extra=() missing=() sync=-S unit group module cmd failed=()
  app=$(entry "$1") || exit 1
  name=$(field "$app" .name)
  feature=$(field "$app" '.feature // empty')
  if [[ -n $feature ]]; then
    "$feature" install
    local code=$?
    refresh_window
    return $code
  fi
  mapfile -t pkgs < <(field "$app" '.packages[]')
  ((${#pkgs[@]})) || die "$name lists no packages."
  target=$(field "$app" "$TARGET")
  pacman_free

  # Packages the entry says the app can't be installed beside (the root
  # helper has the same check and the reason for it).
  local other owner
  while read -r other; do
    [[ -n $other ]] && installed "$other" || continue
    owner=$(jq -r --arg p "$other" '[.apps[] | select(.packages | index($p)) | .name][0] // empty' "$CATALOG")
    die "$name can't be installed beside ${owner:-$other}${owner:+ ($other)}. Remove that first. Nothing was changed."
  done < <(field "$app" '.conflicts[]? // empty')

  if [[ $(field "$app" '.multilib // false') == true ]]; then
    if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
      echo "$name needs Arch's 32-bit packages ([multilib]). Turning that repository on."
      sudo sed -i '/^#\[multilib\]$/,/^#Include/ s/^#//' /etc/pacman.conf || die "Couldn't edit /etc/pacman.conf. Nothing was installed."
      grep -q '^\[multilib\]' /etc/pacman.conf || die "/etc/pacman.conf has no [multilib] section to turn on. Nothing was installed."
    fi
    # Until its package list is downloaded, which a full update does (Arch
    # needs that after adding a repository); also after an earlier attempt
    # turned it on but stopped before syncing.
    if [[ ! -e /var/lib/pacman/sync/multilib.db ]]; then
      echo "The system is updated in the same step, as Arch requires after adding a repository."
      echo "If you stop that update, run 'karchy update' before installing anything else."
      sync=-Syu
    fi
  fi

  printf '%s%s%s %s\n' "$BOLD" "Installing $name" "$RESET" "${pkgs[*]}"
  # This machine's 32-bit graphics drivers first, as dependencies: the app's
  # package depends on the names they provide (lib32-vulkan-driver), which
  # pacman would otherwise give to the first package that has them. As
  # dependencies they go again with the last app that needs them. One that is
  # installed already keeps its reason.
  if [[ $(field "$app" '.setup.gpu32 // false') == true ]]; then
    mapfile -t extra < <(gpu32_packages)
    ((${#extra[@]})) && mapfile -t missing < <(pacman -T -- "${extra[@]}")
    if ((${#missing[@]})); then
      echo "Adding the 32-bit graphics driver for this machine: ${missing[*]}"
      sudo pacman --color auto "$sync" --needed --asdeps --noconfirm -- "${missing[@]}" || {
        [[ $sync != -S ]] || karchy-pkg-install-failed
        die "$name wasn't installed."
      }
      sync=-S
    fi
  fi
  if [[ $(field "$app" .source) == aur ]]; then
    # The app itself is built here and stays the user's own package, with any
    # other package of the entry that only the AUR has (`aur`: DroidCam's
    # kernel module); what it needs from the repositories comes with its
    # karchy-app package.
    printf '%s%s%s\n' "$DIM" "From the AUR: built on this computer from a community-maintained script." "$RESET"
    mapfile -t aur < <(field "$app" '(.aur // [.packages[0]])[]')
    paru --color auto "$sync" --needed "${aur[@]}" || die "$name wasn't installed."
    sync=-S
    [[ $target == "${pkgs[0]}" ]] && target=""
  fi
  if [[ -n $target ]]; then
    # The window's Install is the confirmation; pacman still lists what it
    # installs (user 2026-11-15). paru keeps its own prompts for the AUR.
    sudo pacman --color auto "$sync" --needed --noconfirm -- "$target" || {
      [[ $sync != -S ]] || karchy-pkg-install-failed
      die "$name wasn't installed."
    }
    # Asked for by name, so it is the user's: a copy that came as another
    # app's dependency (pnpm with Node.js) would otherwise go with that app.
    installed_explicitly "$target" || sudo pacman -D --asexplicit -- "$target" >/dev/null
  fi

  while read -r unit; do
    [[ -z $unit ]] || sudo systemctl enable --now "$unit" || failed+=("turning on $unit")
  done < <(field "$app" '.setup.services[]? // empty')
  while read -r unit; do
    [[ -z $unit ]] || systemctl --user enable --now "$unit" || failed+=("turning on $unit for you")
  done < <(field "$app" '.setup.userServices[]? // empty')
  while read -r group; do
    [[ -n $group ]] || continue
    getent group "$group" >/dev/null || { failed+=("adding you to the $group group (it doesn't exist)"); continue; }
    id -nG "$USER" | tr ' ' '\n' | grep -qxF "$group" && continue
    if sudo usermod -aG "$group" "$USER"; then
      echo "Added you to the $group group; it applies after you sign in again."
    else
      failed+=("adding you to the $group group")
    fi
  done < <(field "$app" '.setup.groups[]? // empty')
  # Loaded now; the app's own package loads them at each start. A kernel that
  # was updated since this start has no modules to load until the next one.
  while read -r module; do
    [[ -z $module ]] || sudo modprobe -- "$module" || failed+=("loading the $module kernel module (it may need a restart)")
  done < <(field "$app" '.setup.modules[]? // empty')
  while read -r cmd; do
    [[ -z $cmd ]] || bash -c "$cmd" || failed+=("running $cmd")
  done < <(field "$app" '.setup.run[]? // empty')
  # A coding agent installed just now sees the skills on its first run
  # (karchy-agent-skills links them into the folder that agent reads).
  if [[ $(field "$app" '.category // empty') == ai ]]; then karchy-agent-skills || true; fi
  refresh_firewall "$app" || failed+=("opening its ports on trusted networks")

  local note
  note=$(field "$app" '.setup.note // empty')
  [[ -n $note ]] && { echo; echo "$note"; }
  refresh_window
  if ((${#failed[@]})); then
    echo
    echo "$name is installed, but part of its setup didn't finish:"
    printf '  - %s\n' "${failed[@]}"
    echo "Run 'karchy quick-install install $1' to try the setup again."
    karchy-notification-send -u critical -g quick-install "$name's setup didn't finish" "Run karchy quick-install install $1 to try again." 2>/dev/null || true
    exit 1
  fi
  karchy-notification-send -g quick-install "$name installed" 2>/dev/null || true
}

remove_app() {
  local app name feature gone=() unit stopped=() stopped_user=()
  app=$(entry "$1") || exit 1
  name=$(field "$app" .name)
  local required
  required=$(field "$app" '.required // empty')
  [[ -z $required ]] || die "$name is part of karchy: $required. It can't be removed."
  feature=$(field "$app" '.feature // empty')
  if [[ -n $feature ]]; then
    "$feature" remove
    local code=$?
    refresh_window
    return $code
  fi
  # The app's package, which takes what came with it and nothing else needs
  # (pacman -Rns), and the app itself where it is the user's own: an app of
  # one package, an AUR app, or one installed by hand before its package.
  local target main needs by pkg
  target=$(field "$app" "$TARGET")
  main=$(field "$app" '.packages[0]')
  [[ -n $main ]] || die "$name lists no packages."
  pacman_free
  installed "$target" && gone+=("$target")
  [[ $main != "$target" ]] && installed_explicitly "$main" && gone+=("$main")
  # What else of the entry was built from the AUR, the user's own as well.
  while read -r pkg; do
    [[ -n $pkg && $pkg != "$main" ]] && installed_explicitly "$pkg" && gone+=("$pkg")
  done < <(field "$app" '.aur[]? // empty')
  # A package of its own from when the entry was several packages: [karchy]
  # dropped it, and it would hold the app in place.
  [[ $target != "karchy-app-$1" ]] && installed "karchy-app-$1" && gone+=("karchy-app-$1")
  if ((${#gone[@]} == 0)); then
    echo "$name isn't installed."
    refresh_window
    return 0
  fi
  # Ask pacman first, so a refusal leaves everything as it was. It names the
  # package that still needs this one; for an app's package, the app.
  if ! needs=$(LC_ALL=C pacman -Rs --print -- "${gone[@]}" 2>&1); then
    echo "Something installed still needs $name:"
    while read -r by; do
      [[ $by == karchy-app-* ]] && by=$(jq -r --arg id "${by#karchy-app-}" --arg by "$by" \
        '[.apps[] | select(.id == $id) | .name][0] // $by' "$CATALOG")
      echo "  $by"
    done < <(sed -n 's/.* required by \([^ ]*\)$/\1/p' <<<"$needs" | sort -u)
    die "Remove that first, then try again. Nothing was changed."
  fi
  # Units are stopped before their files go; if the removal doesn't happen
  # (a wrong password, a pacman error), they are turned back on.
  while read -r unit; do
    [[ -n $unit ]] && systemctl --user is-enabled --quiet "$unit" 2>/dev/null &&
      systemctl --user disable --now "$unit" 2>/dev/null && stopped_user+=("$unit")
  done < <(field "$app" '.setup.userServices[]? // empty')
  while read -r unit; do
    [[ -n $unit ]] && systemctl is-enabled --quiet "$unit" 2>/dev/null &&
      sudo systemctl disable --now "$unit" 2>/dev/null && stopped+=("$unit")
  done < <(field "$app" '.setup.services[]? // empty')
  printf '%s%s%s %s\n' "$BOLD" "Removing $name" "$RESET" "${gone[*]}"
  # The window asked already; pacman still lists what it removes.
  if ! sudo pacman --color auto -Rns --noconfirm -- "${gone[@]}"; then
    for unit in "${stopped_user[@]}"; do systemctl --user enable --now "$unit"; done
    for unit in "${stopped[@]}"; do sudo systemctl enable --now "$unit"; done
    die "$name wasn't removed."
  fi
  [[ $(field "$app" .category) == browsers ]] && browser_fallback
  refresh_firewall "$app" || echo "Its firewall rule stays until the network next changes."
  refresh_window
  karchy-notification-send -g quick-install "$name removed" 2>/dev/null || true
}

# After a browser is removed, say where links go now. karchy-launch-browser
# already falls back to any installed browser when the default is gone
# (karchy-cmd-default-browser), so there is nothing to change.
browser_fallback() {
  local next label=""
  next=$(karchy-cmd-default-browser 2>/dev/null)
  if [[ -n $next ]]; then
    [[ -r /usr/share/applications/$next ]] && label=$(sed -n 's/^Name=//p' "/usr/share/applications/$next" | head -n1)
    echo "Links now open in ${label:-$next}."
  else
    echo "No web browser is installed now. Install one from Quick install's Browsers."
  fi
}

open_app() {
  local app desktop pkgs=()
  app=$(entry "$1") || exit 1
  mapfile -t pkgs < <(field "$app" '.packages[]')
  desktop=$(desktop_of "${pkgs[@]}") || die "$(field "$app" .name) has no window to open; run it from a terminal."
  setsid uwsm-app -- "$desktop" >/dev/null 2>&1 &
}

[[ -r $CATALOG ]] || die "The Quick install list is missing: $CATALOG"

# The user-level part of an app's setup: user services and commands run as
# you. Prints what failed, one item per line.
user_setup() {
  local app=$1 unit cmd
  while read -r unit; do
    [[ -z $unit ]] || systemctl --user enable --now "$unit" >&2 || echo "turning on $unit for you"
  done < <(field "$app" '.setup.userServices[]? // empty')
  while read -r cmd; do
    [[ -z $cmd ]] || bash -c "$cmd" >&2 || echo "running $cmd"
  done < <(field "$app" '.setup.run[]? // empty')
  # A coding agent installed just now sees the skills on its first run. Its
  # output goes to the log, so nothing is moved here (karchy-agent-skills).
  if [[ $(field "$app" '.category // empty') == ai ]]; then karchy-agent-skills --no-move >&2 || true; fi
}

# The window's install or removal of several apps (D-109).
apply() {
  local verb=$1 id app repo=() term=() state rest problems log code=0
  shift
  [[ $verb == install || $verb == remove ]] || die "Usage: karchy-quick-install apply install|remove <id>..."
  log="${XDG_STATE_HOME:-$HOME/.local/state}/karchy/quick-install.log"
  mkdir -p "${log%/*}"
  printf '%s %s: %s\n' "$(date '+%F %T')" "$verb" "$*" >"$log"
  echo "log $log"
  for id in "$@"; do
    app=$(entry "$id" 2>/dev/null) || { echo "failed $id It isn't in the Quick install list"; continue; }
    if [[ $(field "$app" .source) == aur || -n $(field "$app" '.feature // empty') ]]; then
      term+=("$id")
      echo "terminal $id"
    else
      repo+=("$id")
    fi
  done

  if ((${#repo[@]})); then
    declare -A final=()
    while read -r state id rest; do
      [[ -n $id ]] || continue
      # pkexec's own exit status, after the helper's last line.
      [[ $state == pkexec ]] && { code=$id; continue; }
      if [[ $state == "done" && $verb == install ]]; then
        app=$(entry "$id")
        problems=$(user_setup "$app" 2>>"$log" | paste -sd, - | sed 's/,/, /g')
        [[ -z $problems ]] || { state=failed rest="Installed, but $problems didn't work"; }
      fi
      [[ $state == "done" || $state == failed ]] && final[$id]=1
      echo "$state $id${rest:+ $rest}"
    done < <(pkexec /usr/lib/karchy/app-packages "$verb" "${repo[@]}" 2>>"$log"; echo "pkexec $?")
    # Every app the helper never got to: the password prompt was closed
    # (pkexec's 126), which is the person's choice and no failure; the
    # password was refused (127); or the helper stopped early.
    for id in "${repo[@]}"; do
      [[ -z ${final[$id]:-} ]] || continue
      case $code in
        126) echo "cancelled $id the password prompt was closed" ;;
        127) echo "failed $id The password wasn't accepted; nothing was changed" ;;
        *) echo "failed $id It stopped before this app; see the log" ;;
      esac
    done
    refresh_window >/dev/null 2>&1
  fi

  if ((${#term[@]})); then
    # Ids are catalog ids ([a-z0-9.+-]), so the command line needs no quoting.
    setsid karchy-launch-floating-terminal-with-presentation \
      "for id in ${term[*]}; do karchy-quick-install $verb \"\$id\" || failed=1; done; karchy-shell -q shell call karchy.quick-install finished terminal >/dev/null 2>&1; exit \${failed:-0}" \
      >/dev/null 2>&1 </dev/null &
  fi
  echo "finished"
}

case "${1:-window}" in
  window)
    query=${2:-}
    if [[ $query == @* ]]; then
      payload=$(jq -cn --arg c "${query#@}" '{category: $c}')
    else
      payload=$(jq -cn --arg q "$query" '{query: $q}')
    fi
    karchy-shell shell summon karchy.quick-install "$payload" >/dev/null
    ;;
  status) status ;;
  info) [[ -n ${2:-} ]] || die "Usage: karchy-quick-install info <id>"; info "$2" ;;
  apply) shift; (($# >= 2)) || die "Usage: karchy-quick-install apply install|remove <id>..."; apply "$@" ;;
  install) [[ -n ${2:-} ]] || die "Usage: karchy-quick-install install <id>"; install_app "$2" ;;
  remove) [[ -n ${2:-} ]] || die "Usage: karchy-quick-install remove <id>"; remove_app "$2" ;;
  open) [[ -n ${2:-} ]] || die "Usage: karchy-quick-install open <id>"; open_app "$2" ;;
  -h | --help) sed -n 's/^# karchy:args=/Usage: karchy-quick-install /p' "$0" ;;
  -*) sed -n 's/^# karchy:args=/Usage: karchy-quick-install /p' "$0" >&2; exit 1 ;;
  # Anything else is a search: karchy quick-install steam
  *) exec "$0" window "$*" ;;
esac
