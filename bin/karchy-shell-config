#!/bin/bash

# karchy:summary=Shared helpers for editing ~/.config/karchy/shell.json (source this, don't run it).
# karchy:hidden=true

CONFIG_FILE="$HOME/.config/karchy/shell.json"
DEFAULTS_FILE="$KARCHY_PATH/karchy/shell.json"

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

refresh_shell_config() {
  if ! karchy-shell shell reloadConfig >/dev/null 2>&1; then
    karchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
  fi
}

# The config the shell runs with: the user's file laid over karchy's defaults.
# Objects merge key by key; an array or a plain value in the user's file
# replaces the default whole (jq's `*`). shell/Commons/ShellConfigModel.js is
# the shell's side of this; keep the two in step. A file that is not a JSON
# object is not read as empty, so that commit never replaces it.
effective_config() {
  if [[ -s $CONFIG_FILE ]]; then
    jq -e -s 'if (.[1] | type) == "object" then .[0] * .[1] else error("not an object") end' \
      "$DEFAULTS_FILE" "$CONFIG_FILE" 2>/dev/null || fail "$CONFIG_FILE is not valid; fix it or remove it"
  else
    jq . "$DEFAULTS_FILE"
  fi
}

# What is written back: only the keys that differ from the defaults, so the
# rest keeps following them (D-56). A key cannot be removed, only given another
# value. A full copy of the defaults from before this shrinks to its
# differences on the first commit.
# shellcheck disable=SC2016 # jq variables, not shell ones
OVERRIDES='
  def overrides($base):
    if type == "object" and ($base | type) == "object" then
      . as $cur
      | reduce keys_unsorted[] as $k ({};
          if ($base | has($k)) | not then .[$k] = $cur[$k]
          elif $cur[$k] == $base[$k] then .
          else
            ($cur[$k] | overrides($base[$k])) as $inner
            | if ($inner == {}) and ($cur[$k] | type) == "object" and ($base[$k] | type) == "object"
              then . else .[$k] = $inner end
          end)
    else . end;
'

# jq pipeline that normalizes shell.json into a well-shaped object with
# version=1, bar.layout.{left,centerBegin,center,centerEnd,right} arrays, and
# plugins array. Every mutation pipes through this so downstream jq can assume
# structure.
NORMALIZE='
  def object_or_empty: if type == "object" then . else {} end;
  def array_or_empty: if type == "array" then . else [] end;
  object_or_empty
  | .version = 1
  | .bar = (.bar | object_or_empty)
  | .bar.layout = (.bar.layout | object_or_empty)
  | .bar.layout.left = (.bar.layout.left | array_or_empty)
  | .bar.layout.centerBegin = (.bar.layout.centerBegin | array_or_empty)
  | .bar.layout.center = (.bar.layout.center | array_or_empty)
  | .bar.layout.centerEnd = (.bar.layout.centerEnd | array_or_empty)
  | .bar.layout.right = (.bar.layout.right | array_or_empty)
  | .plugins = (.plugins | array_or_empty)
'

# Apply a jq program to the effective config and atomically write what differs
# from the defaults to the user config, then refresh the running shell. Extra
# args after the program are forwarded to jq (e.g. --arg/--argjson).
_SHELL_CONFIG_TMP=""
cleanup_shell_config_tmp() {
  if [[ -n $_SHELL_CONFIG_TMP ]]; then rm -f "$_SHELL_CONFIG_TMP"; fi
}
trap cleanup_shell_config_tmp EXIT

commit() {
  local program="$1" config
  shift
  config=$(effective_config) || exit 1
  mkdir -p "$(dirname "$CONFIG_FILE")"
  _SHELL_CONFIG_TMP=$(mktemp)
  jq -S -e "$@" --slurpfile karchy_shell_defaults "$DEFAULTS_FILE" \
    "$OVERRIDES ($program) | overrides(\$karchy_shell_defaults[0]) | .version = 1" \
    <<<"$config" >"$_SHELL_CONFIG_TMP" || fail "could not update shell config"
  mv "$_SHELL_CONFIG_TMP" "$CONFIG_FILE"
  _SHELL_CONFIG_TMP=""
  refresh_shell_config
}
