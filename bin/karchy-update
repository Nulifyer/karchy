#!/bin/bash

# karchy:summary=Preview and install all updates: karchy, system packages and AUR, with one password
# karchy:args=[-y | --plan]

# karchy is delivered as pacman packages (D-51, D-61). An update:
#   1. checks without root (a copy of pacman's databases, paru for AUR, the
#      channel's release file) and shows what will change: the karchy release,
#      each package with old -> new version, the download size, and whether a
#      restart will be needed
#   2. asks once, then asks for the password once and keeps it for the whole
#      run (-y skips the question)
#   3. keyrings first, so new signing keys are known before the packages
#      signed with them
#   4. system packages (pacman -Syu; snap-pac takes snapshots before and after,
#      and karchy-settings' hooks pause Hyprland's auto-reload meanwhile)
#   5. AUR packages (paru)
#   6. config files left as .pacnew, then karchy migrations, the agent skills
#      of the installed packages (karchy-agent-skills), a desktop reload and
#      the user's post-update hook (karchy-hook);
#      at the end, the release notes and a restart offer when the kernel or
#      other boot-time parts changed
# Colors are the terminal's 16 ANSI colors, which follow the current theme,
# and NO_COLOR turns them off. Holds /run/lock/karchy-update so mirror ranking
# never runs alongside (D-29). In dev mode (/etc/karchy.conf) the checkout is
# yours: pull it yourself.
#
# --plan runs step 1 only and prints what it found as JSON, for the Updates
# window (shell plugin karchy.updates): the channel, the installed and
# available karchy release, every change with its kind (karchy, app, system,
# aur) and whether it needs a restart, the download size, and Arch news since
# the last update. It installs nothing and takes no lock. When the
# repositories can't be reached, the JSON's "error" says so.

set -euo pipefail

assume_yes=false
plan_only=false
case ${1:-} in
  -y) assume_yes=true ;;
  --plan) plan_only=true ;;
esac

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/karchy"
mkdir -p "$state_dir"

# --plan: the JSON goes to the caller's stdout (fd 3); the terminal's report
# goes nowhere.
if [[ $plan_only == "true" ]]; then
  exec 3>&1 1>/dev/null
fi

# ---------------------------------------------------------------- output style
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  bold=$'\e[1m' dim=$'\e[2m' green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m' blue=$'\e[34m' reset=$'\e[0m'
else
  bold="" dim="" green="" yellow="" red="" blue="" reset=""
fi
step_total=6
step() { printf '\n%s[%s/%s]%s %s%s%s\n' "$blue$bold" "$1" "$step_total" "$reset" "$bold" "$2" "$reset"; }
note() { printf '      %s%s%s\n' "$dim" "$*" "$reset"; }
good() { printf '      %s✓%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '      %s!%s %s\n' "$yellow" "$reset" "$*"; }
fail() { printf '\n%s✗ %s%s\n' "$red$bold" "$*" "$reset" >&2; }

# Names the step that failed, since an early one may print nothing itself.
failed_command=""
trap 'fail "The update stopped: this step failed: ${failed_command:-$BASH_COMMAND}. Fix the cause and run karchy update again. Snapshots from before the update are in the boot menu."' ERR

# ---------------------------------------------------------------------- lock
# /run/lock/karchy-update is created world-writable at boot (tmpfiles.d) and
# shared with the weekly mirror ranking; the state-dir lock is a fallback.
if [[ $plan_only != "true" ]]; then
  { exec {lock_fd}>"/run/lock/karchy-update"; } 2>/dev/null || exec {lock_fd}>"$state_dir/update.lock"
  flock -n "$lock_fd" || {
    fail "Another update is running."
    exit 1
  }
fi

# A missing file (a dev checkout has no release file) reads as unknown.
release_version() {
  sed -n 's/^VERSION=//p' /usr/share/karchy/release 2>/dev/null | head -n 1 || true
}
before=$(release_version)
channel=$(sed -n 's/^# channel=//p' /etc/pacman.d/karchy-server 2>/dev/null | head -n 1 || true)
server=$(sed -n 's/^Server *= *//p' /etc/pacman.d/karchy-server 2>/dev/null | head -n 1 || true)

# Releases and release candidates have notes on GitHub; nightly and dev
# builds don't. 0.1.0rc3 -> .../releases/tag/v0.1.0-rc.3
notes_url() {
  local version=$1 tag
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(rc[0-9]+)?$ ]] || return 0
  tag="v${version%%rc*}"
  [[ $version == *rc* ]] && tag+="-rc.${version##*rc}"
  printf 'https://github.com/Nulifyer/karchy/releases/tag/%s\n' "$tag"
}

# --plan's output. Globals: before, latest, channel, size, changes (name, new,
# old), news_tsv (date, title), and the classifiers below.
emit_plan() {
  local error=${1:-} items
  items=$(
    while IFS=$'\t' read -r name new old; do
      [[ -n $name ]] || continue
      local kind=system app="" restart=0
      if [[ -n ${aur_names[$name]:-} ]]; then
        kind=aur
      elif is_karchy "$name"; then
        kind=karchy
      elif [[ -n ${app_name[$name]:-} ]]; then
        kind=app app=${app_name[$name]}
      fi
      [[ $kind != aur && $name =~ $restart_pattern ]] && restart=1
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$new" "$old" "$kind" "$app" "$restart" "$(friendly "$name")"
    done <<<"${changes:-}" |
      jq -Rn '[inputs | split("\t") | {name: .[0], new: .[1], old: .[2], kind: .[3], app: .[4],
        restart: (.[5] == "1"), label: .[6]}]'
  )
  jq -n --arg channel "$channel" --arg installed "$before" --arg available "$latest" \
    --arg notes "$(notes_url "$latest")" --arg size "${size:-}" --arg error "$error" \
    --arg checked "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson changes "${items:-[]}" \
    --argjson news "$(jq -Rn '[inputs | select(length > 0) | split("\t") | {date: .[0], title: .[1]}]' <<<"${news_tsv:-}")" \
    --argjson retire "$(jq -n '$ARGS.positional' --args "${retire_remove[@]}")" \
    --argjson keep "$(jq -n '$ARGS.positional' --args "${retire_keep[@]}")" \
    '{checked: $checked, channel: $channel, release: {installed: $installed, available: $available, notes: $notes},
      size: $size, error: $error, changes: $changes, news: $news,
      retired: {remove: $retire, keep: $keep},
      restart: ($changes | any(.restart))}' >&3
}

printf '%skarchy update%s  %s%s, %s channel%s\n' "$bold" "$reset" "$dim" "${before:-unknown}" "${channel:-unknown}" "$reset"

# ------------------------------------------------------------ 1. check, no root
step 1 "Checking for updates"
db="${TMPDIR:-/tmp}/karchy-update-db-$UID"
# A plan reads its own copy, so it never races an update's.
[[ $plan_only == "true" ]] && db+="-plan"
latest="" size="" changes="" news_tsv=""
rc=0
repo_updates=$(CHECKUPDATES_DB="$db" checkupdates 2>/dev/null) || rc=$?
if ((rc != 0 && rc != 2)); then
  if [[ $plan_only == "true" ]]; then
    emit_plan "Couldn't reach the package repositories. Check the network and try again."
    exit 0
  fi
  fail "Couldn't reach the package repositories. Check the network and try again."
  exit 1
fi
aur_updates=$(paru -Qua 2>/dev/null || true)
# Core packages karchy has retired (karchy-package-retire): removed by this
# update when nothing needs them; kept and named when you installed one
# yourself.
retire_remove=() retire_keep=()
while read -r action name; do
  [[ $action == remove ]] && retire_remove+=("$name")
  [[ $action == keep ]] && retire_keep+=("$name")
done < <(karchy-package-retire plan 2>/dev/null || true)
declare -A aur_names=()
while read -r name _; do [[ -n $name ]] && aur_names[$name]=1; done <<<"$aur_updates"

latest=""
if [[ -n $server ]] && remote=$(curl -fsSL --max-time 15 "$server/release" 2>/dev/null); then
  latest=$(sed -n 's/^VERSION=//p' <<<"$remote" | head -n 1)
  [[ -n $before && -n $latest && $(vercmp "$latest" "$before") -gt 0 ]] || latest=""
fi

if [[ -z $repo_updates && -z $aur_updates && ${#retire_remove[@]} -eq 0 ]]; then
  if [[ $plan_only == "true" ]]; then
    is_karchy() { return 1; }
    friendly() { echo "$1"; }
    emit_plan
    karchy-update-check --quiet >/dev/null 2>&1 || true
    exit 0
  fi
  good "Everything is up to date."
  # A feature added or removed since the last run gains or loses its skill.
  karchy-agent-skills >/dev/null 2>&1 || true
  karchy-update-check --quiet >/dev/null 2>&1 || true
  exit 0
fi

# Exactly what pacman will do, read from the same database copy (no root
# needed): upgrades, packages that replace others, and new dependencies,
# which checkupdates alone doesn't list. name<TAB>new version<TAB>size.
plan=""
size=""
if [[ -n $repo_updates ]]; then
  plan=$(pacman -Sup --dbpath "$db" --logfile /dev/null --print-format '%n	%v	%s' 2>/dev/null || true)
  bytes=$(awk -F'\t' '{ s += $3 } END { print s + 0 }' <<<"$plan")
  # Nothing to say when everything is already in pacman's cache.
  if ((bytes > 0)); then size=$(numfmt --to=iec --suffix=B "$bytes" 2>/dev/null || true); fi
fi

mapfile -t karchy_names < <(pacman -Slq karchy 2>/dev/null)
is_karchy() { printf '%s\n' "${karchy_names[@]:-}" | grep -qxF "$1"; }

# Apps are packages that own a launcher entry you'd see (a .desktop file not
# hidden, and not on karchy's launcher hide list); everything else is a system
# component. The names come from the entries themselves, so nothing here needs
# a list of apps to maintain.
declare -A app_name=()
hides="$KARCHY_PATH/default/karchy/launcher.hides"
while IFS= read -r line; do
  file=${line%% is owned by *}
  owner=${line##* is owned by }
  owner=${owner%% *}
  [[ -n ${app_name[$owner]:-} ]] && continue
  grep -qiE '^(NoDisplay|Hidden)=true' "$file" && continue
  id=$(basename "$file" .desktop)
  [[ -f $hides ]] && grep -qxF "$id" "$hides" && continue
  name=$(sed -n 's/^Name=//p' "$file" | head -n 1)
  [[ -n $name ]] && app_name[$owner]=$name
done < <(pacman -Qo /usr/share/applications/*.desktop 2>/dev/null)

# Updates that only take effect after a restart, with the names people know.
restart_pattern='^(linux|linux-[a-z0-9-]+|nvidia.*|lib32-nvidia.*|mesa|lib32-mesa|systemd|glibc|linux-firmware.*|amd-ucode|intel-ucode|hyprland)$'
friendly() {
  case "$1" in
    linux | linux-*-headers | linux-[a-z]*) [[ $1 == linux-firmware* ]] && echo "Device firmware" || echo "Linux kernel" ;;
    nvidia* | lib32-nvidia*) echo "NVIDIA driver" ;;
    mesa | lib32-mesa) echo "Graphics drivers (Mesa)" ;;
    amd-ucode | intel-ucode) echo "CPU microcode" ;;
    systemd) echo "systemd" ;;
    glibc) echo "C library (glibc)" ;;
    hyprland) echo "Hyprland" ;;
    *) echo "$1" ;;
  esac
}
needs_restart=false
apps=()
system=0
declare -A notable=()
# Every planned change: name, new version, old version (or empty when new).
changes=$(
  if [[ -n $plan ]]; then
    while IFS=$'\t' read -r name new _; do
      printf '%s\t%s\t%s\n' "$name" "$new" "$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)"
    done <<<"$plan"
  fi
  if [[ -n $aur_updates ]]; then
    while read -r name old _ new; do printf '%s\t%s\t%s\n' "$name" "$new" "$old"; done <<<"$aur_updates"
  fi
)
karchy_count=0
while IFS=$'\t' read -r name new old; do
  [[ -n $name ]] || continue
  if is_karchy "$name"; then
    karchy_count=$((karchy_count + 1))
    continue
  fi
  if [[ $name =~ $restart_pattern ]]; then
    needs_restart=true
    notable[$(friendly "$name")]=1
  fi
  if [[ -n ${app_name[$name]:-} ]]; then
    apps+=("${app_name[$name]}	${old:-new}	$new")
  else
    system=$((system + 1))
  fi
done <<<"$changes"

show_summary() {
  if [[ -n $latest ]]; then
    printf '\n      %skarchy %s → %s%s\n' "$bold" "$before" "$latest" "$reset"
  elif ((karchy_count > 0)); then
    # Parts of the installed release (karchy-settings, karchy-themes…).
    printf '\n      %skarchy%s: %s updated\n' "$bold" "$reset" "$( ((karchy_count == 1)) && echo "1 package" || echo "$karchy_count packages")"
  fi
  if ((${#apps[@]} > 0)); then
    printf '\n      %sApps%s\n' "$bold" "$reset"
    printf '%s\n' "${apps[@]}" | sort -f | while IFS=$'\t' read -r name old new; do
      printf '        %-28s %s%s%s → %s\n' "$name" "$dim" "$old" "$reset" "$new"
    done
  fi
  if ((system > 0)); then
    local line="${system} system component(s)"
    if ((${#notable[@]} > 0)); then
      line+=", including $(printf '%s\n' "${!notable[@]}" | sort | paste -sd, - | sed 's/,/, /g')"
    fi
    printf '\n      %sSystem%s  %s\n' "$bold" "$reset" "$line"
  fi
  if ((${#retire_remove[@]} > 0)); then
    printf '\n      %sRemoved by karchy%s  %s %s(no longer part of karchy)%s\n' "$bold" "$reset" "${retire_remove[*]}" "$dim" "$reset"
  fi
  if ((${#retire_keep[@]} > 0)); then
    printf '\n      %sKept%s  %s %s(no longer part of karchy, but you installed it yourself)%s\n' "$bold" "$reset" "${retire_keep[*]}" "$dim" "$reset"
  fi
  [[ -n $size ]] && printf '\n      %s%s to download%s\n' "$dim" "$size" "$reset"
  if [[ $needs_restart == "true" ]]; then
    printf '      %s↻ A restart finishes this update.%s\n' "$yellow" "$reset"
  fi
}

# Every package, for anyone who wants to see them all.
show_details() {
  printf '\n      %sEvery package%s\n' "$bold" "$reset"
  while IFS=$'\t' read -r name new old; do
    [[ -n $name ]] || continue
    marker=" "
    is_karchy "$name" && marker="${blue}k${reset}"
    [[ $name =~ $restart_pattern ]] && marker="${yellow}↻${reset}"
    printf '      %s %-28s %s%s%s → %s\n' "$marker" "$name" "$dim" "${old:-new}" "$reset" "$new"
  done <<<"$changes"
  printf '\n      %sk%s karchy   %s↻%s needs a restart\n' "$blue" "$reset" "$yellow" "$reset"
}

show_summary

# Arch's news posts since the last update: the ones that need a manual step
# before or after updating are announced there (Arch Wiki, System
# maintenance). Read without root; a feed that can't be fetched is skipped.
since=$(cat "$state_dir/last-update" 2>/dev/null || true)
if [[ ! $since =~ ^[0-9]+$ ]]; then
  since=$(date -d "$(sed -n 's/^KARCHY_INSTALLED=//p' /etc/karchy/install.conf 2>/dev/null)" +%s 2>/dev/null || date -d '30 days ago' +%s)
fi
# date<TAB>title, newest first.
news_tsv=$(curl -fsSL --max-time 10 https://archlinux.org/feeds/news/ 2>/dev/null |
  awk 'BEGIN { RS = "<item>" } NR > 1 {
    t = $0; sub(/.*<title>/, "", t); sub(/<\/title>.*/, "", t)
    d = $0; sub(/.*<pubDate>/, "", d); sub(/<\/pubDate>.*/, "", d)
    print d "\t" t }' |
  while IFS=$'\t' read -r date title; do
    when=$(date -d "$date" +%s 2>/dev/null) || continue
    ((when > since)) || continue
    title=${title//&amp;/&}; title=${title//&lt;/<}; title=${title//&gt;/>}
    title=${title//&quot;/\"}; title=${title//&#39;/\'}
    printf '%s\t%s\n' "$(date -d "@$when" +%Y-%m-%d)" "$title"
  done) || true
if [[ $plan_only == "true" ]]; then
  emit_plan
  exit 0
fi
if [[ -n $news_tsv ]]; then
  printf '\n      %sArch news since your last update%s (read before updating: https://archlinux.org/news/)\n' "$yellow$bold" "$reset"
  while IFS=$'\t' read -r date title; do printf '        %s  %s\n' "$date" "$title"; done <<<"$news_tsv"
fi

# --------------------------------------------------- 2. approve, password once
if [[ $assume_yes != "true" ]]; then
  source karchy-restart-gum 2>/dev/null || true
  while :; do
    echo
    choice=$(gum choose --header "Install these updates? Keep the computer plugged in; don't turn it off." \
      "Update" "Show details" "Not now") || choice="Not now"
    case "$choice" in
      Update) break ;;
      "Show details") show_details ;;
      *) note "Nothing was changed."; exit 0 ;;
    esac
  done
fi

if ! sudo -v; then
  note "Nothing was changed."
  exit 1
fi
# Keep the password for the rest of the run (pacman, paru, hooks).
( while sleep 50; do kill -0 $$ 2>/dev/null || exit 0; sudo -n -v 2>/dev/null || exit 0; done ) &
keepalive=$!
trap 'kill "$keepalive" 2>/dev/null || true' EXIT

# pacman for the two steps that download, with a way round a mirror caught in
# the middle of a sync. pacman tries the next mirror when one lacks a package,
# but asks for its signature only where the package came from, so one such
# mirror fails the whole update (karchy-mirrors-demote says more). The first
# run is pacman as it is. Only when it fails: the downloads are asked for once
# more without a terminal, to read which mirrors failed; those go last in
# copies of the mirror lists (/etc stays as it is), and pacman runs again with
# that copy of its configuration. Up to five such tries.
pacman_sync() {
  local out conf try
  sudo pacman --color auto "$@" && return 0
  out=$(mktemp)
  conf=""
  for ((try = 1; try <= 5; try++)); do
    # Download only: what is already in the cache is not fetched again.
    sudo env LC_ALL=C pacman ${conf:+--config "$conf"} --color never --noprogressbar -w "$@" >"$out" 2>&1 || true
    [[ -z $conf ]] || rm -rf "${conf%/*}"
    conf=$(karchy-mirrors-demote --config <"$out" 2>/dev/null) || { conf=""; break; }
    warn "A mirror could not serve a package; trying the next ones"
    if sudo pacman --config "$conf" --color auto "$@"; then
      rm -rf "$out" "${conf%/*}"
      return 0
    fi
  done
  [[ -z $conf ]] || rm -rf "${conf%/*}"
  rm -f "$out"
  # For the message of the trap above, which would name "return 1".
  failed_command="sudo pacman $*"
  return 1
}

# ----------------------------------------------------------------- 3. keyrings
step 2 "Signing keys"
mapfile -t keyrings < <(awk '{ print $1 }' <<<"$repo_updates" | grep -E '^(archlinux|cachyos|omarchy|karchy)-keyring$' || true)
if ((${#keyrings[@]} > 0)); then
  pacman_sync -Sy --needed --noconfirm "${keyrings[@]}"
  good "Updated ${keyrings[*]}"
else
  good "Already current"
fi

# ---------------------------------------------------------- 4. system packages
step 3 "System packages"
if [[ -n $repo_updates ]]; then
  note "snapper takes a snapshot before and after; both appear in the boot menu"
  log_lines=$(wc -l </var/log/pacman.log 2>/dev/null || echo 0)
  pacman_sync -Syu --noconfirm
  good "System packages updated"
  # What packages printed while installing (manual steps, changed defaults)
  # scrolls past above; repeat it where it can be read. Hooks' output (the
  # snapshot numbers, initramfs builds) is logged the same way, after a
  # "running '<name>.hook'" line, and is left out.
  notices=$(tail -n +"$((log_lines + 1))" /var/log/pacman.log 2>/dev/null |
    awk '/ \[ALPM\] running .*\.hook/ { hook = 1; next }
         / \[ALPM\] / { hook = 0; next }
         !hook && sub(/^\[[^]]*\] \[ALPM-SCRIPTLET\] /, "") && NF' | head -n 40 || true)
  if [[ -n $notices ]]; then
    warn "Notes from the updated packages:"
    sed 's/^/        /' <<<"$notices"
  fi
else
  good "Nothing to update"
fi
# What karchy no longer uses goes, if nothing else needs it (pacman decides;
# never forced). One you installed yourself was never on this list.
# Asked again after the upgrade, without waiting for the plan: the release
# just installed may have retired a package (its list and the dropped
# dependency both arrive with it), and the plan read the old list.
mapfile -t removable < <(karchy-package-retire removable 2>/dev/null || true)
if ((${#removable[@]} > 0)); then
  if sudo pacman --color auto -Rn --noconfirm -- "${removable[@]}"; then
    good "Removed what karchy no longer uses: ${removable[*]}"
  else
    warn "Couldn't remove ${removable[*]}; the next update tries again"
  fi
fi
if ((${#retire_remove[@]} > 0)); then
  for name in "${retire_remove[@]}"; do
    printf '%s\n' "${removable[@]:-}" | grep -qxF -- "$name" && continue
    pacman -Qq -- "$name" >/dev/null 2>&1 && note "$name stays: another installed package still needs it"
  done
fi

# ------------------------------------------------------------- 5. AUR packages
step 4 "AUR packages"
if [[ -n $aur_updates ]]; then
  if [[ $assume_yes == "true" ]]; then
    paru --color auto -Sua --noconfirm --skipreview
  else
    # paru shows each changed build script before building it with your
    # rights; read it before you continue (Arch Wiki, AUR).
    note "paru shows what changed in each AUR package's build files; review it before you continue"
    paru --color auto -Sua
  fi
  good "AUR packages updated"
else
  good "Nothing to update"
fi

# ----------------------------------------------------- 6. config files, desktop
step 5 "Config files"
# Config files that an update could not replace because they were changed
# here: pacman leaves the new version beside them as .pacnew (or keeps the old
# one as .pacsave). Merging them is a person's call, so say so.
mapfile -t pacnew < <(pacdiff --output 2>/dev/null)
if ((${#pacnew[@]} > 0)); then
  warn "${#pacnew[@]} updated config file(s) wait beside your changed ones:"
  printf '        %s\n' "${pacnew[@]}"
  if command -v code >/dev/null; then
    note "Merge them with: DIFFPROG='code --wait --diff' pacdiff -s"
  else
    note "Review them with: DIFFPROG='diff -u' pacdiff -s"
  fi
  karchy-notification-send -g config "Config files to review" \
    "${#pacnew[@]} updated config file(s) are waiting beside your changed ones. Run: pacdiff -s" || true
else
  good "No config files to review"
fi

step 6 "Desktop"
# Migrations (karchy-migrate): one that fails is reported and tried again at
# the next update; the update itself carries on.
failed_migrations=()
while read -r result name; do
  if [[ $result == "done" ]]; then
    note "migration $name"
  else
    warn "migration $name failed; it runs again at the next update (log: $state_dir/migrations/$name.log)"
    failed_migrations+=("$name")
  fi
done < <(karchy-migrate run || true)
if ((${#failed_migrations[@]} > 0)); then
  karchy-notification-send -u critical -g update "An update step failed" \
    "${#failed_migrations[@]} karchy migration(s) failed and will run again at the next update. Logs: $state_dir/migrations" || true
fi
# Agent skills (karchy-agent-skills): a feature package this update added or
# removed gains or loses its skill in the user's agent folders.
while read -r line; do
  note "agent skills: $line"
done < <(karchy-agent-skills 2>&1 || true)
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  karchy-reload-desktop
  good "Desktop reloaded"
else
  good "Done (no desktop session to reload)"
fi
# The user's own post-update hook (~/.config/karchy/hooks/post-update and
# post-update.d/), as Omarchy runs it: as the user, with no arguments, after
# the packages, migrations and reload, while sudo still holds the password so
# a hook that calls sudo isn't asked again. A failing hook is reported and
# doesn't fail the update.
karchy-hook post-update || true
kill "$keepalive" 2>/dev/null || true
karchy-update-check --quiet >/dev/null 2>&1 || true
date +%s >"$state_dir/last-update"

# ------------------------------------------------------------------- summary
after=$(release_version)
echo
if ((${#failed_migrations[@]} > 0)); then
  printf '%s! Update complete, but %s migration(s) failed:%s\n' "$yellow$bold" "${#failed_migrations[@]}" "$reset"
  printf '    %s\n' "${failed_migrations[@]}"
  printf '  %sThey run again at the next update. Logs: %s/migrations%s\n' "$dim" "$state_dir" "$reset"
else
  printf '%s✓ Update complete%s\n' "$green$bold" "$reset"
fi
if [[ -n $after && $after != "$before" ]]; then
  printf '  karchy %s → %s\n' "$before" "$after"
  notes=$(notes_url "$after")
  [[ -z $notes ]] || printf '  %sRelease notes: %s%s\n' "$dim" "$notes" "$reset"
fi
# Packages nothing needs any more that karchy didn't retire: yours to judge.
mapfile -t orphans < <(karchy-package-retire orphans 2>/dev/null || true)
if ((${#orphans[@]} > 0)); then
  printf '  %sNo longer needed by anything (left installed): %s%s\n' "$dim" "${orphans[*]}" "$reset"
  printf '  %sRemove them with: sudo pacman -Rns %s%s\n' "$dim" "${orphans[*]}" "$reset"
fi
# The running kernel's modules are gone once its package was replaced.
if [[ ! -d /usr/lib/modules/$(uname -r) ]] || [[ $needs_restart == "true" ]]; then
  echo
  if [[ $assume_yes != "true" ]] && gum confirm --affirmative "Restart now" --negative "Later" "Restart to finish the update?"; then
    systemctl reboot
  else
    warn "Restart when convenient to finish the update."
  fi
fi
