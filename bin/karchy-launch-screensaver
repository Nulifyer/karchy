#!/bin/bash

# karchy:summary=Show the Karchy screensaver on every display, drawn by the shell
# karchy:args=[force|check]

# The shell draws the screensaver (D-184); this is what decides whether it may
# start. `check` only answers: exit 0 when it would start.

# Allow screensaver to be turned off but also force started
if karchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Not on a low battery: an animation keeps the processor and the screen busy
# for nothing. "Low" is the test Power saver uses, on battery at or under the
# first battery warning. Above it, and plugged in, the screensaver starts as
# ever; the idle cycle goes on to dim, lock and sleep either way. `force`
# still starts it.
if [[ $1 != "force" ]] && karchy-battery-running-low; then
  exit 1
fi

[[ $1 == "check" ]] && exit 0

# A locked session's lock screen draws its own.
[[ $(karchy-shell screensaver show) == "ok" ]]
