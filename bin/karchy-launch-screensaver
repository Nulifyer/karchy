#!/bin/bash

# karchy:summary=Launch the Karchy screensaver in the default terminal on the system with the correct font configuration.

# Exit early if screensaver is already running
pgrep -f '[o]rg.karchy.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if karchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Not on a low battery: an animation in a terminal keeps the processor and
# the screen busy for nothing. "Low" is the test Power saver uses, on battery
# at or under the first battery warning. Above it, and plugged in, the
# screensaver starts as ever; the idle cycle goes on to dim, lock and sleep
# either way. `force` still starts it.
if [[ $1 != "force" ]] && karchy-battery-running-low; then
  exit 1
fi

focused=$(karchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  karchy-notification-send -g ✋ "$(karchy-i18n screensaver.terminalOnly)"
  exit 1
  ;;
esac

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"

  hyprctl dispatch "hl.dsp.exec_cmd([[[workspace $workspace] $command]])" >/dev/null 2>&1 ||
    hyprctl dispatch exec -- "[workspace $workspace]" bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# Open Hyprland's event stream before spawning anything, so a terminal that maps
# quickly can't emit its openwindow event before we are listening for it.
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET")

# hypr_exec is async and a new window maps on whatever monitor is focused at that
# moment. Block until this monitor's screensaver actually opens before moving
# focus on -- otherwise slow-starting terminals all pile onto the last monitor.
# The deadline is a safety net in case the window never appears.
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.karchy.screensaver,* ]] && return 0
  done
}

hypr_show_special() {
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$1\")" >/dev/null 2>&1 || hyprctl dispatch togglespecialworkspace "$1" >/dev/null
}

# A special workspace that is showing, like the drop-down terminal, gives way
# to the screensaver's own and opens again once it is gone. Windows that open
# meanwhile are kept off the screensaver's workspace by its name (apps/system.lua).
monitors=$(hyprctl monitors -j | jq -r '.[] | "\(.name) \(.specialWorkspace.name)"')

while read -r m special; do
  hypr_focus_monitor "$m"
  workspace=special:screensaver-$m

  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.karchy.screensaver --config-file "$KARCHY_PATH/default/alacritty/screensaver.toml" -e karchy-screensaver
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.karchy.screensaver --config-file="$KARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e karchy-screensaver
    ;;
  *foot*)
    hypr_exec foot --app-id=org.karchy.screensaver --config="$KARCHY_PATH/default/foot/screensaver.ini" -e karchy-screensaver
    ;;
  *kitty*)
    hypr_exec kitty --class=org.karchy.screensaver --override font_size=18 --override window_padding_width=0 -e karchy-screensaver
    ;;
  esac

  wait_for_screensaver_window
done <<<"$monitors"

hypr_focus_monitor "$focused"

# Emptying a special workspace focuses its monitor, so the last screensaver to close would take focus
# with it. Once they are all gone, open again the special workspaces that were showing and hand focus
# back to the monitor that had it.
# The class goes through the environment, since in argv the screensaver's pgrep and pkill would match it.
(
  while hyprctl clients -j | SCREENSAVER=org.karchy.screensaver jq -e 'any(.[]; .mapped and .class == env.SCREENSAVER)' >/dev/null; do
    IFS= read -r -u "$events" line || exit
  done
  while read -r m special; do
    [[ -n $special ]] || continue
    hypr_focus_monitor "$m"
    hypr_show_special "${special#special:}"
  done <<<"$monitors"
  hypr_focus_monitor "$focused"
) >/dev/null 2>&1 &
