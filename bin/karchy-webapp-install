#!/bin/bash

# karchy:summary=Create a desktop launcher for a web app
# karchy:args=[name url icon-url-or-name [custom-exec] [mime-types]]

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
# For a site with no icon of its own (Papirus has it).
GENERIC_ICON=applications-internet

safe_icon_name() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

require_plain_name() {
  # The name becomes a filename. A slash would turn it into directory levels, so
  # the launcher lands somewhere karchy-webapp-remove cannot address and the app
  # is stuck in the launcher; a leading ../ leaves the applications directory
  # altogether. Refuse rather than silently renaming what the user typed -- most
  # often it is a URL entered in the name field.
  if [[ $1 == */* ]]; then
    echo "App name cannot contain '/': $1"
    exit 1
  fi
}

icon_name_from_ref() {
  local ref="$1"
  local name
  name=$(basename "$ref")

  if [[ $name == *.* ]]; then
    safe_icon_name "${name%.*}"
  else
    printf '%s\n' "$name"
  fi
}

install_user_icon() {
  local source="$1"
  local name="$2"
  local ext="${source##*.}"

  [[ $ext == "$source" ]] && ext="png"
  mkdir -p "$ICON_DIR"
  cp "$source" "$ICON_DIR/$name.$ext"
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  printf '%s\n' "$name"
}

download_icon() {
  curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
    [[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

# Chromium --app= treats javascript:, file:, and data: as a document to
# run. Prefix schemeless input with https as before, then refuse anything
# that is not http(s).
normalize_webapp_url() {
  local url=$1
  if [[ ! $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    url="https://$url"
  fi
  printf '%s' "$url"
}

# Raw whitespace must be percent-encoded in a URL. Refuse it before serializing
# the desktop entry; before Exec argument quoting, it also split browser flags
# and additional URLs into separate arguments. Schemes are case-insensitive.
require_http_url() {
  local url=$1

  if [[ $url =~ [[:space:]] ]]; then
    echo "Error: web app URL must not contain whitespace." >&2
    exit 1
  fi

  if [[ ! ${url,,} =~ ^https?:// ]]; then
    echo "Error: web app URL must be http or https." >&2
    exit 1
  fi
}

# Dashboard Icons (github.com/homarr-labs/dashboard-icons), the curated set
# Omarchy's web apps use: 256 px PNGs named by a slug. Try the app's name as a
# slug, then without its dashes, then the site's domain name ("github" for
# www.github.com).
fetch_dashboard_icon() {
  local name="$1" site_url="$2" dest="$3"
  local host labels slug
  host=$(sed -E 's|^https?://([^/:?#]+).*|\1|' <<<"${site_url,,}")
  IFS=. read -ra labels <<<"$host"
  local -a slugs=("$(safe_icon_name "$name")")
  slugs+=("${slugs[0]//-/}")
  [[ $host =~ [a-z] && ${#labels[@]} -ge 2 ]] && slugs+=("${labels[-2]}")
  for slug in "${slugs[@]}"; do
    [[ $slug =~ ^[a-z0-9][a-z0-9._-]*$ ]] || continue
    download_icon "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/$slug.png" "$dest" && return 0
  done
  return 1
}

fetch_site_icon() {
  local site_url="$1" dest="$2" name="$3"
  local origin page icon_url
  origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")

  # Prefer the site's own high-res icon (apple-touch-icon is typically 180px+),
  # then the well-known path, then Dashboard Icons by the app's name.
  page=$(curl -fsSL --max-time 5 "$site_url" 2>/dev/null | head -c 100000 | tr '\n' ' ')
  icon_url=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
    grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//")

  case $icon_url in
  http://* | https://*) ;;
  //*) icon_url="https:$icon_url" ;;
  /*) icon_url="$origin$icon_url" ;;
  ?*) icon_url="$origin/$icon_url" ;;
  esac

  { [[ -n $icon_url ]] && download_icon "$icon_url" "$dest"; } ||
    download_icon "$origin/apple-touch-icon.png" "$dest" ||
    fetch_dashboard_icon "$name" "$site_url" "$dest"
}

desktop_string_escape() {
  # Desktop Entry "string" value (freedesktop Desktop Entry Spec, "Value types"):
  # a raw newline would start a new key line and let a value inject a second
  # Exec=. Escape backslash first, then tab/CR/LF and a leading space. Every value
  # written into the .desktop file passes through here.
  #
  # Parameter expansion rather than sed: GNU sed's N auto-prints the pattern space
  # and exits at end of input, so a `:a;N;$!ba` slurp skips every following s///
  # for a value with no newline in it - which is every value except the injection
  # attempt this exists to stop.
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  [[ $value == " "* ]] && value="\\s${value# }"

  printf '%s' "$value"
}

desktop_exec_arg() {
  # One Exec argument, double-quoted per the freedesktop Exec spec: inside quotes
  # " ` $ \ take a backslash and a literal % becomes %%. Only the default Exec's
  # URL needs this; $CUSTOM_EXEC stays a whole command line (file-syntax only).
  local escaped
  escaped=$(printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' -e 's/%/%%/g')
  printf '"%s"' "$escaped"
}

if (( $# < 3 )); then
  # Interactive: each answer is asked again until it works, keeping what was
  # typed. Esc at any prompt closes the window (exit 130, the wrapper's cancel).
  echo -e "\e[32m$(karchy-i18n webapp.intro)\n\e[0m"
  # A problem shows as the prompt's header, so it goes once fixed.
  APP_NAME="" problem=""
  while true; do
    APP_NAME=$(gum input --header "$problem" --prompt "$(karchy-i18n tui.namePrompt)" --placeholder "$(karchy-i18n webapp.namePlaceholder)" --value "$APP_NAME") || exit 130
    if [[ -z $APP_NAME ]]; then
      problem=$(karchy-i18n webapp.nameEmpty)
    elif [[ $APP_NAME == */* ]]; then
      problem=$(karchy-i18n webapp.nameSlash)
    else
      break
    fi
  done
  APP_URL="" problem=""
  while true; do
    APP_URL=$(gum input --header "$problem" --prompt "URL> " --placeholder "https://example.com" --value "$APP_URL") || exit 130
    url=$(normalize_webapp_url "$APP_URL")
    if [[ -z $APP_URL || $url =~ [[:space:]] || ! ${url,,} =~ ^https?://[^/]+ ]]; then
      problem=$(karchy-i18n webapp.urlInvalid)
      continue
    fi
    # A mistyped address would make an app that opens nothing. Esc cancels.
    if ! curl -fsSL --max-time 8 -o /dev/null "$url" 2>/dev/null; then
      make_anyway=$(karchy-i18n webapp.makeAnyway)
      change=$(karchy-i18n webapp.changeAddress)
      choice=$(gum choose --header "$(karchy-i18n webapp.unreachable "$url")" "$change" "$make_anyway") || exit 130
      if [[ $choice != "$make_anyway" ]]; then
        problem=$(karchy-i18n webapp.checkAddress)
        continue
      fi
      unreachable=1
    fi
    APP_URL=$url
    break
  done

  # Try to fetch the site's icon automatically first.
  mkdir -p "$ICON_DIR"
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  # A site that couldn't be reached has no icon to fetch either.
  [[ -n ${unreachable:-} ]] || echo "$(karchy-i18n webapp.fetchingIcon)"
  if [[ -z ${unreachable:-} ]] && fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png" "$APP_NAME"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
    ICON_REF="$ICON_VALUE"
  else
    [[ -n ${unreachable:-} ]] || echo "$(karchy-i18n webapp.iconNotFound)"
    ICON_REF=$(gum input --prompt "$(karchy-i18n tui.iconPrompt)" --placeholder "$(karchy-i18n webapp.iconPlaceholder)") || exit 130
    [[ -n $ICON_REF ]] || ICON_REF=$GENERIC_ICON
  fi

  CUSTOM_EXEC=""
  MIME_TYPES=""
  INTERACTIVE_MODE=true
else
  APP_NAME="$1"
  APP_URL=$(normalize_webapp_url "$2")
  require_http_url "$APP_URL"
  ICON_REF="$3"
  CUSTOM_EXEC="$4" # Optional custom exec command
  MIME_TYPES="$5"  # Optional mime types
  INTERACTIVE_MODE=false
fi

# Ensure valid execution
if [[ -z $APP_NAME || -z $APP_URL ]]; then
  echo "You must set app name and app URL!"
  exit 1
fi

require_plain_name "$APP_NAME"

if [[ -z $ICON_REF ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if fetch_site_icon "$APP_URL" "$ICON_DIR/$ICON_VALUE.png" "$APP_NAME"; then
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
  else
    echo "$(karchy-i18n webapp.iconNotFound)" >&2
    ICON_VALUE=$GENERIC_ICON
  fi
elif [[ $ICON_REF =~ ^https?:// ]]; then
  ICON_VALUE=$(safe_icon_name "$APP_NAME")
  mkdir -p "$ICON_DIR"
  if ! download_icon "$ICON_REF" "$ICON_DIR/$ICON_VALUE.png"; then
    echo "Error: Failed to download icon."
    exit 1
  fi
  gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
elif [[ -f $ICON_REF ]]; then
  ICON_VALUE=$(install_user_icon "$ICON_REF" "$(safe_icon_name "$APP_NAME")")
else
  # Bundled Karchy icons are package-owned under /usr/share/icons/hicolor.
  # Accept either "HEY" or the historical "HEY.png" argument form.
  ICON_VALUE=$(icon_name_from_ref "$ICON_REF")
fi

# Default Exec quotes the URL as one Exec-spec argument; the whole line then gets
# the file-syntax escaping below (unescaped first at read time per spec, so the
# layers compose). $CUSTOM_EXEC is a full command line, so it gets file-syntax only.
if [[ -n $CUSTOM_EXEC ]]; then
  EXEC_COMMAND=$CUSTOM_EXEC
else
  EXEC_COMMAND="karchy-launch-webapp $(desktop_exec_arg "$APP_URL")"
fi

# Create application .desktop file
DESKTOP_DIR="$HOME/.local/share/applications"
DESKTOP_FILE="$DESKTOP_DIR/$APP_NAME.desktop"
mkdir -p "$DESKTOP_DIR"

name_field=$(desktop_string_escape "$APP_NAME")
exec_field=$(desktop_string_escape "$EXEC_COMMAND")
icon_field=$(desktop_string_escape "$ICON_VALUE")

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$name_field
Comment=$name_field
Exec=$exec_field
Terminal=false
Type=Application
Icon=$icon_field
StartupNotify=true
EOF

# Add mime types if provided
if [[ -n $MIME_TYPES ]]; then
  printf 'MimeType=%s\n' "$(desktop_string_escape "$MIME_TYPES")" >>"$DESKTOP_FILE"
fi

# Floating titlebars name the window after this entry rather than its page
# title, and the dock finds the entry for its windows by it. A custom Exec,
# such as HEY's mailto handler, still opens the web app at this URL.
if [[ -n $APP_URL ]]; then
  printf 'StartupWMClass=%s\n' "$(desktop_string_escape "$(karchy-webapp-window-class "$APP_URL")")" >>"$DESKTOP_FILE"
fi

chmod +x "$DESKTOP_FILE"

if [[ $INTERACTIVE_MODE == "true" ]]; then
  echo -e "You can now find $APP_NAME using the app launcher (SUPER + SPACE)\n"
fi
