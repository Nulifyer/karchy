#!/bin/bash

# karchy:summary=Read and save power settings: power mode, screen brightness, dimming and idle times on battery and plugged in, lid, power button, hibernation and battery warnings (Settings › Power)
# karchy:args=[status | set <setting> <value> | reset]
# karchy:examples=karchy settings power | karchy-settings-power status | karchy-settings-power set lock.ac 600 | karchy-settings-power set profile.battery power-saver
# karchy:hidden=true

# What Settings › Power changed is recorded in ~/.config/karchy/power.json,
# only the values that differ from karchy's defaults, and each value is written
# where the system reads it:
#
#   power mode                        the profile remembered for each power
#       source, ~/.local/state/karchy/powerprofiles/{ac,battery}, through
#       karchy-powerprofiles-set: the same two files the bar's power panel
#       writes, so both show one setting. Not recorded in power.json.
#   idle times, dimming, screen brightness and battery warnings
#                                     the `idle`, `power` and `battery` keys of
#       ~/.config/karchy/shell.json, through karchy-shell-config, one key per
#       change. That file is also the user's to edit, and the shell reads
#       nothing else, so a value changed there by hand is what runs and what
#       this command reports; Settings writes a key only when that very
#       setting is changed here.
#   power button                      ~/.local/state/karchy/hypr/power.lua,
#       which karchy's Hyprland config loads before ~/.config/hypr, so a
#       binding written there by hand wins (D-27). logind leaves the key
#       alone on karchy (10-ignore-power-button.conf), so this needs no root.
#   lid, hibernation and the nearly empty battery
#                                     /etc/systemd/logind.conf.d/60-karchy-settings.conf,
#       /etc/systemd/sleep.conf.d/60-karchy-settings.conf and
#       /etc/UPower/UPower.conf.d/60-karchy-settings.conf, written by the
#       root helper /usr/lib/karchy/power-settings through pkexec (no password
#       for the person at the computer; see the helper). Those sort after
#       karchy's packaged files (30-karchy-laptop.conf, 40-karchy-nvidia.conf,
#       UPower's 50-karchy-laptop.conf); a file there that sorts later
#       (90-mine.conf) still wins.
#
#   (nothing)              Open the Settings window at Power (as `karchy settings
#                          power` does)
#   status                 JSON: what this machine has (`battery`, `lid`,
#                          `hibernation`, `backlight`, `profiles`), each
#                          setting's value in effect (`values`), what is
#                          recorded here (`saved`), the settings something
#                          else decides (`foreign`), and the power profile
#                          running now
#   set <setting> <value>
#       profile.battery, profile.ac
#                          power-saver, balanced, performance (those this
#                          machine has). Switched to when that power source is
#                          the one in use, at once if it is now
#       brightness.battery, brightness.ac
#                          keep, or percent (1 to 100): what the built-in
#                          screen is set to when the charger goes in or out
#       screenOff.battery, screenOff.ac, lock.battery, lock.ac, sleep.battery,
#       sleep.ac           never, or seconds idle (10 to 86400). "ac" is
#                          plugged in, and the only one a desktop uses
#       dim.battery, dim.ac
#                          never, or seconds (5 to 600): the built-in screen
#                          is dimmed that long before it turns off
#       battery.low, battery.critical
#                          percent (low 5 to 50, critical 3 to 30, under low
#                          and both above empty.level)
#       battery.saver      on (karchy's default), off: Power saver from
#                          the first battery warning until the charger goes in
#       empty.level        percent (2 to 20, under the last battery
#                          warning): where a laptop left on its battery is
#                          hibernated or shut down
#       empty.action       hibernate (karchy's, where the machine can),
#                          poweroff
#       powerKey           menu, sleep, hibernate, shutdown, nothing
#       lid.battery, lid.ac, lid.docked
#                          sleep, ignore (karchy still locks the session),
#                          poweroff, hibernate
#       hibernateAfter     never, or minutes asleep (5 to 1440)
#       hibernate.ac       never (stay asleep while plugged in; the time
#                          counts from when the charger is pulled), same
#                          (hibernate after that time plugged in too)
#   reset                  Forget every choice made here

set -euo pipefail

# shellcheck source=bin/karchy-shell-config
source karchy-shell-config

POWER_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/karchy/power.json"
HYPR_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/karchy/hypr/power.lua"
# Where karchy-powerprofiles-set remembers each power source's profile.
PROFILE_DIR="${KARCHY_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/karchy/powerprofiles}"
ROOT_HELPER=/usr/lib/karchy/power-settings
POWER_KEY=XF86PowerOff

# What the power button runs for each choice, and its name among the keybindings.
declare -A POWER_KEY_COMMAND=(
  [sleep]="systemctl sleep"
  [hibernate]="systemctl hibernate"
  [shutdown]="karchy-system shutdown"
)
declare -A POWER_KEY_NAME=([sleep]="Sleep" [hibernate]="Hibernate" [shutdown]="Shut down")

# Messages here are shown on the Settings page as they are.
fail() {
  echo "$*" >&2
  exit 1
}

usage() {
  sed -n 's/^# karchy:args=/Usage: karchy-settings-power /p' "$0" >&2
  exit 1
}

saved() {
  if [[ -f $POWER_FILE ]] && jq -e '.version == 1 and (.settings | type) == "object"' "$POWER_FILE" >/dev/null 2>&1; then
    jq -c .settings "$POWER_FILE"
  else
    echo '{}'
  fi
}

write_saved() {
  local settings="$1" tmp
  # Nothing differs from the defaults any more: no file, as before the first change.
  if [[ $(jq -c . <<<"$settings") == "{}" ]]; then
    rm -f "$POWER_FILE"
    return
  fi
  mkdir -p "$(dirname "$POWER_FILE")"
  tmp=$(mktemp "$(dirname "$POWER_FILE")/.power.json.XXXXXX")
  jq -S '{version: 1, settings: .}' <<<"$settings" >"$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$POWER_FILE"
}

is() { "$@" >/dev/null 2>&1 && echo true || echo false; }

# The same answer the idle service uses: UPower's display device is a battery
# that powers the machine. A desktop, and a mouse's battery, are not.
has_battery() {
  local out
  out=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice \
    org.freedesktop.UPower.Device Type PowerSupply IsPresent 2>/dev/null | tr '\n' ' ') || return 1
  [[ $out == "u 2 b true b true " ]]
}

# The power source in use, by the signal the shell and karchy-powerprofiles-set
# follow.
source_in_use() {
  if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
    echo battery
  else
    echo ac
  fi
}

# The power profiles this machine has, most sparing first, one a line; none
# without power-profiles-daemon.
profiles() {
  local all name
  all=$(karchy-powerprofiles-list 2>/dev/null) || true
  for name in power-saver balanced performance; do
    grep -qxF "$name" <<<"$all" && echo "$name"
  done
  return 0
}

# The profile a power source switches to: the one remembered for it, or
# Balanced, as karchy-powerprofiles-set reads it.
profile_for() {
  local supply="$1" available="$2" profile=""
  [[ -r $PROFILE_DIR/$supply ]] && read -r profile <"$PROFILE_DIR/$supply" || true
  [[ -n $profile ]] && grep -qxF -- "$profile" <<<"$available" || profile=balanced
  echo "$profile"
}

# The profile running now, read from the daemon itself. `powerprofilesctl get`
# is a Python program that can crash on exit (python/cpython#124619).
profile_in_use() {
  local value
  value=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles \
    net.hadess.PowerProfiles ActiveProfile 2>/dev/null) || return 0
  value=${value#s \"}
  printf '%s' "${value%\"}"
}

# The idle times in effect on both power sources, from a shell config on
# stdin: {battery: {screenOff, lock, sleep, dim}, ac: {…}} in seconds, 0 for
# never (`dim` counts back from when the screen turns off).
# shell/plugins/services/idle/IdleModel.js `timeouts` is the shell's side of
# this; keep the two in step.
# shellcheck disable=SC2016 # jq variables, not shell ones
IDLE_TIMES='
  def number_of: if type == "number" then . elif type == "string" then (tonumber? // null) else null end;
  def seconds($fallback): (number_of) as $n | if $n == null or $n < 0 then $fallback else ($n | floor) end;
  def is_set: (number_of) as $n | $n != null and $n >= 0;
  def idle_times:
    (.idle | if type == "object" then . else {} end) as $idle
    | def source($name):
        ($idle[$name] | if type == "object" then . else {} end) as $own
        | def pick($key; $fallback):
            if ($own[$key] | is_set) then ($own[$key] | number_of | floor)
            else ($idle[$key] | seconds($fallback)) end;
          {
            screenOff: pick("screenOff"; 300),
            lock: pick("lock"; 300),
            dim: pick("dim"; 30),
            sleep: (if ($own.suspend | is_set) then ($own.suspend | number_of | floor)
                    elif $name == "battery" or $idle.suspendOnAC == true then ($idle.suspend | seconds(900))
                    else 0 end)
          };
      {battery: source("battery"), ac: source("ac")};
'

# shell.json's key for an idle setting: "lock.ac" is idle.ac.lock.
idle_key() {
  case ${1%%.*} in
    sleep) echo suspend ;;
    *) echo "${1%%.*}" ;;
  esac
}

# A logind action as the page names it. The three ways to sleep are one choice.
lid_choice() {
  case $1 in
    suspend | suspend-then-hibernate | sleep | hybrid-sleep) echo sleep ;;
    *) echo "$1" ;;
  esac
}

logind_property() {
  local value
  value=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager "$1" 2>/dev/null) || return 0
  value=${value#s \"}
  printf '%s' "${value%\"}"
}

# The last value systemd's logind.conf or sleep.conf (and their drop-ins) give
# a key. "packaged" leaves out Settings' own drop-in (and the name it had
# until 2026-11, which the root helper removes at the next change): what
# applies before any choice made here, from karchy's packages or the user's
# own files.
systemd_value() {
  local mode="$1" file="$2" key="$3" ours="" old=""
  if [[ $mode == packaged ]]; then
    ours="/etc/systemd/$file.conf.d/60-karchy-settings.conf"
    old="/etc/systemd/$file.conf.d/karchy-settings.conf"
  fi
  systemd-analyze cat-config "systemd/$file.conf" 2>/dev/null |
    awk -v ours="$ours" -v old="$old" -v key="$key" '
      /^# \// { skip = ($2 == ours || $2 == old) }
      skip { next }
      {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (index(line, key) != 1) next
        rest = substr(line, length(key) + 1)
        if (rest !~ /^[[:space:]]*=/) next
        sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
        value = rest
      }
      END { print value }'
}

# Whether a plugged-in laptop hibernates after that time too ("same") or
# stays asleep until the charger is pulled ("never"). systemd's own default
# is to hibernate; karchy-laptop's drop-in says not to.
hibernate_on_ac() {
  local value
  value=$(systemd_value "$1" sleep HibernateOnACPower)
  case ${value,,} in
    no | false | 0 | off) echo never ;;
    *) echo same ;;
  esac
}

# Minutes of sleep before hibernation, 0 for never, -1 when systemd works it
# out from the battery (no HibernateDelaySec anywhere on a laptop).
hibernate_after() {
  local mode="$1" allowed delay microseconds
  allowed=$(systemd_value "$mode" sleep AllowSuspendThenHibernate)
  case ${allowed,,} in
    no | false | 0 | off) echo 0; return ;;
  esac
  delay=$(systemd_value "$mode" sleep HibernateDelaySec)
  if [[ -z $delay ]]; then
    has_battery && echo -1 || echo 120
    return
  fi
  microseconds=$(systemd-analyze timespan "$delay" 2>/dev/null | sed -n 's/^[[:space:]]*μs:[[:space:]]*//p')
  [[ $microseconds =~ ^[0-9]+$ ]] || { echo 120; return; }
  echo $(( microseconds / 60000000 ))
}

# What each system setting is before any choice made here.
defaults_json() {
  local lid ac docked
  lid=$(systemd_value packaged logind HandleLidSwitch)
  ac=$(systemd_value packaged logind HandleLidSwitchExternalPower)
  docked=$(systemd_value packaged logind HandleLidSwitchDocked)
  jq -n -c \
    --arg lid "$(lid_choice "${lid:-suspend}")" \
    --arg ac "$(lid_choice "${ac:-${lid:-suspend}}")" \
    --arg docked "$(lid_choice "${docked:-ignore}")" \
    --argjson hibernateAfter "$(hibernate_after packaged)" \
    --arg hibernateAc "$(hibernate_on_ac packaged)" \
    --argjson emptyLevel "$(empty_level packaged)" \
    --arg emptyAction "$(empty_action packaged)" \
    '{powerKey: "menu", "lid.battery": $lid, "lid.ac": $ac, "lid.docked": $docked,
      hibernateAfter: $hibernateAfter, "hibernate.ac": $hibernateAc,
      "empty.level": $emptyLevel, "empty.action": $emptyAction}'
}

# What the power button does now, read back from Hyprland, so a binding in the
# user's own config shows as it is. Hyprland reports a Lua binding by its
# description only, so that is what tells karchy's bindings apart.
power_key() {
  local binds
  binds=$(hyprctl binds -j 2>/dev/null) || { echo menu; return; }
  jq -r --arg key "$POWER_KEY" --arg sleep "${POWER_KEY_NAME[sleep]}" \
    --arg hibernate "${POWER_KEY_NAME[hibernate]}" --arg shutdown "${POWER_KEY_NAME[shutdown]}" '
    [.[] | select(.key == $key and (.modmask // 0) == 0)] as $binds
    | if ($binds | length) == 0 then "nothing"
      else ($binds | last | .description // "") as $name
        | if $name == "Power menu" then "menu"
          elif $name == $sleep then "sleep"
          elif $name == $hibernate then "hibernate"
          elif $name == $shutdown then "shutdown"
          else "custom" end
      end' <<<"$binds" 2>/dev/null || echo menu
}

# One key of a UPower config file's [UPower] group; fails when the file
# doesn't set it.
upower_key() {
  awk -v key="$2" '
    /^[[:space:]]*\[/ { group = $0; gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", group); next }
    group == "UPower" {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (index(line, key) != 1) next
      rest = substr(line, length(key) + 1)
      if (rest !~ /^[[:space:]]*=/) next
      sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
      sub(/[[:space:]]+$/, "", rest)
      value = rest
      found = 1
    }
    END { if (!found) exit 1; print value }' "$1" 2>/dev/null
}

# A UPower setting as upowerd reads it (upower 1.91.5, src/up-config.c):
# UPower.conf, then the files in UPower.conf.d named two digits, a dash,
# letters, digits, dashes and underscores, then .conf, in byte order, each
# overriding only keys the main file has. "packaged" leaves out Settings' own
# drop-in: what applies before any choice made here.
upower_value() {
  local mode="$1" key="$2" value next name
  value=$(upower_key /etc/UPower/UPower.conf "$key") || return 0
  # shellcheck disable=SC2012 # names that don't match the pattern are skipped
  while IFS= read -r name; do
    [[ $name =~ ^[0-9][0-9]-[a-zA-Z0-9_-]*\.conf$ ]] || continue
    [[ $mode == packaged && $name == 60-karchy-settings.conf ]] && continue
    next=$(upower_key "/etc/UPower/UPower.conf.d/$name" "$key") && value=$next
  done < <(ls -1 /etc/UPower/UPower.conf.d 2>/dev/null | LC_ALL=C sort)
  printf '%s' "$value"
}

# The charge (percent) at which UPower acts. It drops a level's fraction, and
# uses its own 20, 5 and 2 unless the three levels are under 100 and
# descending (src/up-daemon.c).
empty_level() {
  local mode="$1" key value levels=()
  for key in PercentageLow PercentageCritical PercentageAction; do
    value=$(upower_value "$mode" "$key")
    [[ $value =~ ^([0-9]+)(\.[0-9]*)?$ ]] && levels+=("$((10#${BASH_REMATCH[1]}))") || levels+=(0)
  done
  if (( levels[0] < 100 && levels[0] > levels[1] && levels[1] > levels[2] )); then
    echo "${levels[2]}"
  else
    echo 2
  fi
}

# What UPower does there. Live, it is what the running daemon answers, which
# already stands for what this machine can do (told to hibernate where that
# doesn't work, it powers off). Before any choice made here, and where the
# daemon doesn't answer, it is worked out from the files the same way for
# the two actions karchy uses.
empty_action() {
  local mode="$1" action=""
  if [[ $mode == live ]]; then
    action=$(busctl call org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower GetCriticalAction 2>/dev/null) || action=""
    action=${action#s \"}
    action=${action%\"}
  fi
  if [[ -z $action ]]; then
    action=$(upower_value "$mode" CriticalPowerAction)
    [[ ${action,,} == hibernate ]] && ! karchy-hibernation-available && action=PowerOff
  fi
  case ${action,,} in
    hibernate | poweroff | hybridsleep | suspend | sleep | ignore) echo "${action,,}" ;;
    *) echo sleep ;;
  esac
}

# The later of the battery warnings that are on, 0 with both off: what the
# empty level has to stay under. The warnings are read as the shell reads
# them (BatteryModel.js `warningThresholds`).
last_warning() {
  effective_config | jq -r '
    def percent($fallback):
      (if type == "string" then (tonumber? // null) else . end)
      | if type == "number" then (if . < 0 then 0 elif . > 100 then 100 else floor end) else $fallback end;
    (.battery | if type == "object" then . else {} end) as $battery
    | ($battery.low | percent(15)) as $low | ($battery.critical | percent(5)) as $critical
    | if $critical > 0 then $critical else $low end'
}

# The idle times, screen brightness and battery choices of a shell config on
# stdin, by setting name. A brightness of 0 leaves the screen as it is;
# bin/karchy-power-source reads the key the same way.
shell_values_of() {
  jq -c "$IDLE_TIMES"'
    def brightness($supply):
      ((.power.brightness[$supply])? // 0)
      | if type == "string" then (tonumber? // 0) else . end
      | if type == "number" and . >= 1 and . <= 100 then floor else 0 end;
    idle_times as $idle
    | {
        "screenOff.battery": $idle.battery.screenOff, "screenOff.ac": $idle.ac.screenOff,
        "lock.battery": $idle.battery.lock, "lock.ac": $idle.ac.lock,
        "sleep.battery": $idle.battery.sleep, "sleep.ac": $idle.ac.sleep,
        "dim.battery": $idle.battery.dim, "dim.ac": $idle.ac.dim,
        "brightness.battery": brightness("battery"), "brightness.ac": brightness("ac"),
        "battery.low": (.battery.low // 15), "battery.critical": (.battery.critical // 5),
        "battery.saver": (if (.battery.saver)? == true then "on" else "off" end)
      }'
}

# Those the shell and karchy-power-source run with, and karchy's own.
shell_values() { effective_config | shell_values_of; }
shell_defaults() { shell_values_of <"$DEFAULTS_FILE"; }

status() {
  local values settings docked ac available profileValues='{}'
  settings=$(saved)
  # A profile picked for a power source (here or in the bar's panel) counts
  # as a choice made, though its record is karchy-powerprofiles-set's.
  available=$(profiles)
  if [[ -n $available ]]; then
    profileValues=$(jq -n -c --arg battery "$(profile_for battery "$available")" --arg ac "$(profile_for ac "$available")" \
      '{"profile.battery": $battery, "profile.ac": $ac}')
  fi
  ac=$(logind_property HandleLidSwitchExternalPower)
  [[ -n $ac ]] || ac=$(logind_property HandleLidSwitch)
  docked=$(logind_property HandleLidSwitchDocked)

  values=$(shell_values | jq -c \
    --arg powerKey "$(power_key)" \
    --arg lidBattery "$(lid_choice "$(logind_property HandleLidSwitch)")" \
    --arg lidAc "$(lid_choice "$ac")" \
    --arg lidDocked "$(lid_choice "${docked:-ignore}")" \
    --argjson hibernateAfter "$(hibernate_after live)" \
    --arg hibernateAc "$(hibernate_on_ac live)" \
    --argjson emptyLevel "$(empty_level live)" \
    --arg emptyAction "$(empty_action live)" \
    --argjson profiles "$profileValues" '
    . + $profiles + {
      powerKey: $powerKey,
      "lid.battery": $lidBattery, "lid.ac": $lidAc, "lid.docked": $lidDocked,
      hibernateAfter: $hibernateAfter, "hibernate.ac": $hibernateAc,
      "empty.level": $emptyLevel, "empty.action": $emptyAction
    }')

  # Decided somewhere else: the value in effect is not the one recorded here,
  # nor karchy's default. A hand-written binding or drop-in does that.
  jq -n -c \
    --argjson battery "$(is has_battery)" \
    --argjson lid "$(is karchy-hw-laptop)" \
    --argjson hibernation "$(is karchy-hibernation-available)" \
    --argjson backlight "$(is karchy-hw-display)" \
    --argjson profiles "$(jq -R -n -c '[inputs | select(. != "")]' <<<"$available")" \
    --argjson values "$values" \
    --argjson saved "$settings" \
    --argjson shellDefaults "$(shell_defaults)" \
    --argjson defaults "$(defaults_json)" \
    --arg source "$(source_in_use)" \
    --arg profile "$([[ -z $available ]] || profile_in_use)" '
    {
      battery: $battery, lid: $lid, hibernation: $hibernation, backlight: $backlight, profiles: $profiles,
      values: $values,
      # A record that only repeats the default of today is no choice.
      saved: (($saved | with_entries(select(.value != $shellDefaults[.key])))
              + ($values | with_entries(select((.key | startswith("profile.")) and .value != "balanced")))),
      foreign: [$defaults | keys[] | select(($saved[.] // $defaults[.]) != $values[.])],
      source: $source, profile: $profile
    }'
}

# One idle time: written to shell.json for its power source, or taken out of
# it when the shared idle.<key> already gives that time, so only a difference
# is kept. Prints "set" or "default".
apply_idle() {
  local setting="$1" seconds="$2" source key config fallback
  source=${setting#*.}
  key=$(idle_key "$setting")
  config=$(effective_config)
  fallback=$(jq -r --arg source "$source" --arg key "$key" --arg name "${setting%%.*}" "$IDLE_TIMES"'
    (if (.idle | type) == "object" and (.idle[$source] | type) == "object" then del(.idle[$source][$key]) else . end)
    | idle_times[$source][$name]' <<<"$config")
  if (( seconds == fallback )); then
    # shellcheck disable=SC2016 # jq variables, not shell ones
    commit 'if (.idle | type) == "object" and (.idle[$source] | type) == "object"
            then del(.idle[$source][$key]) | (if .idle[$source] == {} then del(.idle[$source]) else . end)
            else . end' --arg source "$source" --arg key "$key"
    echo default
  else
    # shellcheck disable=SC2016 # jq variables, not shell ones
    commit '.idle = (.idle | if type == "object" then . else {} end)
            | .idle[$source] = (.idle[$source] | if type == "object" then . else {} end)
            | .idle[$source][$key] = $seconds' --arg source "$source" --arg key "$key" --argjson seconds "$seconds"
    echo set
  fi
}

# A battery warning level; commit drops it from shell.json when it is karchy's.
apply_battery() {
  local key="${1#battery.}" percent="$2" default
  # shellcheck disable=SC2016 # jq variables, not shell ones
  commit '.battery = (.battery | if type == "object" then . else {} end) | .battery[$key] = $percent' \
    --arg key "$key" --argjson percent "$percent"
  default=$(jq -r --arg key "$key" '.battery[$key] // empty' "$DEFAULTS_FILE")
  [[ $percent == "$default" ]] && echo default || echo set
}

# The brightness the built-in screen gets on a power source, 0 to leave it as
# it is; commit drops it from shell.json when it is karchy's (0). The screen
# follows at once when that source is the one in use, so the choice is seen.
apply_brightness() {
  local supply="${1#brightness.}" percent="$2" device
  # shellcheck disable=SC2016 # jq variables, not shell ones
  commit '.power = (.power | if type == "object" then . else {} end)
          | .power.brightness = (.power.brightness | if type == "object" then . else {} end)
          | .power.brightness[$supply] = $percent' --arg supply "$supply" --argjson percent "$percent"
  if (( percent > 0 )) && [[ $supply == "$(source_in_use)" ]] && device=$(karchy-hw-display 2>/dev/null); then
    # Not over a screen the idle service has dimmed, whose level would come
    # back at the next key press.
    karchy-brightness-display undim >/dev/null 2>&1 || true
    brightnessctl -d "$device" set "$percent%" >/dev/null 2>&1 || true
  fi
  (( percent == 0 )) && echo default || echo set
}

# Power saver at the first battery warning: on is karchy's, so commit keeps
# only "off" in shell.json. The profile is asked for again when this changes
# on battery, so a battery that is already low follows.
apply_saver() {
  local on="$1"
  # shellcheck disable=SC2016 # jq variables, not shell ones
  commit '.battery = (.battery | if type == "object" then . else {} end) | .battery.saver = $on' --argjson on "$on"
  if [[ $(source_in_use) == battery ]]; then
    karchy-powerprofiles-set battery >/dev/null 2>&1 || true
  fi
  [[ $on == "$(jq -r '.battery.saver == true' "$DEFAULTS_FILE")" ]] && echo default || echo set
}

# The power button's binding, generated for karchy's Hyprland config to load.
apply_power_key() {
  local choice="$1" tmp
  if [[ $choice == menu ]]; then
    rm -f "$HYPR_FILE"
  else
    mkdir -p "$(dirname "$HYPR_FILE")"
    tmp=$(mktemp "$(dirname "$HYPR_FILE")/.power.lua.XXXXXX")
    {
      echo "-- Generated by karchy Settings › Power (karchy-settings-power)."
      echo "-- Change it there. A binding in ~/.config/hypr loads later and wins."
      if [[ $choice == nothing ]]; then
        echo "hl.unbind(\"$POWER_KEY\")"
      else
        echo "o.rebind(\"$POWER_KEY\", \"${POWER_KEY_NAME[$choice]}\", \"${POWER_KEY_COMMAND[$choice]}\", { locked = true })"
      fi
    } >"$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$HYPR_FILE"
  fi
  hyprctl reload >/dev/null 2>&1 || true
}

# The lid, hibernation and empty-battery choices, all of them at once, to the root
# helper. pkexec exits 126 when the password prompt is dismissed and 127 when
# the request is refused.
apply_system() {
  local settings="$1" args=() key value code=0
  [[ -x $ROOT_HELPER ]] || fail "$ROOT_HELPER is missing; update karchy-settings"
  for key in lid.battery lid.ac lid.docked hibernateAfter hibernate.ac empty.level empty.action; do
    value=$(jq -r --arg k "$key" '.[$k] // empty' <<<"$settings")
    [[ -n $value ]] || continue
    case $key in
      hibernateAfter)
        [[ $value == 0 ]] && value=never
        args+=("hibernate-after=$value")
        ;;
      hibernate.ac)
        [[ $value == same ]] && value=yes || value=no
        args+=("hibernate-on-ac=$value")
        ;;
      empty.level) args+=("battery-level=$value") ;;
      empty.action) args+=("battery-action=$value") ;;
      *) args+=("${key/./-}=$value") ;;
    esac
  done
  pkexec "$ROOT_HELPER" "${args[@]}" >/dev/null || code=$?
  case $code in
    0) ;;
    126 | 127) fail "Not changed: the password prompt was closed or the request was refused" ;;
    *) exit "$code" ;;
  esac
}

# Idle and battery choices recorded here that shell.json no longer carries
# were changed there by hand since; they are the user's now, so forget them.
reconciled() {
  local settings="$1"
  jq -c --argjson values "$(shell_values)" '
    with_entries(select((.key | test("^(screenOff|lock|sleep|dim|brightness|battery)\\.") | not) or .value == $values[.key]))' <<<"$settings"
}

set_value() {
  local setting="${1:-}" value="${2:-}" settings json outcome="" number
  settings=$(reconciled "$(saved)")

  case $setting in
    profile.battery | profile.ac)
      local available
      available=$(profiles)
      [[ -n $available ]] || fail "This computer has no power modes (power-profiles-daemon isn't running)"
      case $value in
        power-saver | balanced | performance) ;;
        *) usage ;;
      esac
      grep -qxF "$value" <<<"$available" || fail "This computer has no $value mode"
      karchy-powerprofiles-set "${setting#profile.}" "$value" >/dev/null || fail "The power mode didn't change"
      # Remembered by karchy-powerprofiles-set, not in power.json.
      status
      return
      ;;
    brightness.battery | brightness.ac)
      if [[ $value == keep ]]; then
        number=0
      else
        [[ $value =~ ^[1-9][0-9]{0,2}$ ]] || usage
        (( value <= 100 )) || usage
        number=$value
      fi
      outcome=$(apply_brightness "$setting" "$number")
      json=$number
      ;;
    battery.saver)
      case $value in
        on) outcome=$(apply_saver true) ;;
        off) outcome=$(apply_saver false) ;;
        *) usage ;;
      esac
      json=$(jq -n --arg v "$value" '$v')
      ;;
    screenOff.battery | screenOff.ac | lock.battery | lock.ac | sleep.battery | sleep.ac)
      if [[ $value == never ]]; then
        number=0
      else
        [[ $value =~ ^[1-9][0-9]{1,4}$ ]] || usage
        (( value >= 10 && value <= 86400 )) || usage
        number=$value
      fi
      outcome=$(apply_idle "$setting" "$number")
      json=$number
      ;;
    dim.battery | dim.ac)
      if [[ $value == never ]]; then
        number=0
      else
        [[ $value =~ ^[1-9][0-9]{0,2}$ ]] || usage
        (( value >= 5 && value <= 600 )) || usage
        number=$value
      fi
      outcome=$(apply_idle "$setting" "$number")
      json=$number
      ;;
    battery.low | battery.critical)
      [[ $value =~ ^[1-9][0-9]?$ ]] || usage
      local low critical empty
      low=$(effective_config | jq '.battery.low // 15')
      critical=$(effective_config | jq '.battery.critical // 5')
      empty=$(empty_level live)
      if [[ $setting == battery.low ]]; then
        (( value >= 5 && value <= 50 )) || usage
        (( value > critical )) || fail "The low warning has to come before the critical one ($critical%)"
      else
        (( value >= 3 && value <= 30 )) || usage
        (( low == 0 || value < low )) || fail "The critical warning has to come after the low one ($low%)"
      fi
      # A warning at or under the level where the computer hibernates or
      # shuts down would never be seen.
      (( value > empty )) || fail "A warning has to come before the battery is nearly empty ($empty%). Lower that level first."
      outcome=$(apply_battery "$setting" "$value")
      json=$value
      ;;
    empty.level)
      [[ $value =~ ^[1-9][0-9]?$ ]] || usage
      (( value >= 2 && value <= 20 )) || usage
      local warning
      warning=$(last_warning)
      (( warning == 0 || value < warning )) ||
        fail "That would be before the last battery warning ($warning%). Raise the warning first, or pick a lower level."
      json=$value
      ;;
    empty.action)
      case $value in
        poweroff) ;;
        hibernate) karchy-hibernation-available || fail "This computer can't hibernate" ;;
        *) usage ;;
      esac
      json=$(jq -n --arg v "$value" '$v')
      ;;
    powerKey)
      case $value in
        menu | sleep | shutdown | nothing) ;;
        hibernate) karchy-hibernation-available || fail "This computer can't hibernate" ;;
        *) usage ;;
      esac
      apply_power_key "$value"
      json=$(jq -n --arg v "$value" '$v')
      ;;
    lid.battery | lid.ac | lid.docked)
      case $value in
        sleep | ignore | poweroff) ;;
        hibernate) karchy-hibernation-available || fail "This computer can't hibernate" ;;
        *) usage ;;
      esac
      json=$(jq -n --arg v "$value" '$v')
      ;;
    hibernateAfter)
      if [[ $value == never ]]; then
        json=0
      else
        [[ $value =~ ^[1-9][0-9]{0,3}$ ]] || usage
        (( value >= 5 && value <= 1440 )) || usage
        json=$value
      fi
      ;;
    hibernate.ac)
      case $value in
        never | same) ;;
        *) usage ;;
      esac
      json=$(jq -n --arg v "$value" '$v')
      ;;
    *) usage ;;
  esac

  # Only a difference from the default is recorded.
  if [[ $outcome == default ]] || jq -e --arg k "$setting" --argjson v "$json" 'has($k) and .[$k] == $v' <<<"$(defaults_json)" >/dev/null; then
    settings=$(jq -c --arg k "$setting" 'del(.[$k])' <<<"$settings")
  else
    settings=$(jq -c --arg k "$setting" --argjson v "$json" '.[$k] = $v' <<<"$settings")
  fi

  case $setting in
    lid.* | hibernateAfter | hibernate.ac | empty.*) apply_system "$settings" ;;
  esac
  write_saved "$settings"

  status
  # Said after the status, which the page still shows: the choice is recorded,
  # but something that loads later decides.
  if [[ $setting == powerKey && $(power_key) != "$value" ]]; then
    fail "The power button didn't change: Hyprland still has it doing something else. A binding for $POWER_KEY in ~/.config/hypr wins over this setting."
  fi
}

reset_all() {
  local settings key
  settings=$(reconciled "$(saved)")
  while IFS= read -r key; do
    case $key in
      screenOff.* | lock.* | sleep.* | dim.*)
        # shellcheck disable=SC2016 # jq variables, not shell ones
        commit 'if (.idle | type) == "object" and (.idle[$source] | type) == "object"
                then del(.idle[$source][$key]) | (if .idle[$source] == {} then del(.idle[$source]) else . end)
                else . end' --arg source "${key#*.}" --arg key "$(idle_key "$key")"
        ;;
      brightness.*)
        # shellcheck disable=SC2016 # jq variables, not shell ones
        commit 'if (.power | type) == "object" and (.power.brightness | type) == "object"
                then .power.brightness[$supply] = 0 else . end' --arg supply "${key#brightness.}"
        ;;
      battery.*)
        # shellcheck disable=SC2016 # jq variables, not shell ones
        commit '.battery[$key] = $karchy_shell_defaults[0].battery[$key]' --arg key "${key#battery.}"
        ;;
    esac
  done < <(jq -r 'keys[]' <<<"$settings")

  # Both power sources go back to Balanced, the one in use at once, or to
  # Power saver where the battery is low, which is the default again.
  if [[ -e $PROFILE_DIR/ac || -e $PROFILE_DIR/battery ]] || jq -e 'has("battery.saver")' <<<"$settings" >/dev/null; then
    rm -f "$PROFILE_DIR/ac" "$PROFILE_DIR/battery"
    karchy-powerprofiles-set autodetect >/dev/null 2>&1 || true
  fi

  if [[ -e $HYPR_FILE ]]; then
    apply_power_key menu
  fi
  if jq -e 'has("lid.battery") or has("lid.ac") or has("lid.docked") or has("hibernateAfter") or has("hibernate.ac")
            or has("empty.level") or has("empty.action")' <<<"$settings" >/dev/null; then
    apply_system '{}'
  fi
  rm -f "$POWER_FILE"
  status
}

case "${1:-}" in
  "") exec karchy-settings power ;;
  status) (( $# == 1 )) || usage; status ;;
  set) (( $# == 3 )) || usage; set_value "$2" "$3" ;;
  reset) (( $# == 1 )) || usage; reset_all ;;
  *) usage ;;
esac
