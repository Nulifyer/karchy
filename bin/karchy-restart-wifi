#!/bin/bash

# karchy:summary=Unblock and restart the Wi-Fi service.

# Stopped NetworkManager: starting it asks for an administrator's password.
if ! systemctl is-active --quiet NetworkManager.service; then
  echo -e "Starting NetworkManager...\n"
  systemctl start NetworkManager.service
fi

echo -e "Unblocking wifi...\n"

rfkill unblock wifi
nmcli networking on
nmcli radio wifi on
nmcli device wifi rescan 2>/dev/null || true
rfkill list wifi
