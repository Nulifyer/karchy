#!/bin/bash

# karchy:summary=Open a clipboard history entry in the app for it
# karchy:group=clipboard
# karchy:args=<text|image|files> <path>
# karchy:hidden=true

# What the history's picker runs for Alt+Enter: an image opens in the
# annotator, a web address in the browser, other text in the editor, and a
# file copy opens its first file.

entry_type=${1:-}
path=${2:-}

if [[ -z $entry_type || -z $path ]]; then
  echo "Usage: karchy-clipboard-open <text|image|files> <path>" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

open_text() {
  local text url="" open_dir open_file

  text=$(<"$path")
  url=$(grep -Eom1 'https?://[^[:space:]"'\''<>]+' <<<"$text" || true)
  if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
    url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  fi

  if [[ -n $url ]]; then
    exec karchy-launch-browser "$url"
  fi

  # A copy of its own for the editor, in memory like the history.
  umask 077
  open_dir="${XDG_RUNTIME_DIR:-/tmp}/karchy/clipboard-open"
  mkdir -p "$open_dir"
  open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
  cat -- "$path" >"$open_file"
  exec karchy-launch-editor "$open_file"
}

case "$entry_type" in
  image)
    exec omasnap --notify "$path"
    ;;
  text)
    open_text
    ;;
  files)
    first=$(grep -m1 '^file://' "$path") || exit 1
    exec xdg-open "$first"
    ;;
  *)
    exit 1
    ;;
esac
