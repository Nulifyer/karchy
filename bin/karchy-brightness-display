#!/bin/bash

# karchy:summary=Show or adjust brightness on the focused display.
# karchy:args=[--no-osd] [--monitor name] [+N%|N%-|N%|off|on|dim N|undim]
# karchy:examples=karchy brightness display | karchy brightness display +5% | karchy brightness display --monitor DP-1 50% | karchy brightness display off | karchy brightness display on

# `dim N` and `undim` are the idle service's (Settings › Power, "Dim the
# screen"): `dim` lowers the built-in screen to N percent and notes the level
# it had, `undim` puts that level back. They are made so that nothing can
# leave the screen dim or undo somebody else's change:
# - `dim` does nothing to a screen already at or under N percent, and nothing
#   when a dimming is already noted, so the level noted is the one from
#   before the first.
# - `undim` writes the noted level back only while the screen is still at the
#   level `dim` set. A level set since by anything else (the monitor panel,
#   the per-source brightness of karchy-power-source, brightnessctl by hand)
#   is left as it is, and the note is dropped either way.
# - Whatever sets the backlight here undims first: a brightness key steps
#   from the level the screen had, and `off` and `on` put it back, `off`
#   after the screen is dark, so the screen never comes back dim.
# The levels are the kernel's raw values, so what comes back is exactly what
# was there.
#
# The note is /var/lib/karchy/brightness-dim/<uid> (made by tmpfiles.d,
# sticky and open to every user, like /tmp), "<device> <level before> <level
# dimmed> <boot id>", so it outlives the session and the boot. That is what
# keeps a dimming from ever being saved as the screen's level (D-172):
# - At every shutdown, reboot or stop of the backlight, root's
#   /usr/lib/karchy/backlight-dim (karchy-backlight-dim@.service) puts the
#   level back by this same rule just before systemd-backlight saves it,
#   after every user manager has stopped, and drops the note.
# - Anything that still finds a note from an earlier boot (that helper after
#   systemd-backlight has restored the level at boot, and `undim` here: the
#   session's start runs it) counts the screen as still dimmed when it is
#   within a step of the dimmed level, because a driver may round the level
#   systemd saved and restored, and raised to systemd's 5% floor. A level
#   set since is still left alone.
# - The session's end (karchy-brightness-restore.service) and the shell's
#   start undim too, so a logout or a restarted shell leaves nothing dim.

no_osd=0
monitor=""

while (( $# > 0 )); do
  case "$1" in
  --no-osd)
    no_osd=1
    shift
    ;;
  --monitor)
    (( $# >= 2 )) || exit 1
    monitor="$2"
    shift 2
    ;;
  *)
    break
    ;;
  esac
done

dim_note="/var/lib/karchy/brightness-dim/$UID"
dim_lock="${XDG_RUNTIME_DIR:-/tmp}/karchy-brightness-display-dim.lock"

# The boot a note was written in: a note from another one is a leftover.
boot_id() {
  local id=""
  read -r id </proc/sys/kernel/random/boot_id 2>/dev/null || true
  printf '%s' "${id:-unknown}"
}

# dim, undim and whatever else undims can overlap (the idle service, the lock
# screen, a brightness key): one at a time.
dim_locked() {
  local fd
  exec {fd}>"$dim_lock" || return 1
  flock "$fd" || return 1
  "$@"
  local code=$?
  exec {fd}>&-
  return "$code"
}

# The folder is open to every user, so only a plain file of this user's own
# under this user's name is a note. Anything else there (left by somebody
# else) means no dimming for this user, rather than following it.
note_usable() {
  [[ ! -e $dim_note && ! -L $dim_note ]] || [[ -f $dim_note && ! -L $dim_note && -O $dim_note ]]
}

# Written whole, private to this user; a failure leaves no half note.
write_note() {
  ( umask 077; printf '%s %s %s %s\n' "$@" >"$dim_note" ) 2>/dev/null
}

dim_now() {
  local percent="$1" device before max target dimmed boot
  boot=$(boot_id)
  note_usable || return 0
  # A note from an earlier boot is a leftover: settle it first, so it can't
  # stand in the way of this dimming.
  if [[ -s $dim_note ]]; then
    local noted_boot=""
    read -r _ _ _ noted_boot <"$dim_note" 2>/dev/null || true
    [[ $noted_boot == "$boot" ]] && return 0
    undim_now || return 0
  fi
  device="$(karchy-hw-display)" || return 0
  before="$(brightnessctl -d "$device" get 2>/dev/null)" || return 0
  max="$(brightnessctl -d "$device" max 2>/dev/null)" || return 0
  [[ $before =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] && (( max > 0 )) || return 0

  # Never to 0: on some panels that turns the backlight off altogether.
  target=$(( max * percent / 100 ))
  (( target >= 1 )) || target=1
  (( before > target )) || return 0

  # Noted before the write, so a dimming is never left without its note: no
  # note, no dimming. The level read back is the one to compare with later:
  # a driver may round.
  write_note "$device" "$before" "$target" "$boot" || { rm -f "$dim_note"; return 0; }
  if ! brightnessctl -q -d "$device" set "$target"; then
    rm -f "$dim_note"
    return 0
  fi
  dimmed="$(brightnessctl -d "$device" get 2>/dev/null)"
  [[ $dimmed =~ ^[0-9]+$ ]] || dimmed=$target
  write_note "$device" "$before" "$dimmed" "$boot" || true
}

# Whether the screen is still at the level a note dimmed it to. In the boot
# that dimmed it, exactly. After a reboot the level is the one systemd-backlight
# saved and restored, which a driver may have rounded and systemd raises to
# 5% of the range at the least (its clamp): within 1% of the range (one step
# at the least) of that. /usr/lib/karchy/backlight-dim has the same rule.
still_dimmed() {
  local current="$1" dimmed="$2" max="$3" same_boot="$4" floor slack
  if (( same_boot )); then
    (( current == dimmed ))
    return
  fi
  [[ $max =~ ^[0-9]+$ ]] && (( max > 0 )) || return 1
  floor=$(( (max * 5 + 99) / 100 ))
  (( dimmed >= floor )) || dimmed=$floor
  slack=$(( max / 100 ))
  (( slack >= 1 )) || slack=1
  (( current >= dimmed - slack && current <= dimmed + slack ))
}

undim_now() {
  local device before dimmed noted_boot current max same_boot=0
  [[ -s $dim_note ]] && note_usable || return 0
  read -r device before dimmed noted_boot <"$dim_note" || true
  if [[ -n $device && $device != */* && $before =~ ^[0-9]+$ && $dimmed =~ ^[0-9]+$ ]]; then
    [[ $noted_boot == "$(boot_id)" ]] && same_boot=1
    current="$(brightnessctl -d "$device" get 2>/dev/null)"
    max="$(brightnessctl -d "$device" max 2>/dev/null)"
    # Kept when the write fails, so the next wake tries again.
    if [[ $current =~ ^[0-9]+$ ]] && still_dimmed "$current" "$dimmed" "$max" "$same_boot" &&
      ! brightnessctl -q -d "$device" set "$before"; then
      return 1
    fi
  fi
  rm -f "$dim_note"
}

# Neither needs to know the focused display, which costs a call to Hyprland
# that can stall while the lid closes; undim runs before every sleep.
if [[ ${1:-} == "dim" ]]; then
  [[ $# == 2 && $2 =~ ^[1-9][0-9]?$ ]] || { echo "Usage: karchy-brightness-display dim <percent, 1 to 99>" >&2; exit 1; }
  dim_locked dim_now "$2"
  exit 0
elif [[ ${1:-} == "undim" ]]; then
  dim_locked undim_now
  exit
fi

# Get the brightness of the passed display
backlight_brightness() {
  brightnessctl -d "$1" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END{ exit !found }'
}

[[ -n $monitor ]] || monitor="$(karchy-hyprland-monitor-focused 2>/dev/null || true)"

monitor_is_internal() {
  [[ $monitor =~ ^(eDP|LVDS|DSI)- ]]
}

use_ddc_display() {
  [[ -n $monitor ]] && ! monitor_is_internal && monitor_may_have_ddc
}

# A platform whose display driver registers no DDC channel says so in its
# displays.conf (see docs/file-layout.md): there a probe finds only unrelated
# I2C buses, slowly, so only a connector with a ddc node is probed. Everywhere
# else every external monitor is.
monitor_may_have_ddc() {
  local displays_conf=/usr/share/omarchy-platform/displays.conf directive argument
  [[ -r $displays_conf ]] || return 0

  while IFS=$' \t\r' read -r directive argument || [[ -n $directive ]]; do
    if [[ $directive == "ddc-require-connector-ddc" && -z $argument ]]; then
      compgen -G "/sys/class/drm/card*-$monitor/ddc" >/dev/null
      return
    fi
  done <"$displays_conf"
  return 0
}

# The kernel backlight is the built-in panel's, so an external monitor without
# DDC fails rather than dimming the panel.
use_backlight_display() {
  [[ -z $monitor ]] || monitor_is_internal
}

if (( $# == 0 )); then
  if use_ddc_display; then
    karchy-brightness-display-ddc "$monitor"
    exit
  elif ! use_backlight_display; then
    exit 1
  fi

  device="$(karchy-hw-display)" || exit 1
  backlight_brightness "$device"
  exit
fi

step="$1"

if [[ $step == "off" ]]; then
  hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1
  # Back to its level while it is dark, so it does not light up dim.
  dim_locked undim_now
  exit 0
elif [[ $step == "on" ]]; then
  dim_locked undim_now
  # Skip the dispatch when every active display is already lit: a redundant
  # DPMS enable right after system resume forces another modeset, which blanks
  # the panel for a beat (visible flash at the unlock screen).
  hyprctl monitors -j 2>/dev/null | jq -e '[.[] | select(.disabled == false)] | length > 0 and all(.dpmsStatus)' >/dev/null 2>&1 && exit 0
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1
  exit 0
fi

# Drop overlapping brightness key events so concurrent invocations do not race.
# Hardware key repeat present on some devices can otherwise glitch OSD rendering.
exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/karchy-brightness-display.lock"
flock -n "$lock_fd" || exit 0

if use_ddc_display; then
  brightness="$(karchy-brightness-display-ddc "$monitor" "$step")" || exit 1
  (( no_osd )) || karchy-osd -i brightness -p "$brightness"
elif ! use_backlight_display; then
  exit 1
else
  # Current device highlighted
  device="$(karchy-hw-display)" || exit 1

  # A step counts from the level the screen had before it was dimmed.
  dim_locked undim_now

  # Current brightness percentage
  current=$(backlight_brightness "$device") || exit 1

  # Apply non-uniform step size: 1% steps if at or below 5%, otherwise set an
  # absolute target percentage to avoid raw backlight rounding causing uneven OSD steps.
  if [[ $step == "+5%" ]]; then
    if (( current < 5 )); then
      (( target = current + 1 ))
    else
      (( target = current + 5 ))
    fi

    (( target > 100 )) && target=100
    step="$target%"
  elif [[ $step == "5%-" ]]; then
    if (( current <= 5 )); then
      (( target = current - 1 ))
    else
      (( target = current - 5 ))
    fi

    (( target < 1 )) && target=1
    step="$target%"
  fi

  # Set brightness of the display device.
  brightnessctl -d "$device" set "$step" >/dev/null

  # Show the new brightness in OSD
  (( no_osd )) || karchy-osd -i brightness -p "$(backlight_brightness "$device")"
fi
