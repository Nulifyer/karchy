#!/bin/bash

# karchy:summary=VPN profiles and the VPN's options for Settings › Network
# karchy:group=network
# karchy:args=status [--json] | import <file.conf> | setup <uuid> [dns] | switch <uuid> on|off | remove <uuid> | home-lan yes|no
# karchy:examples=karchy network vpn import ~/Downloads/wg0.conf
# karchy:hidden=true

# NetworkManager holds the VPN profiles (WireGuard, and VPN plugins such as
# OpenVPN); nmcli changes them without a password for local members of wheel.
#   import      adds a WireGuard .conf as a profile that doesn't start by
#               itself (the VPN, or the switch in Settings, starts it)
#   setup       makes the VPN use a WireGuard profile: prepares the
#               profile the way the VPN needs it (a fixed listen port,
#               its DNS for every name), writes the VPN's configuration
#               from the profile and hands it to `karchy-vpn setup`, which
#               checks it as root and asks for an administrator's password.
#               The optional dns is a DNS server inside the VPN, for a
#               profile that names none. Exit 3: that address is needed
#   switch      connects or disconnects a profile: other kinds of VPN
#               (OpenVPN and the like), which the VPN doesn't run
#   remove      deletes a profile, its keys with it. The one the VPN
#               uses is turned off first (`karchy-vpn mode off`), so the kill
#               switch doesn't block the internet waiting for a tunnel that
#               is gone; the VPN then waits to be set up with another
#   home-lan    the VPN's "Allow local devices on trusted networks"
#               (HOME_LAN): its configuration is handed to `karchy-vpn
#               setup`, which checks it as root and asks for a password
# The VPN (docs/vpn.md) keeps its mode and status in
# /run/karchy-vpn/status and `karchy-vpn mode`; Settings reads those itself.

set -euo pipefail

CONFIG=${KARCHY_VPN_CONFIG:-/etc/karchy-vpn/config}
UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

refuse() { echo "$*" >&2; exit 2; }

config_value() {
  [[ -r $CONFIG ]] || return 0
  sed -n "s/^$1=//p" "$CONFIG" | head -n 1 | sed "s/^'\(.*\)'$/\1/"
}

# The profile the VPN uses: VPN_CONNECTION names it by its name, or
# by its UUID when the name had characters the VPN's configuration
# doesn't take.
in_use() {  # in_use <uuid> <name>
  local connection
  connection=$(config_value VPN_CONNECTION)
  [[ -n $connection && ( $connection == "$1" || $connection == "$2" ) ]]
}

status() {
  local rows="" uuid type device name autoconnect used="" iface
  declare -A active=()
  while IFS=: read -r uuid device; do
    [[ -n $uuid && -n $device ]] && active[$uuid]=$device
  done < <(nmcli -t -e no -f UUID,DEVICE connection show --active 2>/dev/null)
  while IFS=: read -r uuid type autoconnect name; do
    [[ $type == "wireguard" || $type == "vpn" ]] || continue
    iface=""
    [[ $type == wireguard ]] && iface=$(nmcli -g connection.interface-name connection show uuid "$uuid" 2>/dev/null || true)
    in_use "$uuid" "$name" && used=yes
    rows+=$(jq -cn --arg uuid "$uuid" --arg type "$type" --arg name "$name" --arg device "${active[$uuid]:-}" \
      --arg auto "$autoconnect" --arg iface "$iface" --arg inUse "$(in_use "$uuid" "$name" && echo yes)" \
      --arg dns "$([[ $type == wireguard ]] && nmcli -g ipv4.dns connection show uuid "$uuid" 2>/dev/null)" \
      '{uuid: $uuid, name: $name, type: $type, active: ($device != ""), device: $device, autoconnect: ($auto == "yes"),
        interface: $iface, has_dns: ($dns != ""), in_use: ($inUse == "yes")}')$'\n'
  done < <(nmcli -t -e no -f UUID,TYPE,AUTOCONNECT,NAME connection show 2>/dev/null)
  # Set up means a configuration naming a profile that still exists: after
  # its profile is removed, the VPN waits to be set up with another.
  jq -s --arg package "$([[ -x /usr/lib/karchy-vpn/control ]] && echo yes)" \
    --arg configured "$([[ -r $CONFIG && -n $used ]] && echo yes)" --arg homeLan "$(config_value HOME_LAN)" \
    --arg connection "$(config_value VPN_CONNECTION)" --arg timeout "$(config_value CONNECT_TIMEOUT)" '{
      package: ($package == "yes"), configured: ($configured == "yes"),
      home_lan: ($homeLan != "no"), connection: $connection,
      connect_timeout: ($timeout | tonumber? // 30),
      profiles: sort_by(.name | ascii_downcase)
    }' <<<"$rows"
}

# A WireGuard configuration as a NetworkManager profile. NetworkManager names
# the profile and its interface after the file, and an interface name is at
# most 15 letters, digits and _=+.-, so the file is imported under such a name.
import_conf() {
  local file=${1:-} base dir out uuid
  [[ -f $file && -r $file ]] || refuse "Can't read that file."
  (( $(stat -c %s "$file") <= 65536 )) || refuse "This file isn't a WireGuard configuration. Choose a .conf file exported by your VPN provider."
  if ! grep -qiE '^[[:space:]]*\[Interface\]' "$file" || ! grep -qiE '^[[:space:]]*PrivateKey[[:space:]]*=' "$file" ||
    ! grep -qiE '^[[:space:]]*\[Peer\]' "$file"; then
    refuse "This file isn't a WireGuard configuration. Choose a .conf file exported by your VPN provider."
  fi
  base=${file##*/}
  base=${base%.conf}
  base=${base//[^A-Za-z0-9_=+.-]/-}
  base=${base:0:15}
  [[ -n $base && $base != "." && $base != ".." ]] || base=wg0
  dir=$(mktemp -d)
  # Expanded now: $dir is local, and gone by the time the trap runs.
  trap "rm -rf '$dir'" EXIT
  install -m 600 "$file" "$dir/$base.conf"
  if ! out=$(nmcli connection import type wireguard file "$dir/$base.conf" 2>&1); then
    refuse "NetworkManager couldn't import it: ${out#Error: }"
  fi
  uuid=$(grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' <<<"$out" | head -n 1)
  [[ -n $uuid ]] || refuse "NetworkManager didn't say which profile it made: $out"
  # Imported profiles connect at once and on every boot; this one waits to
  # be switched on (or for the VPN to start it).
  nmcli connection down uuid "$uuid" >/dev/null 2>&1 || true
  nmcli connection modify uuid "$uuid" connection.autoconnect no
  jq -cn --arg uuid "$uuid" --arg name "$base" '{uuid: $uuid, name: $name}'
}

remove() {
  local uuid=${1:-} name type
  [[ $uuid =~ $UUID_RE ]] || refuse "Not a connection UUID: $uuid"
  type=$(profile_field "$uuid" connection.type)
  [[ $type == wireguard || $type == vpn ]] || refuse "That isn't a VPN profile."
  name=$(profile_field "$uuid" connection.id)
  if command -v karchy-vpn >/dev/null && [[ -r $CONFIG ]] && in_use "$uuid" "$name" &&
    [[ $(karchy-vpn mode 2>/dev/null) != off ]]; then
    karchy-vpn mode off >/dev/null || refuse "Couldn't turn the VPN off, so the profile it uses stays."
  fi
  local out
  out=$(nmcli connection delete uuid "$uuid" 2>&1) || refuse "NetworkManager couldn't remove it: ${out#Error: }"
}

home_lan() {
  local value=${1:-} tmp
  [[ $value =~ ^(yes|no)$ ]] || refuse "Allow local devices is yes or no."
  command -v karchy-vpn >/dev/null || refuse "The VPN isn't installed (karchy-settings is too old)."
  [[ -r $CONFIG ]] || refuse "The VPN isn't set up yet: run karchy-vpn setup."
  tmp=$(mktemp)
  trap "rm -f '$tmp'" EXIT
  grep -v '^HOME_LAN=' "$CONFIG" >"$tmp" || true
  printf 'HOME_LAN=%s\n' "$value" >>"$tmp"
  karchy-vpn setup "$tmp" >/dev/null
}

# One field of a profile, as NetworkManager has it.
profile_field() { nmcli --escape no -g "$2" connection show uuid "$1" 2>/dev/null; }

# The VPN's configuration, written from a WireGuard profile. The
# VPN wants one IPv4 full-tunnel peer, a fixed listen port and the VPN's
# DNS for every name; what a provider's file leaves open is set on the
# profile here (no password: it is the user's own profile), and what can't be
# set is refused in plain words before anyone is asked for a password.
setup() {
  local uuid=${1:-} dns=${2:-} name interface port peers endpoint host endpoint_port tmp key value
  [[ $uuid =~ $UUID_RE ]] || refuse "Not a connection UUID: $uuid"
  command -v karchy-vpn >/dev/null || refuse "The VPN isn't installed (karchy-settings is too old)."
  [[ $(profile_field "$uuid" connection.type) == wireguard ]] || refuse "Choose a WireGuard profile."
  name=$(profile_field "$uuid" connection.id)
  interface=$(profile_field "$uuid" connection.interface-name)
  peers=$(profile_field "$uuid" wireguard.peers)
  [[ -n $interface ]] || refuse "This profile has no interface name."
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9\ _.-]*$ ]] || name=$uuid

  (( $(grep -o 'allowed-ips=' <<<"$peers" | wc -l) == 1 )) ||
    refuse "The VPN needs a profile with exactly one server (peer); this one has $(grep -o 'allowed-ips=' <<<"$peers" | wc -l)."
  grep -qE 'allowed-ips=([^ ]*,)?0\.0\.0\.0/0(,| |$)' <<<"$peers" ||
    refuse "This profile sends only some traffic through the VPN. The VPN needs one that sends everything (AllowedIPs = 0.0.0.0/0)."
  endpoint=$(grep -oE 'endpoint=[^ ,]+' <<<"$peers" | head -n 1 || true)
  endpoint=${endpoint#endpoint=}
  host=${endpoint%:*}
  endpoint_port=${endpoint##*:}
  [[ -n $endpoint && $host != *:* && $host != \[* && $endpoint_port =~ ^[0-9]+$ ]] ||
    refuse "This profile's server address isn't an IPv4 address or a host name with a port."

  if [[ -n $dns ]]; then
    [[ $dns =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || refuse "The DNS server is an IPv4 address, like 10.0.0.1."
  else
    dns=$(profile_field "$uuid" ipv4.dns | tr ',' ' ' | awk '{print $1}')
    if [[ -z $dns ]]; then
      echo "This profile names no DNS server. Enter the address of one inside the VPN." >&2
      exit 3
    fi
  fi

  port=$(profile_field "$uuid" wireguard.listen-port)
  [[ $port =~ ^[1-9][0-9]*$ ]] || port=51820
  nmcli connection modify uuid "$uuid" wireguard.listen-port "$port" wireguard.peer-routes yes \
    ipv4.dns "$dns" ipv4.dns-search "~." ipv4.dns-priority -100 connection.autoconnect no >/dev/null ||
    refuse "NetworkManager couldn't prepare the profile."

  tmp=$(mktemp)
  trap "rm -f '$tmp'" EXIT
  # What was chosen before (local devices, timeouts) stays; the profile's
  # facts replace the rest.
  if [[ -r $CONFIG ]]; then
    grep -vE '^(VPN_CONNECTION|VPN_INTERFACE|VPN_ENDPOINT_HOST|VPN_ENDPOINT_PORT|VPN_CLIENT_PORT|VPN_DNS)=' "$CONFIG" >"$tmp" || true
  fi
  for key in VPN_CONNECTION:"$name" VPN_INTERFACE:"$interface" VPN_ENDPOINT_HOST:"$host" \
    VPN_ENDPOINT_PORT:"$endpoint_port" VPN_CLIENT_PORT:"$port" VPN_DNS:"$dns"; do
    value=${key#*:}
    printf '%s=%q\n' "${key%%:*}" "$value" >>"$tmp"
  done
  karchy-vpn setup "$tmp"
}

case "${1:-}" in
  status) status ;;
  setup) setup "${2:-}" "${3:-}" ;;
  import) import_conf "${2:-}" ;;
  switch)
    [[ ${2:-} =~ $UUID_RE ]] || refuse "Not a connection UUID: ${2:-}"
    case ${3:-} in
      on) nmcli connection up uuid "$2" >/dev/null ;;
      off) nmcli connection down uuid "$2" >/dev/null ;;
      *) refuse "switch is on or off." ;;
    esac
    ;;
  remove) remove "${2:-}" ;;
  home-lan) home_lan "${2:-}" ;;
  *) sed -n 's/^# karchy:args=/Usage: karchy-network-vpn /p' "$0" >&2; exit 1 ;;
esac
